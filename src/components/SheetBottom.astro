---
import type { HTMLAttributes } from "astro/types";
import crypto from "node:crypto";
import { twMerge } from "tailwind-merge";
import type { BgColorType } from "../types";
import BaseWrapper from "./BaseWrapper.astro";
import Header from "./Header.astro";

// An M3 bottom sheet: supplementary content anchored to the bottom of the window, in two kinds.
//
// - Standard (default): an <aside> stuck to the bottom of its scroll container, alongside the
//   main content, both usable at once. Its drag handle collapses it to the handle alone and
//   expands it again, by a click or a drag.
// - Modal (isModal): a <dialog> that slides up over the page under a scrim, opened with
//   showModal(), so focus stays inside it, Escape closes it and the page is inert until it does.
//   Open it with a button carrying command="show-modal" and commandfor set to the sheet's id. It
//   also closes on a click on the scrim. As M3 asks, it opens at no more than half the window's
//   height; content taller than that gives it a second, full height, which its drag handle
//   toggles (a click, or a drag up and down). Otherwise the handle closes it, on a click or a
//   drag down.
//
// As in M3 and Compose, the sheet is a container, an optional drag handle and (modal) a scrim:
// it has no headline or close button of its own. Name it with aria-label, or aria-labelledby
// pointing at a heading in its content. A sheet that can reach full height should have a close
// button in its content, as M3 asks, such as one with command="request-close" in a top row.
type Props = Omit<HTMLAttributes<"aside" | "dialog">, "id"> & {
  bgColor?: BgColorType;
  // The drag handle's accessible names, as in Compose: `handle` while it changes the sheet's
  // height, its state in aria-expanded; `close` while it closes a modal sheet with one height.
  // In English by default, so pass them on a page in another language.
  dragHandleLabels?: { handle?: string; close?: string };
  // Needed to open a modal sheet with commandfor; one is made up if it's left out
  id?: string;
  // A standard sheet only: starts collapsed to its drag handle
  isCollapsed?: boolean;
  isModal?: boolean;
  showDragHandle?: boolean;
};
const {
  bgColor = "surface-container-low",
  dragHandleLabels,
  id = `ac-sheet-bottom-${crypto.randomUUID()}`,
  isCollapsed = false,
  isModal = false,
  showDragHandle = true,
  class: classList,
  ...attrs
} = Astro.props;

const Tag = isModal ? "dialog" : "aside";
const contentId = `${id}-content`;
const labels = {
  handle: "Drag handle",
  close: "Close",
  ...dragHandleLabels,
};
// A modal sheet with a handle has two heights: half the window, and full when its content is
// taller than that. Without a handle to expand it, it keeps the full one.
const hasHalfHeight = isModal && showDragHandle;
// Only a standard sheet with a handle to expand it again can be collapsed
const startsCollapsed = !isModal && showDragHandle && isCollapsed;

// M3: full width, up to 640px, centred. In a window wider than 640px it also keeps 56px from the
// window's start and end edges.
const widthClasses =
  "mx-auto w-full max-w-160 [@media(width>640px)]:max-w-[min(640px,100%-7rem)]";

const placementClasses = isModal
  ? // overriding the UA dialog's centring margins and size limits
    "fixed inset-x-0 top-auto bottom-0 mb-0 max-h-none overflow-visible bg-transparent p-0 outline-none"
  : "sticky bottom-0 z-10";

// A modal sheet slides up from below the window, and back down, still showing until it's gone,
// over a 32% scrim that fades in and out
const modalClasses = isModal && [
  "translate-y-full open:translate-y-0 motion-safe:starting:open:translate-y-full",
  // M3: a sheet enters and leaves on its enter and exit pattern, as its scrim (ADR-0018)
  "motion-safe:transition-[display,overlay,translate] motion-safe:transition-discrete motion-safe:motion-enter-exit",
  "backdrop:bg-(--theme-color-scrim)/32 backdrop:opacity-0 open:backdrop:opacity-100 motion-safe:starting:open:backdrop:opacity-0",
  "motion-safe:backdrop:transition-[display,opacity,overlay] motion-safe:backdrop:transition-discrete motion-safe:motion-enter-exit-backdrop",
];

// A standard sheet's drag handle collapses and expands it. A modal sheet's closes it, until the
// script finds it a second height to expand to, when it opens. Its name stays put while it
// toggles, and aria-expanded carries the state.
const handleAttrs = isModal
  ? { "aria-label": labels.close }
  : {
      "aria-label": labels.handle,
      "aria-controls": contentId,
      "aria-expanded": !startsCollapsed,
    };

// Full height: the window's less M3's top margin, 72px, or 56px in a window wider than 640px.
// A modal sheet with a handle is capped at half the window until it's expanded (data-expanded).
const fullHeightClasses =
  "max-h-[calc(100dvh-4.5rem)] [@media(width>640px)]:max-h-[calc(100dvh-3.5rem)]";
const heightClasses = hasHalfHeight
  ? [
      "max-h-[50dvh] in-data-expanded:max-h-[calc(100dvh-4.5rem)] in-data-expanded:[@media(width>640px)]:max-h-[calc(100dvh-3.5rem)]",
      // on default spatial, M3's spring for a bottom sheet (ADR-0018)
      "motion-safe:transition-[max-height] motion-safe:duration-(--theme-duration-spring-default-spatial) motion-safe:ease-spring-default-spatial",
    ]
  : fullHeightClasses;
---

<Tag
  class:list={twMerge(placementClasses, widthClasses, modalClasses, classList)}
  id={id}
  data-ac-sheet-bottom={isModal ? "modal" : "standard"}
  {...attrs}
>
  {
    /* Its height follows its content, up to its height cap. Only the content scrolls. A
       BaseWrapper, so a modal sheet's focus rings and links follow its own surface, not the page
       it was placed in. role="none" on the header: in a modal sheet outside <main> and any
       sectioning element, it'd otherwise be the page's banner landmark while it's open. */
  }
  <BaseWrapper
    {bgColor}
    class:list={[
      "flex flex-col overflow-hidden rounded-t-[28px] shadow-theme-elevation-1",
      heightClasses,
    ]}
  >
    {
      /* M3: the sheet's whole top 48px is the handle's target, the 4px bar centred in it, 22px
         above and below. touch-none, so a drag on it isn't taken as a scroll. */
      showDragHandle && (
        <Header
          bgColor="transparent"
          class="flex shrink-0 flex-col"
          role="none"
        >
          <button
            class="group flex h-12 w-full cursor-grab touch-none items-center justify-center outline-none active:cursor-grabbing"
            type="button"
            data-ac-sheet-bottom-handle
            data-label-handle={labels.handle}
            data-label-close={labels.close}
            {...handleAttrs}
          >
            <span class="block h-1 w-8 rounded-full bg-(--theme-color-on-bg-variant)/40 group-focus-visible:ring-3 group-focus-visible:ring-(--theme-color-focus-ring-on-bg) group-focus-visible:ring-offset-2 group-focus-visible:ring-offset-(--theme-color-wrapper-bg)" />
          </button>
        </Header>
      )
    }
    <div
      class:list={[
        "min-h-0 flex-1 overflow-y-auto px-6 pb-6",
        "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-inset",
        !showDragHandle && "pt-6",
      ]}
      id={contentId}
      hidden={startsCollapsed}
      data-ac-sheet-bottom-content
    >
      <slot />
    </div>
  </BaseWrapper>
</Tag>

<script>
  // Past this, a drag on the handle collapses or closes the sheet (or expands a collapsed one)
  const dragThreshold = 32;

  // A modal sheet closes on a click on its scrim: its content fills the dialog, so a click that
  // lands on the dialog itself is on its ::backdrop. Like Escape, it fires a cancelable `cancel`
  // first. The press must start there too, so a text selection dragged out of the content doesn't
  // close it. Neither that, Escape nor the drag handle is an action, so all of them clear
  // returnValue, which Firefox and WebKit otherwise keep from the sheet's last opening.
  document
    .querySelectorAll<HTMLDialogElement>('[data-ac-sheet-bottom="modal"]')
    .forEach((sheet) => {
      let pressedOnScrim = false;
      sheet.addEventListener("pointerdown", (event) => {
        pressedOnScrim = event.target === sheet;
      });
      sheet.addEventListener("click", (event) => {
        const onScrim = event.target === sheet && pressedOnScrim;
        pressedOnScrim = false;
        if (
          onScrim &&
          sheet.dispatchEvent(new Event("cancel", { cancelable: true }))
        )
          sheet.close("");
      });
      sheet.addEventListener("cancel", () => {
        sheet.returnValue = "";
      });
    });

  // Content taller than the sheet scrolls, so it's a tab stop then, for keyboard users to scroll
  // it with the arrow keys; not before, so it isn't an extra stop with nothing to scroll
  const scrollable = new ResizeObserver((entries) => {
    entries.forEach(({ target }) => {
      if (target.scrollHeight > target.clientHeight)
        target.setAttribute("tabindex", "0");
      else target.removeAttribute("tabindex");
    });
  });
  document
    .querySelectorAll("[data-ac-sheet-bottom-content]")
    .forEach((content) => scrollable.observe(content));

  document
    .querySelectorAll<HTMLElement>("[data-ac-sheet-bottom]")
    .forEach((sheet) => {
      const handle = sheet.querySelector<HTMLButtonElement>(
        "[data-ac-sheet-bottom-handle]"
      );
      if (!handle) return;
      // a modal sheet's dialog
      const dialog = sheet instanceof HTMLDialogElement ? sheet : undefined;
      const content = sheet.querySelector<HTMLElement>(
        "[data-ac-sheet-bottom-content]"
      )!;
      const { labelHandle, labelClose } = handle.dataset;
      // the handle's state, for a sheet with two heights or states
      const showExpanded = (expanded: boolean) => {
        handle.setAttribute("aria-expanded", String(expanded));
        handle.setAttribute("aria-label", labelHandle!);
      };

      // A standard sheet: its content shown or hidden
      const setExpanded = (expanded: boolean) => {
        content.hidden = !expanded;
        showExpanded(expanded);
      };
      const isExpanded = () => handle.getAttribute("aria-expanded") === "true";

      // A modal sheet: at half the window's height, or expanded to full (data-expanded) when its
      // content is taller than half, measured as the sheet's height with all of its content
      // shown. With one height, the handle closes it, and has no expanded state.
      const panel = content.parentElement!;
      const hasTwoHeights = () =>
        panel.offsetHeight - content.clientHeight + content.scrollHeight >
        window.innerHeight / 2;
      const syncModal = () => {
        if (!dialog?.open) return;
        if (!hasTwoHeights()) {
          delete sheet.dataset.expanded;
          handle.removeAttribute("aria-expanded");
          handle.setAttribute("aria-label", labelClose!);
          return;
        }
        showExpanded("expanded" in sheet.dataset);
      };
      const setModalExpanded = (expanded: boolean) => {
        sheet.toggleAttribute("data-expanded", expanded);
        syncModal();
      };
      if (dialog) {
        // Each opening starts at half height. Reset as it opens, not on close, so a sheet closed
        // at full height slides away at full height; at once, as it's still below the window.
        dialog.addEventListener("toggle", (event) => {
          if (event.newState === "open" && "expanded" in sheet.dataset) {
            panel.style.transition = "none";
            delete sheet.dataset.expanded;
            panel.getBoundingClientRect();
            panel.style.removeProperty("transition");
          }
          syncModal();
        });
        // for content added or resized while it's open
        new ResizeObserver(syncModal).observe(content);
        window.addEventListener("resize", syncModal);
      }
      // Its handle's click, Enter or Space: what its label says
      const activate = () => {
        if (!dialog) setExpanded(!isExpanded());
        else if (handle.hasAttribute("aria-expanded"))
          setModalExpanded(!isExpanded());
        else dialog.close("");
      };
      // A drag down collapses the sheet, from full height to half, or closes a modal sheet at
      // half (or one height); a drag up expands it
      const dragDown = () => {
        if (!dialog) setExpanded(false);
        else if (isExpanded()) setModalExpanded(false);
        else dialog.close("");
      };
      const dragUp = () => {
        if (!dialog) setExpanded(true);
        else if (handle.hasAttribute("aria-expanded")) setModalExpanded(true);
      };

      // A drag ends in a click too, which mustn't undo what the drag just did
      let startY: number | undefined;
      let dragged = false;

      handle.addEventListener("pointerdown", (event) => {
        startY = event.clientY;
        dragged = false;
        handle.setPointerCapture(event.pointerId);
      });

      // A modal sheet follows the pointer down (never up), without its slide transition
      handle.addEventListener("pointermove", (event) => {
        if (startY === undefined) return;
        const dy = event.clientY - startY;
        if (Math.abs(dy) > 4) dragged = true;
        if (dialog) {
          sheet.style.transition = "none";
          sheet.style.translate = `0 ${Math.max(dy, 0)}px`;
        }
      });

      handle.addEventListener("pointerup", (event) => {
        if (startY === undefined) return;
        const dy = event.clientY - startY;
        startY = undefined;
        // dropped in the same frame as what the drag does, so the sheet moves on from where it
        // was let go
        sheet.style.removeProperty("transition");
        sheet.style.removeProperty("translate");
        if (dy > dragThreshold) dragDown();
        else if (dy < -dragThreshold) dragUp();
      });
      // a cancelled drag puts the sheet back as it was
      handle.addEventListener("pointercancel", () => {
        startY = undefined;
        sheet.style.removeProperty("transition");
        sheet.style.removeProperty("translate");
      });

      handle.addEventListener("click", () => {
        if (dragged) {
          dragged = false;
          return;
        }
        activate();
      });
    });
</script>
