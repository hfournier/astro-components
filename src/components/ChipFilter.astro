---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { SvgIconNameTypes } from "../svgs";
import { unwrapParagraph } from "../utils";
import BaseChip from "./BaseChip.astro";
import Icon from "./Icon.astro";

// An M3 filter chip: a tag or descriptive word that narrows content, selected and deselected by a
// click. It's a native checkbox inside a `<label>` drawn as the chip, or a radio in a
// single-select ChipGroup, so it submits with a form and needs no script to keep its state
// (ADR-0024). Selected, it turns secondary-container and gains a leading check mark, in place of
// its icon if it has one. With `menuId`, the whole chip is instead the button for the Menu that id
// names, with a trailing dropdown icon. Its label is then the filter's name until the menu sets
// the filter, when it shows the checked option and is selected (see the script below). BaseChip
// draws the rest: flat or elevated, the state layer, the touch target, the focus ring and
// disabled. Every attribute but `class` goes on the input, or on a menu chip's button; `class` on
// the chip.
type Props = Omit<HTMLAttributes<"input">, "type" | "checked"> & {
  // An icon before the label, by its file name in src/assets/svgs, which the check mark replaces
  // while the chip is selected
  icon?: SvgIconNameTypes;
  // Whether the chip starts selected; a menu chip's selection comes from its menu
  isSelected?: boolean;
  // the id of the Menu the chip opens, in place of being selected
  menuId?: string;
  // A checkbox, any number selected, or a radio in a single-select ChipGroup, which needs `name`
  selection?: "single" | "multi";
  variant?: "flat" | "elevated";
};

const {
  icon,
  isSelected = false,
  menuId,
  selection = "multi",
  variant = "flat",
  class: classList,
  ...attrs
}: Props = Astro.props;

// Checked here as well as in BaseChip, so a bad prop is reported under the component the author
// wrote (ADR-0023 §5)
if (!["flat", "elevated"].includes(variant)) {
  throw new Error(
    `ChipFilter: M3's chip styles are "flat" and "elevated", but this one's \`variant\` is "${variant}".`
  );
}
if (!["single", "multi"].includes(selection)) {
  throw new Error(
    `ChipFilter: its selections are "single" and "multi", but this one's \`selection\` is "${selection}".`
  );
}
if (menuId && isSelected) {
  throw new Error(
    `ChipFilter: a menu chip is selected by its menu's checked option, but this one, for "${menuId}", has \`isSelected\` too.`
  );
}
if (menuId && selection === "single") {
  throw new Error(
    `ChipFilter: a menu chip can't be one of a single-select set's radios, but this one, for "${menuId}", has \`selection="single"\`.`
  );
}
if (selection === "single" && !attrs.name) {
  throw new Error(
    `ChipFilter: a single-select chip is a radio, grouped with the others by a shared \`name\`, but this one has none.`
  );
}

const label = unwrapParagraph(await Astro.slots.render("default"));

// The chip is selected while its input is checked, or, for a menu chip, while the script below
// marks it data-ac-chip-filter-selected. The colors read the role set in the <style> block below,
// which swaps it while selected. A flat chip's outline, focused outline and disabled outline and
// container, and its selected rise to level 1 on hover, replace BaseChip's; an elevated chip keeps
// BaseChip's outline, disabled container and shadows.
const variantClasses = {
  flat: [
    "border-(--ac-chip-filter-outline) chip-focus-visible:border-(--ac-chip-filter-focus-outline)",
    "chip-disabled:border-(--ac-chip-filter-disabled-outline) chip-disabled:bg-(--ac-chip-filter-disabled-container)",
    "[&:is(:has(>input:checked),[data-ac-chip-filter-selected])]:chip-enabled:hover:shadow-theme-elevation-1 [&:is(:has(>input:checked),[data-ac-chip-filter-selected])]:chip-enabled:chip-active:shadow-none",
  ],
  elevated: [],
}[variant];
// A menu chip's attributes go on its button, with what makes it the menu's; a toggle's go on
// its input
const menuAttrs = menuId
  ? {
      commandfor: menuId,
      command: "toggle-popover" as const,
      "data-ac-chip-filter-menu": "",
      ...(attrs as HTMLAttributes<"button">),
    }
  : {};
const chipClasses = twMerge(
  "bg-(--ac-chip-filter-container) text-(--ac-chip-filter-label)",
  variantClasses,
  classList
);
---

{/* A toggle is a <label> around its input; a menu chip, the menu's <button> */}
<BaseChip
  as={menuId ? "button" : "label"}
  variant={variant}
  class={chipClasses}
  data-ac-chip-filter={variant}
  {...menuAttrs}
>
  {/* M3's leading space: as wide as an icon while there's one to show, 0 for a chip with no icon
       while unselected, so the check mark widens the chip as it appears */}
  <span
    slot="leading-icon"
    class:list={[
      "relative h-[18px] shrink-0 overflow-hidden",
      icon ? "w-[18px]" : "w-(--ac-chip-filter-leading-width)",
      "motion-safe:transition-[width] motion-safe:duration-(--theme-duration-spring-fast-spatial) motion-safe:ease-spring-fast-spatial",
    ]}
    data-ac-chip-filter-part="leading"
  >
    {icon && (
      <Icon
        class="absolute inset-s-0 top-0 size-[18px] text-(--theme-color-primary) opacity-(--ac-chip-filter-icon-opacity) group-chip-disabled/chip:text-current motion-safe:transition-opacity"
        name={icon}
        data-ac-chip-filter-part="icon"
      />
    )}
    <Icon
      class="absolute inset-s-0 top-0 size-[18px] opacity-(--ac-chip-filter-check-opacity) motion-safe:transition-opacity"
      name="check"
      data-ac-chip-filter-part="check"
    />
  </span>
  {/* The input covers the chip, above its touch target, so a press on it presses the input, and
      it takes the chip's corners. Its look is the label's. */}
  {!menuId && (
    <input
      class="absolute inset-0 z-1 m-0 cursor-[inherit] appearance-none rounded-[inherit] outline-none"
      type={selection === "single" ? "radio" : "checkbox"}
      checked={isSelected}
      data-ac-chip-filter-part="input"
      {...attrs}
    />
  )}
  <span data-ac-chip-filter-part="label" set:html={label} />
  {menuId && (
    <Icon slot="trailing-icon" class="size-[18px]" name="arrow_drop_down" />
  )}
</BaseChip>

<style>
  /* M3's filter chip roles, from its Specs page and Compose's FilterChipTokens: unselected, the
     label is on-surface-variant, a flat chip sits on an outline-variant outline that turns the
     label's color when focused, and an elevated one on surface-container-low. Selected, both are
     secondary-container with no outline, the label on-secondary-container, and the check mark
     shows in the leading space; disabled, a selected flat chip's container is on-surface at 12%.
     Global, as the chip is BaseChip's element, not this template's. */
  :global([data-ac-chip-filter]) {
    --ac-chip-filter-label: var(--theme-color-on-surface-variant);
    --ac-chip-filter-container: transparent;
    --ac-chip-filter-outline: var(--theme-color-outline-variant);
    --ac-chip-filter-focus-outline: currentColor;
    --ac-chip-filter-disabled-outline: color-mix(
      in oklab,
      var(--theme-color-on-surface) 12%,
      transparent
    );
    --ac-chip-filter-disabled-container: transparent;
    --ac-chip-filter-leading-width: 0px;
    --ac-chip-filter-icon-opacity: 1;
    --ac-chip-filter-check-opacity: 0;
  }
  :global([data-ac-chip-filter="elevated"]) {
    --ac-chip-filter-container: var(--theme-color-surface-container-low);
  }
  :global(
    [data-ac-chip-filter]:is(
      :has(> input:checked),
      [data-ac-chip-filter-selected]
    )
  ) {
    --ac-chip-filter-label: var(--theme-color-on-secondary-container);
    --ac-chip-filter-container: var(--theme-color-secondary-container);
    --ac-chip-filter-outline: transparent;
    --ac-chip-filter-focus-outline: transparent;
    --ac-chip-filter-disabled-outline: transparent;
    --ac-chip-filter-disabled-container: color-mix(
      in oklab,
      var(--theme-color-on-surface) 12%,
      transparent
    );
    --ac-chip-filter-leading-width: 18px;
    --ac-chip-filter-icon-opacity: 0;
    --ac-chip-filter-check-opacity: 1;
  }
</style>

<script>
  // M3's Accessibility page: Space or Enter selects or deselects the focused chip. A checkbox
  // takes Space itself; Enter is added here, rather than submitting the form. A radio keeps the
  // browser's keys (ADR-0024).
  document.addEventListener("keydown", (event) => {
    const input = event.target as Element;
    if (
      event.key !== "Enter" ||
      !input.matches?.("[data-ac-chip-filter-part=input][type=checkbox]")
    )
      return;
    event.preventDefault();
    (input as HTMLInputElement).click();
  });

  // A menu chip shows the filter its menu sets, as M3's filter chip with a menu does: its label
  // becomes the checked radio item's, which also names it for assistive tech, and it's selected.
  // A radio item with an empty `value` (such as "Any price") clears the filter, putting back the
  // chip's own label. With checkbox items, the label stays and the chip is selected while any is
  // checked. Run on load, and on each `change` the menu fires.
  const filterNames = new WeakMap<Element, string>();
  const showFilter = (chip: HTMLElement) => {
    const menu = document.getElementById(chip.getAttribute("commandfor") ?? "");
    const label = chip.querySelector("[data-ac-chip-filter-part=label]");
    if (!menu || !label) return;
    if (!filterNames.has(chip)) filterNames.set(chip, label.innerHTML);
    const radio = menu.querySelector<HTMLElement>(
      "[role=menuitemradio][aria-checked=true]:not([data-ac-menu-value=''])"
    );
    const isSelected =
      !!radio ||
      !!menu.querySelector("[role=menuitemcheckbox][aria-checked=true]");
    if (radio) label.textContent = radio.dataset.acMenuItem ?? "";
    else label.innerHTML = filterNames.get(chip) ?? "";
    chip.toggleAttribute("data-ac-chip-filter-selected", isSelected);
  };
  document
    .querySelectorAll<HTMLElement>("[data-ac-chip-filter-menu]")
    .forEach(showFilter);
  document.addEventListener("change", (event) => {
    const menu = event.target as Element;
    if (!menu.id) return;
    document
      .querySelectorAll<HTMLElement>(
        `[data-ac-chip-filter-menu][commandfor="${CSS.escape(menu.id)}"]`
      )
      .forEach(showFilter);
  });
</script>
