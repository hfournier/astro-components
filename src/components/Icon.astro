---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import { importSvg, type SvgIconNameTypes } from "../svgs";

type Props = HTMLAttributes<"svg"> & {
  name: SvgIconNameTypes;
  label?: string;
};

const { name, label, class: classList, ...attrs } = Astro.props;

const Tag = await importSvg(name);

const a11yAttrs = label
  ? ({ "aria-label": label } as const)
  : ({ "aria-hidden": "true" } as const);
---

<Tag
  class:list={twMerge(
    // M3 icons are 24px (the Material Symbols files are sized 48px, so the class sets the size)
    // and take the color of the text around them, as M3 icons in a component match its label.
    // Like M3, the icon itself doesn't change color on hover: its container shows a state layer.
    "size-6 fill-current",
    classList
  )}
  {...attrs}
  {...a11yAttrs}
/>
