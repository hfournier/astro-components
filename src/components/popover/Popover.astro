---
import type { ComponentProps } from "astro/types";
import BaseOverlay from "../BaseOverlay.astro";
import Icon from "../Icon.astro";

type BaseOverlayProps = ComponentProps<typeof BaseOverlay>;

type Props = BaseOverlayProps & {
  showCloseX?: boolean;
};

const { id, class: classList, showCloseX = false, ...attrs } = Astro.props;
---

<BaseOverlay
  as="div"
  class:list={[
    "m-4 rounded-xl bg-white p-4 md:m-5 md:mx-6 md:rounded-2xl md:p-6 lg:m-6 lg:mx-8 lg:rounded-3xl lg:p-8",
    classList,
  ]}
  {id}
  popover
  {...attrs}
>
  <slot />

  {
    showCloseX && (
      <button
        class:list={[
          "group/close border-grayish-200 bg-grayish-50 grid size-10 cursor-pointer place-items-center rounded-full border md:size-11 lg:size-12",
          "fixed top-[calc(anchor(top)-1rem)] right-[calc(anchor(right)-1rem)] md:top-[calc(anchor(top)-1.125rem)] md:right-[calc(anchor(right)-1.125rem)] lg:top-[calc(anchor(top)-1.25rem)] lg:right-[calc(anchor(right)-1.25rem)]",
          "[position-anchor:var(--hfdev-anchorname-overlay)]",
        ]}
        type="button"
        commandfor={id}
        command="close"
        aria-label="Close"
      >
        <Icon
          class="text-grayish-500 size-4 group-hover/close:text-black md:size-5"
          name="close"
        />
      </button>
    )
  }
</BaseOverlay>
