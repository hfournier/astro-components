---
import type { HTMLAttributes } from "astro/types";
import crypto from "node:crypto";
import { twMerge } from "tailwind-merge";
import type { BgColorType } from "../types";
import BaseWrapper from "./BaseWrapper.astro";
import ButtonIcon from "./ButtonIcon.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

// An M3 side sheet: supplementary content on the start or end edge of the window, in two kinds.
//
// - Standard (default): an <aside> beside the main content, both usable at once. Docked, it runs
//   the window's full height with a divider on its inner edge; place it in your layout, e.g. as
//   the last column of a grid, so the content beside it narrows to make room (M3's coplanar sheet).
// - Modal (isModal): a <dialog> that slides in over the page under a scrim, opened with
//   showModal(), so focus stays inside it, Escape closes it and the page is inert until it does.
//   Open it with a button carrying command="show-modal" and commandfor set to the sheet's id. It
//   also closes on a click on the scrim.
//
// Either kind can be detached (isDetached): 16px from the window's edges, with all four corners
// rounded, rather than docked flush to its edge.
//
// M3 requires a close button in every side sheet, so both kinds have one unless showCloseX is
// false, for a sheet that's a permanent part of the layout. An optional back button (showBack)
// fires a cancelable `back` event on the sheet, for the page to move back within it.
type Props = Omit<HTMLAttributes<"aside" | "dialog">, "id"> & {
  // The back button's accessible name and tooltip, for pages in other languages
  backLabel?: string;
  bgColor?: BgColorType;
  // The close button's accessible name and tooltip, for pages in other languages
  closeLabel?: string;
  edge?: "start" | "end";
  headline?: string;
  // Needed to open a modal sheet with commandfor; one is made up if it's left out
  id?: string;
  isDetached?: boolean;
  isModal?: boolean;
  showBack?: boolean;
  showCloseX?: boolean;
};
const {
  isModal = false,
  backLabel = "Back",
  bgColor = isModal ? "surface-container-low" : "surface",
  closeLabel = "Close",
  edge = "end",
  headline,
  id = `ac-sheet-side-${crypto.randomUUID()}`,
  isDetached = false,
  showBack = false,
  showCloseX = true,
  class: classList,
  ...attrs
} = Astro.props;

const Tag = isModal ? "dialog" : "aside";
const headlineId = headline ? `${id}-headline` : undefined;
const hasActions = Astro.slots.has("actions");
const hasHeader = !!headline || showBack || showCloseX;

// M3: 256px wide, at most 400px. Set as a custom property, so a consumer overrides it with one
// class, such as `[--ac-sheet-side-width:320px]`. Never wider than the window, less its margins.
const widthClasses =
  "[--ac-sheet-side-width:256px] w-(--ac-sheet-side-width) max-w-[min(400px,100vw-2rem)]";

// Docked, it runs the window's full height; detached, it's 16px from the window's edges
const placementClasses = isModal
  ? [
      // overriding the UA dialog's centring margins and size limits
      "fixed m-0 max-h-none max-w-none overflow-visible bg-transparent p-0 outline-none",
      isDetached ? "inset-y-4 h-auto" : "inset-y-0 h-dvh",
      {
        start: isDetached ? "start-4 end-auto" : "start-0 end-auto",
        end: isDetached ? "end-4 start-auto" : "end-0 start-auto",
      }[edge],
    ]
  : [
      "sticky shrink-0 self-start",
      isDetached ? "top-4 m-4 h-[calc(100dvh-2rem)]" : "top-0 h-dvh",
    ];

// A modal sheet slides in from off its edge (past a detached sheet's margin too), and back out,
// still showing until it's gone, over a 32% scrim that fades in and out. rtl: flips the slide,
// since translate is physical.
const modalClasses = isModal && [
  {
    start:
      "-translate-x-[calc(100%+1rem)] rtl:translate-x-[calc(100%+1rem)] motion-safe:starting:open:-translate-x-[calc(100%+1rem)] motion-safe:rtl:starting:open:translate-x-[calc(100%+1rem)]",
    end: "translate-x-[calc(100%+1rem)] rtl:-translate-x-[calc(100%+1rem)] motion-safe:starting:open:translate-x-[calc(100%+1rem)] motion-safe:rtl:starting:open:-translate-x-[calc(100%+1rem)]",
  }[edge],
  "open:translate-x-0 rtl:open:translate-x-0",
  // M3: a sheet enters on emphasized decelerate and leaves on emphasized accelerate (ADR-0018)
  "motion-safe:transition-[display,overlay,translate] motion-safe:transition-discrete motion-safe:duration-(--theme-duration-short-4) motion-safe:ease-emphasized-accelerate motion-safe:open:duration-(--theme-duration-medium-4) motion-safe:open:ease-emphasized-decelerate",
  "backdrop:bg-(--theme-color-scrim)/32 backdrop:opacity-0 open:backdrop:opacity-100 motion-safe:starting:open:backdrop:opacity-0",
  "motion-safe:backdrop:transition-[display,opacity,overlay] motion-safe:backdrop:transition-discrete motion-safe:backdrop:duration-(--theme-duration-short-4) motion-safe:backdrop:ease-emphasized-accelerate motion-safe:open:backdrop:duration-(--theme-duration-medium-4) motion-safe:open:backdrop:ease-emphasized-decelerate",
];

// Detached, it's rounded all round (M3 corner large). Docked, a modal sheet rounds its inner
// edge and sits at elevation 1; a standard one has a divider on its inner edge instead.
const shapeClasses = isDetached
  ? ["rounded-2xl", isModal && "shadow-theme-elevation-1"]
  : isModal
    ? [
        { start: "rounded-e-2xl", end: "rounded-s-2xl" }[edge],
        "shadow-theme-elevation-1",
      ]
    : {
        start: "border-e border-(--theme-color-outline-variant)",
        end: "border-s border-(--theme-color-outline-variant)",
      }[edge];

// A modal sheet's close button closes its dialog; a standard sheet's hides it (see the script).
// Its empty value clears returnValue, since closing isn't one of the sheet's actions.
const closeAttrs = isModal
  ? { command: "close", commandfor: id, value: "" }
  : { "data-ac-sheet-side-close": "" };
---

<Tag
  class:list={twMerge(placementClasses, widthClasses, modalClasses, classList)}
  id={id}
  aria-labelledby={headlineId}
  data-ac-sheet-side={isModal ? "modal" : "standard"}
  {...attrs}
>
  {
    /* Only the content scrolls; the actions stay below it, under a divider. The headline is M3
       Title Large. A BaseWrapper, so a modal sheet's focus rings and links follow its own
       surface, not the page it was placed in. role="none" on the header and footer: in a modal
       sheet outside <main> and any sectioning element, they'd otherwise be the page's banner and
       contentinfo landmarks while it's open. */
  }
  <BaseWrapper
    {bgColor}
    class:list={["flex h-full flex-col overflow-hidden", shapeClasses]}
  >
    {
      hasHeader && (
        <Header
          bgColor="transparent"
          role="none"
          class:list={[
            "flex shrink-0 items-center gap-3 pe-6 pt-6 pb-4",
            // M3: 16px at the start with a back button, 24px without
            showBack ? "ps-4" : "ps-6",
          ]}
        >
          {showBack && (
            <ButtonIcon
              class="rtl:[&>svg]:-scale-x-100"
              icon="arrow_back"
              label={backLabel}
              data-ac-sheet-side-back
            />
          )}
          {headline && (
            <h2
              class="min-w-0 flex-1 text-[1.375rem] leading-7 font-normal tracking-normal text-(--theme-color-on-bg-variant)"
              id={headlineId}
            >
              {headline}
            </h2>
          )}
          {showCloseX && (
            <ButtonIcon
              class="ms-auto -me-2"
              icon="close"
              label={closeLabel}
              {...closeAttrs}
            />
          )}
        </Header>
      )
    }
    <div
      class:list={[
        // M3: side sheets never scroll sideways
        "min-h-0 flex-1 overflow-x-hidden overflow-y-auto px-6 pb-6",
        !hasHeader && "pt-6",
      ]}
    >
      <slot />
    </div>
    {
      hasActions && (
        <Footer
          bgColor="transparent"
          role="none"
          class="flex min-h-18 shrink-0 items-center justify-start gap-2 border-t border-(--theme-color-outline-variant) px-6 pt-4 pb-6"
        >
          <slot name="actions" />
        </Footer>
      )
    }
  </BaseWrapper>
</Tag>

<script>
  // A modal sheet closes on a click on its scrim: its content fills the dialog, so a click that
  // lands on the dialog itself is on its ::backdrop. Like Escape, it fires a cancelable `cancel`
  // first. The press must start there too, so a text selection dragged out of the content doesn't
  // close it. Neither that nor Escape is an action, so both clear returnValue, which Firefox and
  // WebKit otherwise keep from the sheet's last opening.
  document
    .querySelectorAll<HTMLDialogElement>('[data-ac-sheet-side="modal"]')
    .forEach((sheet) => {
      let pressedOnScrim = false;
      sheet.addEventListener("pointerdown", (event) => {
        pressedOnScrim = event.target === sheet;
      });
      sheet.addEventListener("click", (event) => {
        const onScrim = event.target === sheet && pressedOnScrim;
        pressedOnScrim = false;
        if (
          onScrim &&
          sheet.dispatchEvent(new Event("cancel", { cancelable: true }))
        )
          sheet.close("");
      });
      sheet.addEventListener("cancel", () => {
        sheet.returnValue = "";
      });
    });

  // A standard sheet's close button hides it; remove its hidden attribute to show it again. The
  // back button fires a cancelable `back` on its sheet, for the page to decide what going back
  // means, so it doesn't close the sheet.
  document.addEventListener("click", (event) => {
    const target = event.target as Element;
    const sheet = target
      .closest("[data-ac-sheet-side-close]")
      ?.closest<HTMLElement>('[data-ac-sheet-side="standard"]');
    if (sheet) sheet.hidden = true;
    target
      .closest("[data-ac-sheet-side-back]")
      ?.closest("[data-ac-sheet-side]")
      ?.dispatchEvent(new CustomEvent("back", { cancelable: true }));
  });
</script>
