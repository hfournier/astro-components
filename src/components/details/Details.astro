---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { SvgIconNameTypes } from "../../svgs";
import type { DetailsVariantType } from "../../types";
import Icon from "../icon/Icon.astro";

type Props = HTMLAttributes<"details"> & {
  label: string;
  icon?: SvgIconNameTypes;
  variant?: DetailsVariantType;
};

const {
  label,
  icon,
  variant = "outlined",
  class: classList,
  ...attrs
} = Astro.props;
---

<!-- M3 has no disclosure component: the summary follows M3's one-line list item (56px, 16px
     padding and gaps, Body Large, 24px icons); the outlined variant wraps it in an outlined card.
     Colors inherit the surrounding text color, so it works on any BaseWrapper background. -->
<details
  class:list={twMerge(
    "group/details overflow-hidden",
    "details-content:h-0 details-content:opacity-0 motion-safe:details-content:transition-[height,opacity,content-visibility] motion-safe:details-content:transition-discrete motion-safe:details-content:duration-(--theme-duration-overlay)",
    "details-content:starting:h-0 details-content:starting:opacity-0",
    "open:details-content:h-auto open:details-content:opacity-100",
    variant === "outlined" &&
      "rounded-xl border border-(--theme-color-outline-variant)",
    classList
  )}
  {...attrs}
>
  <summary
    class:list={[
      "relative isolate flex min-h-14 cursor-pointer list-none items-center gap-4 rounded-xl px-4 py-2 [&::-webkit-details-marker]:hidden",
      "text-base leading-6 tracking-[0.5px]",
      // M3 state layer, in the label color
      "before:absolute before:inset-0 before:-z-10 before:rounded-[inherit] before:bg-current before:opacity-0 hover:before:opacity-8 focus-visible:before:opacity-10 active:before:opacity-10 motion-safe:before:transition-opacity motion-safe:before:duration-(--theme-duration-feedback)",
      // inset, so the card's overflow-hidden doesn't clip it
      "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-inset",
    ]}
  >
    {
      icon && (
        <Icon
          class="shrink-0"
          data-ac-details-icon="true"
          name={icon}
        />
      )
    }
    <span class="grow text-pretty">{label}</span>
    <Icon
      class:list={[
        "shrink-0",
        "group-open/details:rotate-180 motion-safe:transition-[rotate] motion-safe:duration-(--theme-duration-overlay)",
      ]}
      data-ac-details-chevron="true"
      name="keyboard_arrow_down"
    />
  </summary>
  <!-- content lines up with the summary label -->
  <div class:list={["px-4", variant === "outlined" && "pb-4"]}>
    <slot />
  </div>
</details>
