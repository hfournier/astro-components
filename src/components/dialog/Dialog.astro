---
import type { ComponentProps } from "astro/types";
import { twMerge } from "tailwind-merge";
import Icon from "../Icon.astro";
import BaseOverlay from "../BaseOverlay.astro";

type BaseOverlayProps = ComponentProps<typeof BaseOverlay>;

type Props = BaseOverlayProps;

const { id, class: classList, ...attrs } = Astro.props;
---

<BaseOverlay
  class:list={twMerge("rounded-container bg-white", classList)}
  {id}
  {...attrs}
>
  <header
    class:list={twMerge(
      "border-grayish-200 bg-grayish-50 flex items-center justify-between rounded-t-container border-b-(length:--border-width-divider) p-4 md:px-6"
    )}
  >
    <slot name="header" />

    <button
      class:list={twMerge(
        "group/close bg-grayish-50 cursor-pointer",
        "focus-visible:outline-focus-ring focus-visible:outline-(length:--focus-ring-width) focus-visible:outline-offset-(--focus-ring-offset)"
      )}
      type="button"
      commandfor={id}
      command="close"
      aria-label="Close"
    >
      <Icon
        class="text-grayish-500 size-4 group-hover/close:text-black md:size-5"
        name="close"
      />
    </button>
  </header>

  <div class="min-h-16 p-4 md:px-6">
    <slot />
  </div>

  <footer
    class:list={twMerge(
      "border-grayish-200 bg-grayish-50 rounded-b-container border-t-(length:--border-width-divider) p-4 md:px-6"
    )}
  >
    <slot name="footer" />
  </footer>
</BaseOverlay>
