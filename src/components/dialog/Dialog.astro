---
import type { ComponentProps } from "astro/types";
import { twMerge } from "tailwind-merge";
import Icon from "../icon/Icon.astro";
import BaseOverlay from "../base-overlay/BaseOverlay.astro";

type BaseOverlayProps = ComponentProps<typeof BaseOverlay>;

type Props = BaseOverlayProps;

const { id, class: classList, ...attrs } = Astro.props;
---

<BaseOverlay
  class:list={twMerge("rounded-container min-w-xs bg-white", classList)}
  {id}
  {...attrs}
>
  <header
    class:list={twMerge(
      "border-divider bg-container rounded-t-container flex items-center justify-between border-b-(length:--border-width-divider) p-4 md:px-6"
    )}
  >
    {Astro.slots.has("header") ? <slot name="header" /> : <>&nbsp;</>}

    <button
      class:list={twMerge(
        "group/close bg-container cursor-pointer",
        "focus-visible:outline-focus-ring focus-visible:outline-(length:--focus-ring-width) focus-visible:outline-offset-(--focus-ring-offset)"
      )}
      type="button"
      commandfor={id}
      command="close"
      aria-label="Close"
    >
      <Icon
        class="text-icon size-4 group-hover/close:text-black md:size-5"
        name="x-mark"
      />
    </button>
  </header>

  <div class="min-h-16 p-4 md:px-6">
    <slot />
  </div>

  {
    Astro.slots.has("footer") && (
      <footer
        class:list={twMerge(
          "border-divider bg-container rounded-b-container border-t-(length:--border-width-divider) p-4 md:px-6"
        )}
      >
        <slot name="footer" />
      </footer>
    )
  }
</BaseOverlay>
