---
import type { HTMLAttributes } from "astro/types";
import Icon from "../icon/Icon.astro";
import { extendTailwindMerge } from "tailwind-merge";

// tailwind-merge's default config doesn't know the --text-heading-* role tokens (global.css,
// ADR-0008) are a font-size scale, not a color: left as plain `text-*` classes, it lumps them
// into the same ambiguous group as the `text-heading` color utility below (from --color-heading)
// and silently drops whichever comes first, regardless of the two being independent axes. Same
// fix as Button.astro's `text-control`/`-control-sm`/`-control-lg`.
const twMerge = extendTailwindMerge({
  extend: {
    classGroups: {
      "font-size": [
        "text-heading-xs",
        "text-heading-sm",
        "text-heading-md",
        "text-heading-lg",
        "text-heading-xl",
        "text-heading-2xl",
      ],
    },
  },
});

type Props = HTMLAttributes<"h1"> & {
  level: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
};

const { class: classList, id, level, ...attrs } = Astro.props;

const headingClasses = {
  h1: "text-heading-2xl font-heading-lg",
  h2: "text-heading-xl font-heading-lg",
  h3: "text-heading-lg font-heading-lg",
  h4: "text-heading-md font-heading-sm",
  h5: "text-heading-sm font-heading-sm",
  h6: "text-heading-xs font-heading-sm",
}[level];

const Tag = level;
---

{
  id ? (
    <div class="group/heading flex items-center gap-2">
      <Tag
        class:list={twMerge("text-heading", headingClasses, classList)}
        {id}
        {...attrs}
      >
        <slot />
      </Tag>

      <a
        class:list={["text-heading", headingClasses]}
        href={`#${id}`}
        aria-labelledby={id}
      >
        <Icon
          name="link"
          class="size-[0.7em] opacity-0 group-hover/heading:opacity-100 motion-safe:transition-opacity"
        />
      </a>
    </div>
  ) : (
    <Tag
      class:list={twMerge("text-heading", headingClasses, classList)}
      {id}
      {...attrs}
    >
      <slot />
    </Tag>
  )
}
