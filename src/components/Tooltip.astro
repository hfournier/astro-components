---
import type { HTMLAttributes } from "astro/types";
import crypto from "node:crypto";
import { twMerge } from "tailwind-merge";
import BaseWrapper from "./BaseWrapper.astro";
import { unwrapParagraph } from "../utils";

// M3 tooltips, in two variants that are placed differently:
//
// - "plain" (default): a short label for the element it's placed in, above it (or below, in an
//   app bar). Put it as a direct child of that element, which must be positioned (e.g.
//   `relative`). It shows 500ms into a hover, straight away on keyboard focus, and on a long press
//   on a touchscreen. Its text repeats the element's accessible name, so it's hidden from assistive
//   tech. To anchor to the element's border box rather than its padding box, the element sets
//   --ac-tooltip-anchor-inset to minus its border width (e.g. `[--ac-tooltip-anchor-inset:-1px]`).
//   While the element doesn't need its tooltip, such as while its label is visible, it sets
//   --ac-tooltip-off to 1 (e.g. `rail-expanded:[--ac-tooltip-off:1]`): the tooltip doesn't show,
//   and doesn't hide any other.
// - "rich": an optional subhead, supporting text and optional actions (the `actions` slot, e.g.
//   text Buttons), below its element. It can hold interactive content, so it can't live inside
//   the element it describes: put it right after that element and pass the element's id as
//   `for`. It opens like a plain tooltip, stays open while the pointer or focus is on either of
//   them, and becomes the element's accessible description (aria-describedby, minus the actions).
//   Keyboard users reach the actions with Tab, since the tooltip follows the element in the DOM.
//   `isPersistent` makes it M3's persistent rich tooltip instead: a click on its element (a
//   button) toggles it, and it stays open until the person interacts with something else.
//
// As in M3, a tooltip stays 1.5s after the pointer leaves (or the finger lifts), and only one
// shows at a time: showing one hides any other straight away.
type Props = HTMLAttributes<"div"> & {
  // rich only: the id of the element the tooltip describes
  for?: string;
  // rich only: opened by a click on its element rather than hover or focus, and kept open until
  // the person interacts with something else
  isPersistent?: boolean;
  // plain only: M3 puts a plain tooltip above its element, or below it in an app bar
  placement?: "above" | "below";
  // rich only: a Title Small heading above the supporting text
  subhead?: string;
  variant?: "plain" | "rich";
};
const {
  for: triggerId,
  isPersistent = false,
  placement = "above",
  subhead,
  variant = "plain",
  class: classList,
  ...attrs
} = Astro.props;

// Values outside these fail the build, rather than drawing something other than was asked for
// (ADR-0021)
if (!["above", "below"].includes(placement)) {
  throw new Error(
    `Tooltip: its placements are "above" and "below", but this one's \`placement\` is "${placement}".`
  );
}
if (!["plain", "rich"].includes(variant)) {
  throw new Error(
    `Tooltip: M3's tooltips are "plain" and "rich", but this one's \`variant\` is "${variant}".`
  );
}

if (variant === "rich" && !triggerId) {
  throw new Error(
    "Tooltip: a rich tooltip needs `for`, the id of the element it describes."
  );
}

// Each tooltip anchors to its own element, so each needs its own anchor name. A plain tooltip puts
// it on an inner span rather than the element itself, so it can't clash with an anchor-name the
// element has; a rich tooltip's script adds it to the element's own anchor names.
const randomId = crypto.randomUUID();
const anchorName = `--ac-anchorname-tooltip-${randomId}`;
const descriptionId = `ac-tooltip-description-${randomId}`;
const hasActions = Astro.slots.has("actions");
const text = unwrapParagraph(await Astro.slots.render("default"));

// Inside a rich tooltip's 12px top and 8px bottom padding: 4px between the subhead and the
// supporting text, and 12px between the text and the actions
const textPadding = [subhead && "pt-1", hasActions && "pb-3"];
---

{variant === "plain" ? (
  <>
    <span
      class="pointer-events-none absolute inset-(--ac-tooltip-anchor-inset,0px)"
      style={`anchor-name: ${anchorName}`}
      aria-hidden="true"
    />
    <span
      class:list={twMerge(
        // M3 plain tooltip: Body Small, corner extra small, 4px from its element. Next to plain
        // text, M3 leaves 8px: pass `mb-2` (`mt-2` below). It flips to the other side or shifts
        // sideways to stay in the viewport. A popover, so it sits in the top layer, above
        // anything its element's stacking context would put it under.
        "inset-auto m-0 min-h-6 w-max max-w-50 min-w-10 overflow-visible rounded-sm border-0 px-2 py-1",
        "bg-(--theme-color-inverse-surface) text-center text-xs leading-4 font-normal tracking-[0.4px] text-(--theme-color-inverse-on-surface)",
        placement === "above"
          ? "mb-1 [position-area:top] [position-try-fallbacks:top_span-left,top_span-right,flip-block]"
          : "mt-1 [position-area:bottom] [position-try-fallbacks:bottom_span-left,bottom_span-right,flip-block]",
        // bridges the 4px gap, so the pointer can move onto the tooltip without it hiding (WCAG
        // 1.4.13). It covers every side, since a fallback can flip the tooltip to the other one.
        "before:absolute before:-inset-1",
        // The script opens the popover and sets data-shown once the tooltip should show, after
        // its delays. The starting style lets it fade in from display: none, and
        // transition-discrete keeps it in place while it fades out once closed. Only the fade is
        // motion: with reduced motion, visibility still flips, so the delays are kept.
        "invisible opacity-0 data-shown:visible data-shown:opacity-100 starting:invisible! starting:opacity-0!",
        // A small component's fade, so on fast effects, M3's speed for small components
        // (ADR-0018). The timing isn't motion-safe, since with reduced motion it still times the
        // visibility change, which isn't motion.
        "transition-[visibility,display,overlay] transition-discrete duration-(--theme-duration-spring-fast-effects) ease-spring-fast-effects motion-safe:transition-[opacity,visibility,display,overlay]",
        classList
      )}
      style={`position-anchor: ${anchorName}`}
      popover="manual"
      aria-hidden="true"
      data-ac-tooltip
      {...attrs}
    >
      <Fragment set:html={text} />
    </span>
  </>
) : (
  <BaseWrapper
    bgColor="surface-container"
    class={twMerge(
      // M3 rich tooltip: corner medium, centered below its element, as M3 allows on desktop. A
      // popover, so it sits in the top layer.
      "inset-auto m-0 mt-1 min-h-6 w-max max-w-80 min-w-10 overflow-visible rounded-xl border-0 px-4 pt-3 pb-2 text-left shadow-theme-elevation-2",
      "text-(--theme-color-on-surface-variant)",
      "[position-area:bottom] [position-try-fallbacks:bottom_span-left,bottom_span-right,flip-block]",
      // bridges the 4px gap, so the pointer can move onto the tooltip without it closing
      "before:absolute before:-inset-1 before:-z-10",
      // its show and hide delays are in the script, so with reduced motion it just appears
      "opacity-0 open:opacity-100 motion-safe:transition-[opacity,display,overlay] motion-safe:transition-discrete motion-safe:duration-(--theme-duration-spring-fast-effects) motion-safe:ease-spring-fast-effects motion-safe:starting:open:opacity-0",
      classList
    )}
    style={`position-anchor: ${anchorName}`}
    popover={isPersistent ? "auto" : "manual"}
    role="tooltip"
    data-ac-tooltip-rich={triggerId}
    data-ac-tooltip-persistent={isPersistent ? "" : undefined}
    data-ac-anchor-name={anchorName}
    {...attrs}
  >
    <div id={descriptionId}>
      {subhead && (
        <p class="text-sm leading-5 font-medium tracking-[0.1px]">{subhead}</p>
      )}
      {/* M3 Body Medium */}
      <div class:list={[textPadding, "text-sm leading-5 tracking-[0.25px]"]}>
        <Fragment set:html={text} />
      </div>
    </div>
    {hasActions && (
      <div
        class="flex min-h-9 flex-wrap items-center gap-2"
        data-ac-tooltip-actions
      >
        <slot name="actions" />
      </div>
    )}
  </BaseWrapper>
)}

<script>
  const hoverDelay = 500; // M3: a tooltip shows this long into a hover, or a touch
  const lingerDelay = 1500; // M3: and stays this long after the pointer leaves or the finger lifts
  const longPressDelay = 500; // how long a touch must be held to show a tooltip
  const longPressSlop = 10; // px a held finger can drift, before the press counts as a scroll

  // M3 shows one tooltip at a time: showing one hides every other straight away
  const hideNowFns = new Set<() => void>();
  const hideOthers = (hideNow: () => void) =>
    hideNowFns.forEach((other) => other !== hideNow && other());

  // Touch can't hover, so on a touchscreen a long press shows the tooltip, as M3 asks. The click
  // that ends the press is swallowed, so holding an element to read its label doesn't also
  // activate it, and so is the browser's context menu or callout during the press. Some browsers
  // send no click after a long press, so only a click straight after it is swallowed, or a later
  // click, key press or assistive tech activation would be lost.
  const onLongPress = (
    element: HTMLElement,
    press: () => void,
    release: () => void
  ) => {
    let timer: number | undefined;
    let start = { x: 0, y: 0 };
    let isTouching = false;
    let isPressed = false;
    let swallowClickUntil = 0;
    const end = () => {
      clearTimeout(timer);
      isTouching = false;
      if (!isPressed) return;
      isPressed = false;
      swallowClickUntil = Date.now() + 500;
      release();
    };

    element.style.setProperty("-webkit-touch-callout", "none");
    element.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "touch") return;
      isTouching = true;
      isPressed = false;
      start = { x: event.clientX, y: event.clientY };
      timer = window.setTimeout(() => {
        isPressed = true;
        press();
      }, longPressDelay);
    });
    // moving the finger away, e.g. to scroll, cancels the press
    element.addEventListener("pointermove", (event) => {
      if (
        isTouching &&
        !isPressed &&
        Math.hypot(event.clientX - start.x, event.clientY - start.y) >
          longPressSlop
      ) {
        end();
      }
    });
    element.addEventListener("pointerup", end);
    element.addEventListener("pointercancel", end);
    element.addEventListener("contextmenu", (event) => {
      if (isTouching) event.preventDefault();
    });
    element.addEventListener(
      "click",
      (event) => {
        if (Date.now() > swallowClickUntil) return;
        swallowClickUntil = 0;
        event.preventDefault();
        event.stopImmediatePropagation();
      },
      { capture: true }
    );
  };

  // Plain tooltips: a manual popover, opened when its element is hovered, focused or pressed, so
  // it's in the top layer; data-shown makes it visible (see its classes). Opening it afresh each
  // time also puts it above any popover or dialog opened since.
  document
    .querySelectorAll<HTMLElement>("[data-ac-tooltip]")
    .forEach((tooltip) => {
      const parent = tooltip.parentElement!;
      let timer: number | undefined;
      // Tracked here rather than with :hover, which sticks to an element after a tap
      let isPointerOver = false;
      let isPressed = false;
      // set by Escape, so the tooltip stays hidden until the pointer leaves or focus moves away
      let isDismissed = false;

      const isShown = () => tooltip.hasAttribute("data-shown");
      // read when it would show, so it can follow a media or container query
      const isOff = () =>
        getComputedStyle(tooltip)
          .getPropertyValue("--ac-tooltip-off")
          .trim() === "1";
      const isEngaged = () =>
        isPointerOver || isPressed || parent.matches(":focus-visible");
      const hideNow = () => {
        clearTimeout(timer);
        tooltip.removeAttribute("data-shown");
        if (tooltip.matches(":popover-open")) tooltip.hidePopover();
      };
      const show = () => {
        clearTimeout(timer);
        if (isDismissed || isOff()) return;
        hideOthers(hideNow);
        // data-shown first: Firefox can leave a popover on its starting style, hidden, when the
        // attribute is set just after showPopover()
        tooltip.setAttribute("data-shown", "");
        if (!tooltip.matches(":popover-open")) tooltip.showPopover();
      };
      // A tooltip that never showed, cut short before its hover delay, hides at once
      const hideLater = () => {
        clearTimeout(timer);
        if (isEngaged()) return;
        if (!isShown()) return hideNow();
        timer = window.setTimeout(() => {
          if (!isEngaged()) hideNow();
        }, lingerDelay);
      };
      hideNowFns.add(hideNow);

      parent.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "touch") return;
        isPointerOver = true;
        clearTimeout(timer);
        if (!isShown()) timer = window.setTimeout(show, hoverDelay);
      });
      parent.addEventListener("pointerleave", (event) => {
        if (event.pointerType === "touch") return;
        isPointerOver = false;
        isDismissed = false;
        hideLater();
      });
      parent.addEventListener("focusin", () => {
        if (parent.matches(":focus-visible")) show();
      });
      // a keyboard blur hides it straight away
      parent.addEventListener("focusout", () => {
        isDismissed = false;
        if (!isPointerOver && !isPressed) hideNow();
      });
      onLongPress(
        parent,
        () => {
          isPressed = true;
          show();
        },
        () => {
          isPressed = false;
          hideLater();
        }
      );

      // WCAG 1.4.13: Escape hides a showing tooltip without moving the pointer or focus
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !isShown()) return;
        isDismissed = true;
        hideNow();
      });
    });

  document
    .querySelectorAll<HTMLElement>("[data-ac-tooltip-rich]")
    .forEach((tooltip) => {
      const trigger = document.getElementById(tooltip.dataset.acTooltipRich!);
      if (!trigger) return;

      // Anchor the tooltip to its trigger, keeping any anchor names the trigger already has
      const ownNames =
        getComputedStyle(trigger).getPropertyValue("anchor-name");
      const anchorName = tooltip.dataset.acAnchorName!;
      trigger.style.setProperty(
        "anchor-name",
        ownNames && ownNames !== "none"
          ? `${ownNames}, ${anchorName}`
          : anchorName
      );

      // The subhead and supporting text describe the trigger (the actions don't)
      const descriptionId = tooltip.firstElementChild!.id;
      const describedBy =
        trigger.getAttribute("aria-describedby")?.split(" ") ?? [];
      if (!describedBy.includes(descriptionId)) {
        trigger.setAttribute(
          "aria-describedby",
          [...describedBy, descriptionId].join(" ")
        );
      }

      const isOpen = () => tooltip.matches(":popover-open");
      let timer: number | undefined;
      // Another tooltip showing closes this one, and cancels its pending open, but not while it
      // holds focus, which would be lost with it
      const hideNow = () => {
        if (tooltip.contains(document.activeElement)) return;
        clearTimeout(timer);
        if (isOpen()) tooltip.hidePopover();
      };
      tooltip.addEventListener("toggle", (event) => {
        if ((event as ToggleEvent).newState === "open") hideOthers(hideNow);
      });
      // An action, once clicked, has done its job, so it closes the tooltip
      const onAction = (dismiss: () => void) =>
        tooltip
          .querySelector("[data-ac-tooltip-actions]")
          ?.addEventListener("click", (event) => {
            if ((event.target as Element).closest("a, button")) dismiss();
          });

      // A persistent rich tooltip is an auto popover its trigger toggles, so the browser closes it
      // on Escape or a click anywhere else (light dismiss), leaving out a click on the trigger.
      // M3 keeps it open until the person interacts with something else, so focus moving
      // elsewhere closes it too, but another tooltip showing doesn't: a hover on its way past
      // would close one a page opened on load.
      if (tooltip.hasAttribute("data-ac-tooltip-persistent")) {
        if (!(trigger instanceof HTMLButtonElement)) {
          throw new Error(
            "Tooltip: a persistent rich tooltip's `for` must be a <button>, which toggles it."
          );
        }
        trigger.popoverTargetElement = tooltip;
        trigger.setAttribute("aria-expanded", "false");
        tooltip.addEventListener("toggle", (event) => {
          trigger.setAttribute(
            "aria-expanded",
            String((event as ToggleEvent).newState === "open")
          );
        });
        document.addEventListener("focusin", (event) => {
          const target = event.target as Node;
          if (
            isOpen() &&
            !trigger.contains(target) &&
            !tooltip.contains(target)
          ) {
            tooltip.hidePopover();
          }
        });
        // focus goes back to the element, rather than to the page as the action disappears
        onAction(() => {
          trigger.focus();
          tooltip.hidePopover();
        });
        return;
      }

      // A transient rich tooltip: a manual popover opened and closed from its trigger's hover,
      // focus and long press
      hideNowFns.add(hideNow);
      // set by Escape or an action, so returning focus to the trigger doesn't reopen the tooltip;
      // cleared once the pointer enters or leaves the trigger, or focus leaves it
      let isDismissed = false;
      // Tracked here rather than with :hover, which sticks to an element after a tap
      let isPointerOver = false;
      let isPressed = false;
      const isEngaged = () =>
        isPointerOver ||
        isPressed ||
        trigger.matches(":focus-visible") ||
        tooltip.contains(document.activeElement);
      const open = (delay: number) => {
        if (isDismissed) return;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (!isOpen()) tooltip.showPopover();
        }, delay);
      };
      const close = (delay: number) => {
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          if (isOpen() && !isEngaged()) tooltip.hidePopover();
        }, delay);
      };

      for (const element of [trigger, tooltip]) {
        element.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "touch") return;
          isPointerOver = true;
          if (element === trigger) isDismissed = false;
          if (element === trigger && !isOpen()) open(hoverDelay);
          else clearTimeout(timer);
        });
        element.addEventListener("pointerleave", (event) => {
          if (event.pointerType === "touch") return;
          isPointerOver = false;
          // a tooltip that never opened, cut short before its hover delay, needs no linger
          close(isOpen() ? lingerDelay : 0);
        });
        element.addEventListener("focusout", () => close(0));
      }
      trigger.addEventListener("focusin", () => {
        if (trigger.matches(":focus-visible")) open(0);
      });
      trigger.addEventListener("pointerleave", () => (isDismissed = false));
      trigger.addEventListener("blur", () => (isDismissed = false));
      onLongPress(
        trigger,
        () => {
          isPressed = true;
          open(0);
        },
        () => {
          isPressed = false;
          close(lingerDelay);
        }
      );

      const dismiss = () => {
        clearTimeout(timer);
        isDismissed = true;
        if (tooltip.contains(document.activeElement)) trigger.focus();
        tooltip.hidePopover();
      };
      onAction(dismiss);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && isOpen()) dismiss();
      });
    });
</script>
