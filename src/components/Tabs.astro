---
import type { ComponentProps } from "astro/types";
import {
  COMMENT_NODE,
  ELEMENT_NODE,
  TEXT_NODE,
  parse,
  render,
  walkSync,
  type Node,
} from "ultrahtml";
import crypto from "node:crypto";
import { twMerge } from "tailwind-merge";
import TabList from "./TabList.astro";
import TabPanels from "./TabPanels.astro";
import BaseWrapper from "./BaseWrapper.astro";
import type { TabType, TabVariantType } from "../types";
import type { SvgIconNameTypes } from "../svgs";

type BaseWrapperProps = ComponentProps<typeof BaseWrapper>;

type Props = Omit<BaseWrapperProps, "as"> & {
  variant?: TabVariantType;
};

const { variant = "primary", class: classList, ...attrs } = Astro.props;

const slot = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : "";

const randomId = crypto.randomUUID();
const tabs: TabType[] = [];
const tabContents: string[] = [];
const isTabPanel = (node: Node) =>
  node.type === ELEMENT_NODE &&
  node.attributes["data-ac-tabpanel"] !== undefined;

// Each Tab must be a direct child: Tabs finds them among the slot's top-level nodes, so anything
// else there (other than whitespace and comments) throws rather than being dropped from the page
for (const node of parse(slot).children as Node[]) {
  if (node.type === COMMENT_NODE) continue;
  if (node.type === TEXT_NODE && node.value.trim() === "") continue;
  if (!isTabPanel(node)) {
    let hasTab = false;
    walkSync(node, (child) => {
      hasTab ||= isTabPanel(child);
    });
    const found =
      node.type === ELEMENT_NODE
        ? `${hasTab ? "a Tab wrapped in " : ""}<${node.name}>`
        : `"${node.value.trim().replace(/\s+/g, " ").slice(0, 40)}"`;
    throw new Error(
      `Tabs: found ${found}, but only Tab components can go in Tabs, each as a direct child (not wrapped in another element or component).`
    );
  }

  // connect the tabpanel to its tab button, numbered from 1
  const tabIndex = tabs.length + 1;
  node.attributes["id"] = `tabpanel-${randomId}-${tabIndex}`;
  if (tabIndex !== 1) {
    node.attributes["hidden"] = "true";
  }
  node.attributes["aria-labelledby"] = `tab-${randomId}-${tabIndex}`;
  // build an array of tab labels, then strip the build-time marker attributes
  tabs.push({
    label: node.attributes["data-ac-tab-label"] || "",
    badgeLabel: node.attributes["data-ac-tab-badge"],
    icon: node.attributes["data-ac-tab-icon"] as SvgIconNameTypes,
  });
  delete node.attributes["data-ac-tab-label"];
  delete node.attributes["data-ac-tab-badge"];
  delete node.attributes["data-ac-tab-icon"];
  tabContents.push(await render(node));
}

if (tabs.length === 0) {
  throw new Error(
    "Tabs: expected at least one Tab as a direct child, but found none."
  );
}
---

<BaseWrapper
  as="div"
  class:list={twMerge("flex flex-col gap-4", classList)}
  data-ac-tablist-container
  {...attrs}
>
  <TabList {tabs} {randomId} {variant} />

  <TabPanels>
    {tabContents.map((content) => <Fragment set:html={content} />)}
  </TabPanels>
</BaseWrapper>

<script>
  const allTabsContainers = document.querySelectorAll<HTMLDivElement>(
    "[data-ac-tablist-container]"
  );

  allTabsContainers.forEach((tabsContainer) => {
    const tabList = tabsContainer.querySelector<HTMLDivElement>(
      ":scope > [role='tablist']"
    );
    const tabs = Array.from(
      tabList!.querySelectorAll<HTMLButtonElement>(":scope > [role='tab']")
    );
    const tabPanelsContainer = tabsContainer.querySelector<HTMLDivElement>(
      ":scope > [data-ac-tabpanels-container]"
    );
    const tabPanels = Array.from(
      tabPanelsContainer!.querySelectorAll<HTMLDivElement>(
        ":scope > [role='tabpanel']"
      )
    );

    tabList!.addEventListener("keydown", (e) => {
      const currentTab = e.target as HTMLButtonElement;
      const currentIndex = tabs.indexOf(currentTab);
      if (currentIndex === -1) return; // Exit if the focused element is not a tab
      let newIndex: number;

      switch (e.key) {
        case "ArrowRight":
          newIndex = (currentIndex + 1) % tabs.length;
          break;
        case "ArrowLeft":
          newIndex = (currentIndex - 1 + tabs.length) % tabs.length;
          break;
        case "Home":
          newIndex = 0;
          break;
        case "End":
          newIndex = tabs.length - 1;
          break;
        default:
          return; // Exit if the key is not recognized
      }

      e.preventDefault();
      e.stopPropagation();

      // roving tabindex: the focused tab is the only tab stop
      tabs.forEach((tab, index) => {
        tab.tabIndex = index === newIndex ? 0 : -1;
      });
      tabs[newIndex]!.focus();
    });

    const showTab = (targetTab: HTMLButtonElement) => {
      // Unselect other tabs and set this tab as selected
      for (const tab of tabs) {
        if (tab === targetTab) continue;
        tab.setAttribute("aria-selected", "false");
        tab.tabIndex = -1;
      }
      targetTab.setAttribute("aria-selected", "true");
      targetTab.tabIndex = 0;

      // Hide other tab panels and show the selected panel
      const targetTabPanel = document.getElementById(
        targetTab.getAttribute("aria-controls")!
      ) as HTMLDivElement;
      for (const panel of tabPanels) {
        if (panel === targetTabPanel) continue;
        panel.hidden = true;
      }
      targetTabPanel.hidden = false;
    };

    tabs.forEach((tab) => {
      // not e.target: a click on the label or badge targets the tab's inner span, not the button
      tab.addEventListener("click", () => {
        showTab(tab);
      });

      tab.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          e.stopPropagation();
          showTab(tab);
        }
      });
    });
  });
</script>
