---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import crypto from "node:crypto";
import type { OverlayTransitionType } from "../../types.js";

type Props = Omit<HTMLAttributes<"dialog" | "div">, "id"> & {
  as?: "dialog" | "div";
  id: string;
  // Classes for the actual top-layer/`position: fixed` element (the native
  // dialog/popover itself) - e.g. CSS anchor-positioning offsets. `class`
  // stays targeted at the content box (the inner div), same as before.
  overlayClass?: HTMLAttributes<"div">["class"];
  showBackdrop?: boolean;
  showBlur?: boolean;
  transition?: OverlayTransitionType;
};

const {
  as: Tag = "dialog",
  id,
  overlayClass,
  showBackdrop = true,
  showBlur = true,
  transition = "fade",
  class: classList,
  ...attrs
} = Astro.props;

const transitionClasses = {
  fade: "opacity-0 motion-safe:transition-[display,opacity,overlay] open:opacity-100 motion-safe:starting:open:opacity-0",
  "fade-scale":
    "opacity-0 scale-70 motion-safe:transition-[display,opacity,overlay,scale] open:opacity-100 open:scale-100 motion-safe:starting:open:opacity-0 motion-safe:starting:open:scale-70",
}[transition];

const randomId = crypto.randomUUID();
---

<Tag
  class:list={twMerge(
    "m-auto overscroll-contain bg-transparent",
    "motion-safe:ease-overlay motion-safe:transition-discrete motion-safe:duration-(--duration-overlay)",
    showBlur && "backdrop:backdrop-blur-xs",
    showBackdrop &&
      "backdrop:bg-black/30 backdrop:opacity-0 open:backdrop:opacity-100 motion-safe:starting:open:backdrop:opacity-0",
    showBackdrop &&
      "motion-safe:backdrop:ease-overlay motion-safe:backdrop:transition-[display,opacity,overlay] motion-safe:backdrop:transition-discrete motion-safe:backdrop:duration-(--duration-overlay)",
    transitionClasses,
    overlayClass
  )}
  {id}
  style={`--hfdev-anchorname-overlay: --anchorname-${randomId}-overlay`}
  {...attrs}
>
  <div
    class:list={["[anchor-name:var(--hfdev-anchorname-overlay)]", classList]}
  >
    <slot />
  </div>
</Tag>
