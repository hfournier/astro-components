---
import type { ComponentProps } from "astro/types";
import BaseMenuItem from "./BaseMenuItem.astro";

// A choice in a multi-select Menu (role menuitemcheckbox, as Compose's CheckableDropdownMenuItem).
// Choosing it toggles it and fires `change` on the menu, which stays open.
type Props = Omit<
  ComponentProps<typeof BaseMenuItem>,
  "role" | "href" | "isChecked" | "submenu"
> & {
  isChecked?: boolean;
};
const { isChecked = false, ...attrs } = Astro.props;
---

<BaseMenuItem role="menuitemcheckbox" isChecked={isChecked} {...attrs} />
