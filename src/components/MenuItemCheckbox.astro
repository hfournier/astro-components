---
import type { ComponentProps } from "astro/types";
import MenuItemBase from "./MenuItemBase.astro";

// A choice in a multi-select Menu (role menuitemcheckbox, as Compose's CheckableDropdownMenuItem).
// Choosing it toggles it and fires `change` on the menu, which stays open.
type Props = Omit<
  ComponentProps<typeof MenuItemBase>,
  "role" | "href" | "isChecked"
> & {
  isChecked?: boolean;
};
const { isChecked = false, ...attrs } = Astro.props;
---

<MenuItemBase role="menuitemcheckbox" isChecked={isChecked} {...attrs} />
