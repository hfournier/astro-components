---
import type { HTMLTag, Polymorphic } from "astro/types";
import { extendTailwindMerge } from "tailwind-merge";

// tailwind-merge's default config doesn't know the --text-control* role tokens (global.css)
// are a font-size scale, not a color: left as plain `text-*` classes, it lumps them into the
// same ambiguous group as the text-color utilities below (text-on-control, text-primary-control)
// and silently drops whichever comes first, regardless of the two being independent axes.
// Registering them under the "font-size" class group keeps both.
const twMerge = extendTailwindMerge({
  extend: {
    classGroups: {
      "font-size": ["text-control", "text-control-sm", "text-control-lg"],
    },
  },
});

// Astro's own polymorphic-component helper. Verified with a cleared `.astro` cache
// (`rm -rf .astro && astro sync`), repeatedly, both internally and for every external consumer
// (DialogConfirm's `command`/`commandfor`, SkipToContent's `as="a"` + `href`) - it correctly
// rejects `href` on the default button branch, `command`/`commandfor` on `as="a"`, and invalid
// prop values, while accepting everything valid on both branches.
type Props<Tag extends Extract<HTMLTag, "a" | "button"> = "button"> =
  Polymorphic<{
    as: Tag;
    variant?: "solid" | "outline";
    color?: "primary" | "secondary";
    size?: "sm" | "md" | "lg";
  }>;

// Two-read `Astro.props`, per Astro's own documented pattern for polymorphic components: the
// first read grabs `as` untyped so it keeps behaving as the real `"button" | "a"` union for
// branching below. Typed straight off the single `: Props` read instead, `Tag` narrows to the
// literal `"button"` (Props' default) - which compiles fine today but hard-errors (ts(2367),
// "types have no overlap") the moment any future logic needs to check `Tag === "a"`.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { as: Tag = "button" }: any = Astro.props;
const {
  // Destructured only to keep it out of `attrs` below (Polymorphic's `Props` keeps `as` as a
  // real field) - already captured, untyped, as `Tag` above; re-declaring it here would collide
  // with that const. Left un-cast: casting `attrs`'s type doesn't remove the key at runtime,
  // and `as` is always genuinely present whenever a consumer passes it (e.g. SkipToContent's
  // `as="a"`), so it would otherwise render as a literal `as="a"` attribute on the real element.
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  as: _as,
  variant = "solid",
  color = "primary",
  size = "md",
  class: classList,
  type,
  ...attrs
}: Props = Astro.props;

// `type="button"` only makes sense - and only defaults - on a real <button>; an <a>'s `type`
// attribute (rarely used) is a MIME-type hint, not a click-behavior enum, so it's left alone.
const resolvedType = Tag === "button" ? (type ?? "button") : type;

const sizeClasses = {
  sm: "text-control-sm",
  md: "text-control",
  lg: "text-control-lg",
}[size];

const buttonClasses = {
  solid: {
    primary:
      "bg-primary-control border-primary-control hover:bg-primary-control-hover hover:border-primary-control-hover border-(length:--border-width-boundary) text-on-control",
    secondary:
      "bg-secondary-control border-secondary-control hover:bg-secondary-control-hover hover:border-secondary-control-hover border-(length:--border-width-boundary) text-on-control",
  }[color],
  outline: {
    primary:
      "text-primary-control border-(length:--border-width-boundary) border-primary-control hover:bg-primary-control-hover hover:text-on-control hover:border-primary-control-hover bg-transparent",
    secondary:
      "text-secondary-control border-(length:--border-width-boundary) border-secondary-control hover:bg-secondary-control-hover hover:text-on-control hover:border-secondary-control-hover bg-transparent",
  }[color],
}[variant];
---

<Tag
  class:list={twMerge(
    "rounded-control font-control cursor-pointer px-[1em] py-[0.5em] motion-safe:transition-colors",
    "focus-visible:outline-focus-ring focus-visible:outline-(length:--focus-ring-width) focus-visible:outline-offset-(--focus-ring-offset)",
    sizeClasses,
    buttonClasses,
    classList
  )}
  type={resolvedType}
  {...attrs}
>
  <slot />
</Tag>
