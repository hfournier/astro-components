---
import type { HTMLAttributes } from "astro/types";
import { extendTailwindMerge } from "tailwind-merge";

// tailwind-merge's default config doesn't know the --text-control* role tokens (global.css)
// are a font-size scale, not a color: left as plain `text-*` classes, it lumps them into the
// same ambiguous group as the text-color utilities below (text-white, text-primary-control)
// and silently drops whichever comes first, regardless of the two being independent axes.
// Registering them under the "font-size" class group keeps both.
const twMerge = extendTailwindMerge({
  extend: {
    classGroups: {
      "font-size": ["text-control", "text-control-sm", "text-control-lg"],
    },
  },
});

type Props = HTMLAttributes<"button"> & {
  variant?: "solid" | "outline";
  color?: "primary" | "secondary";
  size?: "sm" | "md" | "lg";
};
const {
  variant = "solid",
  color = "primary",
  size = "md",
  class: classList,
  type = "button",
  ...attrs
} = Astro.props;

const sizeClasses = {
  sm: "text-control-sm",
  md: "text-control",
  lg: "text-control-lg",
}[size];

const buttonClasses = {
  solid: {
    primary:
      "bg-primary-control border-primary-control hover:bg-primary-control-hover hover:border-primary-control-hover border-(length:--border-width-boundary) text-white",
    secondary:
      "bg-secondary-control border-secondary-control hover:bg-secondary-control-hover hover:border-secondary-control-hover border-(length:--border-width-boundary) text-white",
  }[color],
  outline: {
    primary:
      "text-primary-control border-(length:--border-width-boundary) border-primary-control hover:bg-primary-control-hover hover:text-white hover:border-primary-control-hover bg-transparent",
    secondary:
      "text-secondary-control border-(length:--border-width-boundary) border-secondary-control hover:bg-secondary-control-hover hover:text-white hover:border-secondary-control-hover bg-transparent",
  }[color],
}[variant];
---

<button
  class:list={twMerge(
    "rounded-control font-control cursor-pointer px-[1em] py-[0.5em] motion-safe:transition-colors",
    "focus-visible:outline-focus-ring focus-visible:outline-(length:--focus-ring-width) focus-visible:outline-offset-(--focus-ring-offset)",
    sizeClasses,
    buttonClasses,
    classList
  )}
  {type}
  {...attrs}
>
  <slot />
</button>
