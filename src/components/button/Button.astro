---
import type { HTMLTag, Polymorphic } from "astro/types";
import { twMerge } from "tailwind-merge";

// Astro's own polymorphic-component helper. Verified with a cleared `.astro` cache
// (`rm -rf .astro && astro sync`), repeatedly, both internally and for every external consumer
// (DialogConfirm's `command`/`commandfor`, SkipToContent's `as="a"` + `href`) - it correctly
// rejects `href` on the default button branch, `command`/`commandfor` on `as="a"`, and invalid
// prop values, while accepting everything valid on both branches.
type Props<Tag extends Extract<HTMLTag, "a" | "button"> = "button"> =
  Polymorphic<{
    as: Tag;
    variant?: "elevated" | "filled" | "outlined" | "text" | "tonal";
    showFullwidth?: boolean;
    shape?: "round" | "square";
    size?: "sm" | "md" | "lg";
  }>;

// Two-read `Astro.props`, per Astro's own documented pattern for polymorphic components: the
// first read grabs `as` untyped so it keeps behaving as the real `"button" | "a"` union for
// branching below. Typed straight off the single `: Props` read instead, `Tag` narrows to the
// literal `"button"` (Props' default) - which compiles fine today but hard-errors (ts(2367),
// "types have no overlap") the moment any future logic needs to check `Tag === "a"`.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { as: Tag = "button" }: any = Astro.props;
const {
  // Destructured only to keep it out of `attrs` below (Polymorphic's `Props` keeps `as` as a
  // real field) - already captured, untyped, as `Tag` above; re-declaring it here would collide
  // with that const. Left un-cast: casting `attrs`'s type doesn't remove the key at runtime,
  // and `as` is always genuinely present whenever a consumer passes it (e.g. SkipToContent's
  // `as="a"`), so it would otherwise render as a literal `as="a"` attribute on the real element.
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  as: _as,
  variant = "filled",
  showFullwidth = false,
  shape = "round",
  size = "md",
  class: classList,
  type,
  ...attrs
}: Props = Astro.props;

// `type="button"` only makes sense - and only defaults - on a real <button>; an <a>'s `type`
// attribute (rarely used) is a MIME-type hint, not a click-behavior enum, so it's left alone.
const resolvedType = Tag === "button" ? (type ?? "button") : type;

// Size sets the height, padding and label type. M3 picks the label style by height
// (ButtonDefaults.textStyleFor): Label Large below 56px, Title Medium at 56px (M3's Medium).
// Both are weight 500, set below.
const labelLarge = "text-sm leading-5 tracking-[0.1px]";
const titleMedium = "text-base leading-6 tracking-[0.2px]";
const sizeClasses = {
  sm: `${labelLarge} min-h-10 px-4 after:inset-x-0 after:-inset-y-1.25 after:absolute`,
  md: `${labelLarge} min-h-12 px-5`,
  lg: `${titleMedium} min-h-14 px-6`,
}[size];

// M3 disabled: label on-surface at 38%, any container (and outline) on-surface at 10%.
const disabledContainer =
  "disabled:bg-(--theme-color-on-surface)/10 disabled:border-transparent";

const variantClasses = {
  elevated: `bg-(--theme-color-surface-container-low) border-(--theme-color-surface-container-low) text-(--theme-color-primary) shadow-theme-elevation-1 not-disabled:hover:shadow-theme-elevation-2 disabled:shadow-none ${disabledContainer}`,
  filled: `bg-(--theme-color-primary) border-(--theme-color-primary) text-(--theme-color-on-primary) ${disabledContainer}`,
  outlined:
    "bg-transparent border-(--theme-color-outline-variant) text-(--theme-color-on-surface-variant) disabled:border-(--theme-color-on-surface)/10",
  text: "bg-transparent border-transparent text-(--theme-color-primary)",
  tonal: `bg-(--theme-color-secondary-container) border-(--theme-color-secondary-container) text-(--theme-color-on-secondary-container) ${disabledContainer}`,
}[variant];

const shapeClasses = {
  round: "rounded-full",
  square: {
    sm: "rounded-xl",
    md: "rounded-[14px]",
    lg: "rounded-2xl",
  }[size],
}[shape];
---

<Tag
  class:list={twMerge(
    "flex cursor-pointer items-center justify-center gap-2 border font-medium",
    "relative isolate before:absolute before:-inset-px before:-z-10 before:rounded-[inherit] before:bg-current before:opacity-0 motion-safe:before:transition-opacity",
    "not-disabled:hover:before:opacity-8 not-disabled:focus-visible:before:opacity-10 not-disabled:active:before:opacity-10",
    "disabled:cursor-default disabled:text-(--theme-color-on-surface)/38",
    "motion-safe:transition",
    "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-offset-2 focus-visible:ring-offset-(--theme-color-wrapper-bg)",
    showFullwidth ? "min-w-full" : "max-w-fit",
    variantClasses,
    shapeClasses,
    sizeClasses,
    classList
  )}
  type={resolvedType}
  {...attrs}
>
  <slot />
</Tag>
