---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

type Props = HTMLAttributes<"button"> & {
  variant?: "solid" | "outline";
  color?: "primary" | "secondary";
};
const {
  variant = "solid",
  color = "primary",
  class: classList,
  type = "button",
  ...attrs
} = Astro.props;

const buttonClasses = {
  solid: {
    primary:
      "bg-primary-800 border-primary-800 hover:bg-primary-700 hover:border-primary-700 border-(length:--border-width-boundary) text-white",
    secondary:
      "bg-secondary-700 border-secondary-700 hover:bg-secondary-600 hover:border-secondary-600 border-(length:--border-width-boundary) text-white",
  }[color],
  outline: {
    primary:
      "text-primary-800 border-(length:--border-width-boundary) border-primary-800 hover:bg-primary-700 hover:text-white hover:border-primary-700 bg-transparent",
    secondary:
      "text-secondary-700 border-(length:--border-width-boundary) border-secondary-700 hover:bg-secondary-600 hover:text-white hover:border-secondary-600 bg-transparent",
  }[color],
}[variant];
---

<button
  class:list={twMerge(
    "rounded-control font-control cursor-pointer px-4 py-2 text-(length:--font-size-control) motion-safe:transition-colors",
    "focus-visible:outline-focus-ring focus-visible:outline-(length:--focus-ring-width) focus-visible:outline-offset-(--focus-ring-offset)",
    buttonClasses,
    classList
  )}
  {type}
  {...attrs}
>
  <slot />
</button>
