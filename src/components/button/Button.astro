---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button"> & {
  variant?: "solid" | "outline";
  colors?: "primary" | "secondary";
};
const {
  variant = "solid",
  colors = "primary",
  class: classList,
  type = "button",
  ...attrs
} = Astro.props;

const buttonClasses = {
  solid: {
    primary:
      "bg-primary-600 border-primary-600 hover:bg-primary-500 hover:border-primary-500 border-2 text-white",
    secondary:
      "bg-secondary-600 border-secondary-600 hover:bg-secondary-500 hover:border-secondary-500 border-2 text-white",
  }[colors],
  outline: {
    primary:
      "text-primary-600 border-primary-600 hover:bg-primary-500 hover:text-white hover:border-primary-500 border-2 bg-transparent",
    secondary:
      "text-secondary-600 border-secondary-600 hover:bg-secondary-500 hover:text-white hover:border-secondary-500 border-2 bg-transparent",
  }[colors],
}[variant];
---

<button
  class:list={[
    "cursor-pointer rounded px-4 py-2 font-medium motion-safe:transition-colors",
    buttonClasses,
    classList,
  ]}
  {type}
  {...attrs}
>
  <slot />
</button>
