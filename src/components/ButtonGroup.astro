---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

// M3 Expressive's button groups: invisible containers with no color or size of their own; each
// button sets its own. Name one, if it needs a name, with `aria-label` or `aria-labelledby`.
// - standard spaces its buttons and icon buttons, and widens a pressed one while its neighbours
//   narrow
// - connected joins toggle buttons 2px apart, with small inner corners, into one selection
type Props = HTMLAttributes<"div"> & {
  variant?: "standard" | "connected";
  // A connected group's selection: one button at a time, each a radio, or any number of toggle
  // buttons. Defaults to single.
  selection?: "single" | "multi";
  // A connected group's last selected button can't be unselected
  isSelectionRequired?: boolean;
};

const {
  variant = "standard",
  selection: selectionProp,
  isSelectionRequired = false,
  class: classList,
  ...attrs
}: Props = Astro.props;

// Values outside these fail the build, rather than drawing something other than was asked for
// (ADR-0021)
if (!["standard", "connected"].includes(variant)) {
  throw new Error(
    `ButtonGroup: M3's button groups are "standard" and "connected", but this one's \`variant\` is "${variant}".`
  );
}
if (
  selectionProp !== undefined &&
  !["single", "multi"].includes(selectionProp)
) {
  throw new Error(
    `ButtonGroup: M3's selections are "single" and "multi", but this one's \`selection\` is "${selectionProp}".`
  );
}
const isConnected = variant === "connected";
if (!isConnected && (selectionProp !== undefined || isSelectionRequired)) {
  throw new Error(
    `ButtonGroup: only M3's connected button groups have a selection, but this one's \`variant\` is "standard".`
  );
}
const selection = isConnected ? (selectionProp ?? "single") : undefined;

// A connected group's buttons, counted in the rendered slot by the marker on each Button's and
// ButtonIcon's opening tag. Its selection is the group's: each button's own toggle marker comes
// off, so only the script below flips it, and in a single-select group each becomes a radio.
let items = "";
if (isConnected) {
  const rendered = await Astro.slots.render("default");
  const buttonCount = rendered.match(/\sdata-ac-button-size=/g)?.length ?? 0;
  const toggleCount =
    rendered.match(/\saria-pressed="(true|false)"/g)?.length ?? 0;
  const selectedCount = rendered.match(/\saria-pressed="true"/g)?.length ?? 0;
  // M3: connected groups are for selection, so each button is a toggle
  const plainCount = buttonCount - toggleCount;
  if (plainCount > 0) {
    throw new Error(
      `ButtonGroup: M3's connected button groups hold toggle buttons (isToggle), but ${plainCount} of this one's ${plainCount === 1 ? "isn't" : "aren't"}.`
    );
  }
  if (selection === "single" && selectedCount > 1) {
    throw new Error(
      `ButtonGroup: a single-select group has at most one button selected, but this one has ${selectedCount}.`
    );
  }
  if (isSelectionRequired && selectedCount === 0) {
    throw new Error(
      `ButtonGroup: a group whose selection is required starts with a button selected, but this one has none.`
    );
  }
  items = rendered.replace(
    /\sdata-ac-(button-toggle(="")?|icon-toggle="aria-pressed")(?=[\s>])/g,
    ""
  );
  if (selection === "single") {
    items = items.replace(
      /\saria-pressed="(true|false)"/g,
      ' role="radio" aria-checked="$1"'
    );
  }
}
---

{isConnected ? (
  <div
    class:list={twMerge("flex w-full items-center gap-0.5", classList)}
    role={selection === "single" ? "radiogroup" : "group"}
    data-ac-button-group="connected"
    data-ac-button-group-selection={selection}
    data-ac-button-group-required={isSelectionRequired ? "" : undefined}
    {...attrs}
  >
    <Fragment set:html={items} />
  </div>
) : (
  /* M3's space between buttons follows their size: 18px for extra small, 12px for small and 8px
     for the rest. With mixed sizes it keeps the smallest one's, so each keeps its 48px target. */
  <div
    class:list={twMerge(
      "flex w-fit items-center gap-2",
      "has-[>[data-ac-button-size=sm]]:not-has-[>[data-ac-button-size=xs]]:gap-3",
      "has-[>[data-ac-button-size=xs]]:gap-4.5",
      classList
    )}
    role="group"
    data-ac-button-group="standard"
    {...attrs}
  >
    <slot />
  </div>
)}

<style>
  /* M3's connected group. Unlayered, so it wins over the corners each Button and ButtonIcon set
     with their own utilities. Per their size: a round button's full corners (half its height, in
     px as Button's own are, so they animate), and the inner corners at rest and pressed. */
  [data-ac-button-group="connected"] > :global(*) {
    --ac-connected-full: 20px;
    --ac-connected-inner: 8px;
    --ac-connected-pressed: 4px;
    /* an outer corner: full on a round button, the inner corner's size on a square one */
    --ac-connected-outer: var(--ac-connected-inner);
    --ac-connected-corner: var(--ac-connected-inner);
    --ac-connected-start: var(--ac-connected-corner);
    --ac-connected-end: var(--ac-connected-corner);
    border-start-start-radius: var(--ac-connected-start);
    border-end-start-radius: var(--ac-connected-start);
    border-start-end-radius: var(--ac-connected-end);
    border-end-end-radius: var(--ac-connected-end);
    /* M3: the group spans its surface, its buttons sharing the width, each at least 48px wide */
    flex: 1 0 3rem;
    max-width: none;
  }
  [data-ac-button-group="connected"] > :global([data-ac-button-size="xs"]) {
    --ac-connected-full: 16px;
  }
  [data-ac-button-group="connected"] > :global([data-ac-button-size="md"]) {
    --ac-connected-full: 28px;
  }
  [data-ac-button-group="connected"] > :global([data-ac-button-size="lg"]) {
    --ac-connected-full: 48px;
    --ac-connected-inner: 16px;
    --ac-connected-pressed: 12px;
  }
  [data-ac-button-group="connected"] > :global([data-ac-button-size="xl"]) {
    --ac-connected-full: 68px;
    --ac-connected-inner: 20px;
    --ac-connected-pressed: 16px;
  }
  [data-ac-button-group="connected"] > :global([data-ac-button-shape="round"]) {
    --ac-connected-outer: var(--ac-connected-full);
  }
  /* The first and last buttons' outer sides, less any script Astro puts beside them */
  [data-ac-button-group="connected"]
    > :global(:nth-child(1 of :not(script, style, template))) {
    --ac-connected-start: var(--ac-connected-outer);
  }
  [data-ac-button-group="connected"]
    > :global(:nth-last-child(1 of :not(script, style, template))) {
    --ac-connected-end: var(--ac-connected-outer);
  }
  /* M3: selected, every corner is full. Pressed, which wins, the inner ones narrow. */
  [data-ac-button-group="connected"]
    > :global(:is([aria-pressed="true"], [aria-checked="true"])) {
    --ac-connected-outer: var(--ac-connected-full);
    --ac-connected-corner: var(--ac-connected-full);
  }
  [data-ac-button-group="connected"] > :global(:active:not(:disabled)) {
    --ac-connected-corner: var(--ac-connected-pressed);
  }
</style>

<script>
  // Compose's standard button group: a pressed button grows by 15% of its width, taking it from
  // its neighbours, so the group's width doesn't change. A middle button takes half from each
  // side, an end button all of it from its one neighbour. Each neighbour gives up no more than
  // the space beside its content, as Compose's compressionLimit (its button's trailing padding)
  // means it to, so its icon and label stay inside it. The widths move on M3's fast spatial
  // spring, as Compose's do.
  const expandedRatio = 0.15;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  // A group's buttons: its children, less any script Astro puts beside them
  const notScript = ":not(script, style, template)";
  const itemSelector = `[data-ac-button-group] > ${notScript}`;
  const itemsOf = (group: Element) => [
    ...group.querySelectorAll<HTMLElement>(`:scope > ${notScript}`),
  ];
  // The group's button an event happened on or in, if any
  const groupItemOf = (event: Event) =>
    (event.target as Element).closest<HTMLElement>(itemSelector);

  // A group's widths at rest, the space beside each one's content, the animations moving it away
  // from them, and, while a button is pressed, that button with its width at rest and widened
  type GroupState = {
    natural: number[];
    limits: number[];
    animations: Animation[];
    pressed?: { item: HTMLElement; rest: number; widened: number };
  };
  const states = new WeakMap<Element, GroupState>();

  const widthsOf = (items: Element[]) =>
    items.map((item) => item.getBoundingClientRect().width);

  // How narrow each item can get before its content, its icons and label but nothing
  // out of flow, such as a tooltip, reaches its edge: the smaller space either side of it
  const limitsOf = (items: Element[]) =>
    items.map((item) => {
      const rect = item.getBoundingClientRect();
      const content = [...item.childNodes]
        .filter(
          (node) =>
            !(
              node instanceof Element &&
              ["absolute", "fixed"].includes(getComputedStyle(node).position)
            )
        )
        .flatMap((node) => {
          const range = document.createRange();
          range.selectNode(node);
          return [...range.getClientRects()].filter((r) => r.width > 0);
        });
      if (!content.length) return rect.width;
      const start = Math.min(...content.map((r) => r.left));
      const end = Math.max(...content.map((r) => r.right));
      return Math.max(0, Math.min(start - rect.left, rect.right - end));
    });

  // Animates each item from its current width to `to`, holding it there
  const animate = (items: HTMLElement[], from: number[], to: number[]) => {
    const root = getComputedStyle(document.documentElement);
    const timing: KeyframeAnimationOptions = {
      duration: parseFloat(
        root.getPropertyValue("--theme-duration-spring-fast-spatial")
      ),
      easing: root.getPropertyValue("--ease-spring-fast-spatial").trim(),
      fill: "forwards",
    };
    return items.flatMap((item, i) =>
      from[i] === to[i]
        ? []
        : // a Button is at most as wide as its content, so the cap lifts while it moves
          item.animate(
            [
              { width: `${from[i]}px`, maxWidth: "none" },
              { width: `${to[i]}px`, maxWidth: "none" },
            ],
            timing
          )
    );
  };

  // M3: a connected group's pressed button only changes shape, so only a standard group widens one
  const press = (item: HTMLElement) => {
    const group = item.parentElement!;
    const items = itemsOf(group);
    if (
      group.matches("[data-ac-button-group=connected]") ||
      reducedMotion.matches ||
      item.matches(":disabled") ||
      items.length < 2
    )
      return;
    const state = states.get(group);
    const natural = state?.natural ?? widthsOf(items);
    const limits = state?.limits ?? limitsOf(items);
    const current = widthsOf(items);
    state?.animations.forEach((animation) => animation.cancel());

    const index = items.indexOf(item);
    const target = [...natural];
    const neighbours =
      index === 0
        ? [1]
        : index === items.length - 1
          ? [index - 1]
          : [index - 1, index + 1];
    // a middle button's 15% splits evenly between its two neighbours, so it grows from its center
    const share = Math.floor(
      Math.min(
        (expandedRatio * natural[index]) / neighbours.length,
        ...neighbours.map((neighbour) => limits[neighbour])
      )
    );
    if (share <= 0) return;
    for (const neighbour of neighbours) {
      target[neighbour] -= share;
      target[index] += share;
    }
    states.set(group, {
      natural,
      limits,
      animations: animate(items, current, target),
      pressed: { item, rest: natural[index], widened: target[index] },
    });
  };

  // Compose waits until the widening is 75% done before springing back, so a quick tap still
  // shows it
  const release = (group: Element) => {
    const state = states.get(group);
    if (!state?.pressed) return;
    const { item, rest, widened } = state.pressed;
    const items = itemsOf(group);
    const restore = () => {
      if (states.get(group) !== state) return;
      const animations = animate(items, widthsOf(items), state.natural);
      const next = {
        natural: state.natural,
        limits: state.limits,
        animations,
      };
      states.set(group, next);
      Promise.all(animations.map((animation) => animation.finished)).then(
        () => {
          if (states.get(group) !== next) return;
          animations.forEach((animation) => animation.cancel());
          states.delete(group);
        },
        () => undefined
      );
    };
    const restoreOnceWidened = () => {
      if (states.get(group) !== state) return;
      const width = item.getBoundingClientRect().width;
      if ((width - rest) / (widened - rest) >= 0.75) restore();
      else requestAnimationFrame(restoreOnceWidened);
    };
    restoreOnceWidened();
  };

  // Pressing with a pointer, or holding Space or Enter on a focused button, as Compose's press
  // interactions do
  document.addEventListener("pointerdown", (event) => {
    if (!event.isPrimary || event.button !== 0) return;
    const item = groupItemOf(event);
    if (!item) return;
    press(item);
    const group = item.parentElement!;
    const end = () => {
      release(group);
      document.removeEventListener("pointerup", end);
      document.removeEventListener("pointercancel", end);
    };
    document.addEventListener("pointerup", end);
    document.addEventListener("pointercancel", end);
  });

  // A connected group's selection, on each click (keyboard activation fires click too): a radio
  // checks and unchecks the others, a toggle button flips. With selection required, the last
  // selected button stays selected.
  document.addEventListener("click", (event) => {
    const item = groupItemOf(event);
    const group = item?.parentElement;
    const selection = group?.dataset.acButtonGroupSelection;
    if (!item || !group || !selection || item.matches(":disabled")) return;
    const attribute = selection === "single" ? "aria-checked" : "aria-pressed";
    const isOn = item.getAttribute(attribute) === "true";
    const selected = itemsOf(group).filter(
      (other) => other.getAttribute(attribute) === "true"
    );
    if (
      isOn &&
      "acButtonGroupRequired" in group.dataset &&
      selected.length === 1
    )
      return;
    if (selection === "single" && !isOn)
      selected.forEach((other) => other.setAttribute(attribute, "false"));
    item.setAttribute(attribute, String(!isOn));
  });

  // The button held down with Space or Enter, if any
  let keyPressed: HTMLElement | null = null;
  document.addEventListener("keydown", (event) => {
    const item = groupItemOf(event);
    if (!item) return;
    if ((event.key === " " || event.key === "Enter") && !event.repeat) {
      press(item);
      keyPressed = item;
      return;
    }
    // M3's Accessibility page: the arrow keys move between the group's buttons, as Tab does,
    // mirrored right to left. They stop at the ends and skip disabled buttons.
    if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
    const group = item.parentElement!;
    const isRtl = getComputedStyle(group).direction === "rtl";
    const step = (event.key === "ArrowRight") !== isRtl ? 1 : -1;
    const items = itemsOf(group);
    for (
      let i = items.indexOf(item) + step;
      i >= 0 && i < items.length;
      i += step
    ) {
      if (items[i].matches(":disabled")) continue;
      event.preventDefault();
      items[i].focus();
      return;
    }
  });

  const endKeyPress = () => {
    if (!keyPressed) return;
    release(keyPressed.parentElement!);
    keyPressed = null;
  };
  document.addEventListener("keyup", (event) => {
    if (event.key === " " || event.key === "Enter") endKeyPress();
  });
  // A key let go elsewhere, as when Enter opens a dialog or Tab moves on, still ends the press
  // once focus leaves the button. Only a key press: WebKit blurs a button a pointer presses.
  document.addEventListener("focusout", (event) => {
    if (event.target === keyPressed) endKeyPress();
  });
</script>
