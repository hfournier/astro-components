---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { SvgIconNameTypes } from "../svgs";
import Icon from "./Icon.astro";
import { isCurrentPath } from "../utils";

// An M3 navigation drawer item: a full-width 56px row with an optional icon and a Label Large
// label, used for NavRailSubItems in a NavDrawer or an expanded NavRail. Unlike NavRailItem,
// which M3 requires to have an icon, the icon is optional.
type Props = HTMLAttributes<"a"> & {
  icon?: SvgIconNameTypes;
  label: string;
};
const { icon, label, href, class: classList, ...attrs } = Astro.props;

// The current page's destination is its own href, or a page under it (see isCurrentPath). An
// explicit `aria-current` passed by the consumer still wins, since `attrs` is spread after it.
const isCurrent = isCurrentPath(Astro.url.pathname, href);
---

<a
  class:list={twMerge(
    // M3 drawer item: the full width (the drawer's 12px padding either side), 56px high, fully
    // rounded, 16px either side of its content (28px from the drawer's edges), 12px between the
    // icon and Label Large
    "relative isolate flex h-14 w-full items-center gap-3 rounded-full px-4 text-sm leading-5 font-medium tracking-[0.1px]",
    // inactive: on-surface-variant, on-surface while hovered, focused or pressed
    "text-(--theme-color-on-surface-variant) not-aria-[current=page]:hover:text-(--theme-color-on-surface) not-aria-[current=page]:focus-visible:text-(--theme-color-on-surface) not-aria-[current=page]:active:text-(--theme-color-on-surface)",
    // current page: the active indicator
    "aria-[current=page]:bg-(--theme-color-secondary-container) aria-[current=page]:text-(--theme-color-on-secondary-container)",
    // M3 state layer, in the content color
    "before:absolute before:inset-0 before:-z-10 before:rounded-full before:bg-current before:opacity-0",
    "hover:before:opacity-8 focus-visible:before:opacity-10 active:before:opacity-10",
    "motion-safe:transition-colors motion-safe:duration-(--theme-duration-feedback) motion-safe:before:transition-opacity",
    "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-offset-2 focus-visible:ring-offset-(--theme-color-wrapper-bg)",
    classList
  )}
  href={href}
  aria-current={isCurrent ? "page" : undefined}
  {...attrs}
>
  {icon && <Icon class="shrink-0" name={icon} />}
  <span class="min-w-0 truncate">{label}</span>
</a>
