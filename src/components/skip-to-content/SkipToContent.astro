---
import type { ComponentProps } from "astro/types";
import Button from "../button/Button.astro";

// Composes Button (as="a") for its styling, including the color-contrast fix Button already
// owns (#44/#45), rather than duplicating its class list and twMerge workaround (#46). Only the
// off-screen-until-focused positioning below is SkipToContent's own concern.
type Props = ComponentProps<typeof Button<"a">>;
const { href, size = "sm", class: classList, ...attrs }: Props = Astro.props;
---

<Button
  as="a"
  class:list={["absolute -top-250 left-1 z-100 focus:top-1", classList]}
  {size}
  href={href || "#main-content"}
  {...attrs}
>
  Skip to content
</Button>
