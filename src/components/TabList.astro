---
import { twMerge } from "tailwind-merge";
import type { TabType, TabVariantType } from "../types";
import Badge from "./Badge.astro";
import Icon from "./Icon.astro";

type Props = {
  randomId: string;
  tabs: TabType[];
  variant: TabVariantType;
};

const { randomId, tabs, variant } = Astro.props;
---

<div
  class="relative grid auto-cols-fr grid-flow-col border-b border-(--theme-color-outline-variant) bg-(--theme-color-surface)"
  role="tablist"
  style={`--ac-anchorname-tab-selected: --anchorname-${randomId}-tab-selected;`}
>
  {
    tabs.map((tab, index) => {
      const hasBadge = tab.badgeLabel !== undefined;
      // M3: a primary tab's badge overlaps its icon; otherwise it sits inline after the label
      const badgeOnIcon = hasBadge && variant === "primary" && tab.icon;
      const badgeAnchorName = `--anchorname-${randomId}-badge-${index + 1}`;

      return (
        <button
          class:list={twMerge(
            "group/tab relative isolate flex min-h-12 cursor-pointer items-center justify-center px-4 select-none",
            "text-sm leading-5 font-medium tracking-[0.1px] text-(--theme-color-on-surface-variant) not-aria-selected:hover:text-(--theme-color-on-surface) not-aria-selected:focus-visible:text-(--theme-color-on-surface) not-aria-selected:active:text-(--theme-color-on-surface)",
            variant === "primary"
              ? "aria-selected:text-(--theme-color-primary)"
              : "aria-selected:text-(--theme-color-on-surface) aria-selected:[anchor-name:var(--ac-anchorname-tab-selected)]",
            // M3 state layer, drawn in the label color (primary on a selected primary tab, on-surface otherwise)
            "before:absolute before:inset-0 before:-z-10 before:bg-current before:opacity-0 hover:before:opacity-8 focus-visible:before:opacity-10 active:before:opacity-10",
            // M3 focus ring: rounded like Button's md square shape, and drawn on ::after so, on the selected tab, it can stop
            // 1px above the indicator (3px primary, 2px secondary) instead of overlapping it
            "outline-none after:pointer-events-none after:absolute after:inset-x-0 after:top-0 after:rounded-[14px] focus-visible:after:ring-3 focus-visible:after:ring-(--theme-color-focus-ring-on-bg) focus-visible:after:ring-inset",
            "after:bottom-0",
            variant === "primary"
              ? "aria-selected:after:bottom-1"
              : "aria-selected:after:bottom-0.75",
            "aria-selected:cursor-default motion-safe:transition-colors motion-safe:duration-(--theme-duration-feedback) motion-safe:before:transition-opacity"
          )}
          id={`tab-${randomId}-${index + 1}`}
          type="button"
          role="tab"
          aria-label={
            // the badge is aria-hidden, so its count joins the tab's name (Badge hides "0")
            tab.badgeLabel && tab.badgeLabel !== "0"
              ? `${tab.label}, ${tab.badgeLabel}`
              : undefined
          }
          aria-selected={index === 0}
          aria-controls={`tabpanel-${randomId}-${index + 1}`}
          tabindex={index === 0 ? "0" : "-1"}
          data-ac-tab-button
        >
          {/* The content span is the primary indicator's anchor, so the indicator matches the
              content's width rather than the tab's. */}
          <span
            class:list={[
              "flex items-center",
              variant === "primary" &&
                "group-aria-selected/tab:[anchor-name:var(--ac-anchorname-tab-selected)]",
              variant === "primary" && tab.icon
                ? "min-h-16 flex-col justify-center gap-0.5"
                : "gap-2",
            ]}
          >
            {tab.icon && (
              <Icon
                class="pointer-events-none"
                name={tab.icon}
                style={
                  badgeOnIcon ? `anchor-name: ${badgeAnchorName}` : undefined
                }
              />
            )}
            {hasBadge && !badgeOnIcon ? (
              // inline text flow, so the badge aligns to the label's baseline and cap height (see Badge)
              <span>
                {tab.label}
                <Badge class="ms-1" label={tab.badgeLabel} placement="inline" />
              </span>
            ) : (
              tab.label
            )}
          </span>
          {badgeOnIcon && (
            <Badge
              label={tab.badgeLabel}
              style={`--ac-anchorname-badge: ${badgeAnchorName}`}
            />
          )}
        </button>
      );
    })
  }

  <div
    class:list={[
      "pointer-events-none absolute bottom-0",
      "right-[anchor(right)] left-[anchor(left)] [position-anchor:var(--ac-anchorname-tab-selected)]",
      variant === "primary" ? "h-0.75 min-w-6 rounded-t-full" : "h-0.5",
      "bg-(--theme-color-primary)",
      "motion-safe:transition-[left,right] motion-safe:duration-(--theme-duration-overlay)",
    ]}
    data-ac-tab-indicator
  >
  </div>
</div>
