---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { SvgIconNameTypes } from "../svgs";
import type { SliderHandlePropsType } from "../types";
import { sliderPlaces, snapSliderValue } from "../utils";
import Icon from "./Icon.astro";

// M3 Expressive's sliders on native <input type="range">s, so they submit, reset and validate with
// their form, and assistive tech announces each as a slider with its value. M3's variants:
// standard fills from the start, centered from the middle, and range has two handles, each its
// own input, the active track between them. Every attribute but `class` goes on the input
// (`name`, `min`, `max`, `step`, `value`, `disabled`, `aria-*`), and `class` on the element around
// it, which draws M3's track, handles, stops, icon and value indicator. A range slider's shared
// attributes (`min`, `max`, `step`, `disabled`, `form`) go on both inputs, and each handle's own in
// `handleStart` and `handleEnd`. Name each input with `aria-label`, `aria-labelledby` or a
// `<label for>`.
type Props = Omit<HTMLAttributes<"input">, "type"> & {
  variant?: "standard" | "centered" | "range";
  // M3's sizes, each a track thickness: 16, 24, 40, 56 and 96px
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  orientation?: "horizontal" | "vertical";
  // M3's stops configuration: a stop indicator at every `step`, which the handle snaps to
  showStops?: boolean;
  // The stop indicator at the end of each inactive track, which keeps its end at 3:1 contrast
  showStopIndicator?: boolean;
  // The value beside the handle while it's pressed or focused from the keyboard
  showValueIndicator?: boolean;
  // M3's inset icon, inside the track at its start, on "md", "lg" and "xl" standard sliders only
  icon?: SvgIconNameTypes;
  // A range slider's handles: each one's input attributes (`value`, `name`, `id`, `aria-*`)
  handleStart?: SliderHandlePropsType;
  handleEnd?: SliderHandlePropsType;
};

const {
  variant = "standard",
  size = "xs",
  orientation = "horizontal",
  showStops = false,
  showStopIndicator = true,
  showValueIndicator = false,
  icon,
  handleStart,
  handleEnd,
  class: classList,
  ...attrs
}: Props = Astro.props;

// Values outside these fail the build, rather than drawing something other than was asked for
// (ADR-0021)
if (!["xs", "sm", "md", "lg", "xl"].includes(size)) {
  throw new Error(
    `Slider: M3's sizes are "xs", "sm", "md", "lg" and "xl", but this one's \`size\` is "${size}".`
  );
}
if (!["horizontal", "vertical"].includes(orientation)) {
  throw new Error(
    `Slider: M3's orientations are "horizontal" and "vertical", but this one's \`orientation\` is "${orientation}".`
  );
}
if (!["standard", "centered", "range"].includes(variant)) {
  throw new Error(
    `Slider: M3's sliders are "standard", "centered" and "range", but this one's \`variant\` is "${variant}".`
  );
}
if (icon && ["xs", "sm"].includes(size)) {
  throw new Error(
    `Slider: M3 puts an inset icon only on "md", "lg" and "xl" sliders, but this one's \`size\` is "${size}".`
  );
}
if (icon && variant !== "standard") {
  throw new Error(
    `Slider: M3 puts an inset icon only on standard sliders, as it hides where a centered or range slider starts, but this one's \`variant\` is "${variant}".`
  );
}
const isRange = variant === "range";
if (!isRange && (handleStart || handleEnd)) {
  throw new Error(
    `Slider: only a range slider has \`handleStart\` and \`handleEnd\`, but this one's \`variant\` is "${variant}".`
  );
}
// A range slider's attributes go on both its inputs, so each handle's own would repeat; and its
// handles share one range and state, which the slider draws, so one handle's would split them
const ownAttribute = Object.keys(attrs).find(
  (name) => ["value", "name", "id"].includes(name) || name.startsWith("aria-")
);
if (isRange && ownAttribute) {
  throw new Error(
    `Slider: a range slider takes each handle's \`value\`, \`name\`, \`id\` and \`aria-*\` in \`handleStart\` and \`handleEnd\`, but this one's \`${ownAttribute}\` is ${JSON.stringify(attrs[ownAttribute as keyof typeof attrs])}.`
  );
}
for (const [prop, handle] of Object.entries({ handleStart, handleEnd })) {
  const shared = Object.keys(handle ?? {}).find((name) =>
    ["min", "max", "step", "disabled", "form"].includes(name)
  );
  if (shared) {
    throw new Error(
      `Slider: a range slider's handles share its \`min\`, \`max\`, \`step\`, \`disabled\` and \`form\`, but this one's \`${prop}.${shared}\` is ${JSON.stringify(handle![shared as keyof SliderHandlePropsType])}.`
    );
  }
}

// The input's range, read as the browser would: min 0, max 100 and step 1 unless given
const min = attrs.min === undefined ? 0 : Number(attrs.min);
const max = attrs.max === undefined ? 100 : Number(attrs.max);
const isAnyStep = attrs.step === "any";
const step = attrs.step === undefined || isAnyStep ? 1 : Number(attrs.step);
// A value as a message quotes it: a number as it is, anything else as text
const quoted = (read: number, given: unknown) =>
  Number.isFinite(read) ? read : `"${given}"`;
if (!Number.isFinite(min)) {
  throw new Error(
    `Slider: its \`min\` must be a number, but this one's \`min\` is "${attrs.min}".`
  );
}
if (!Number.isFinite(max) || max <= min) {
  throw new Error(
    `Slider: its \`max\` must be a number more than its \`min\` (${min}), but this one's \`max\` is ${quoted(max, attrs.max)}.`
  );
}
if (!isAnyStep && !(step > 0)) {
  throw new Error(
    `Slider: its \`step\` must be a number more than 0, or "any", but this one's \`step\` is ${quoted(step, attrs.step)}.`
  );
}
// M3's stops divide the track evenly, the first at `min` and the last at `max`
const intervals = (max - min) / step;
if (
  showStops &&
  (isAnyStep || Math.abs(intervals - Math.round(intervals)) > 1e-9)
) {
  throw new Error(
    `Slider: stops divide the track evenly from \`min\` to \`max\` (${min} to ${max}), but this one's \`step\` is ${isAnyStep ? '"any"' : step}.`
  );
}

// The value the browser starts an input at: the given one, or the fallback, snapped to a step
const snapped = (given: unknown, fallback: number) => {
  const read = given === undefined ? NaN : Number(given);
  return snapSliderValue(Number.isFinite(read) ? read : fallback, {
    min,
    max,
    step: isAnyStep ? "any" : step,
  });
};
const middle = min + (max - min) / 2;

// The inputs, each in its own handle: one, at the given value or the browser's middle, or a
// range slider's two, from `min` and `max` unless given
type Handle = {
  // which of the active track's ends the handle sits at: either, for a single handle
  side: "value" | "start" | "end";
  value: number;
  attrs: SliderHandlePropsType;
};
const handles: Handle[] = isRange
  ? [
      {
        side: "start",
        value: snapped(handleStart?.value, min),
        attrs: {
          ...attrs,
          ...handleStart,
          value: handleStart?.value ?? String(min),
        },
      },
      {
        side: "end",
        value: snapped(handleEnd?.value, max),
        attrs: {
          ...attrs,
          ...handleEnd,
          value: handleEnd?.value ?? String(max),
        },
      },
    ]
  : [{ side: "value", value: snapped(attrs.value, middle), attrs }];
if (isRange && handles[0]!.value > handles[1]!.value) {
  throw new Error(
    `Slider: a range slider's handles can't cross, so its \`handleStart.value\` must be no more than its \`handleEnd.value\` (${handles[1]!.value}), but this one's \`handleStart.value\` is ${handles[0]!.value}.`
  );
}

// Where the active track starts and ends, as its CSS reads them, so the slider is drawn before
// its script runs; the script sets them the same way on each change
const style = Object.entries(
  sliderPlaces({
    variant,
    min,
    max,
    hasStops: showStops,
    values: handles.map(({ value }) => value),
  })
)
  .map(([property, value]) => `${property}: ${value}`)
  .join("; ");

// A stop at every step, or the stop indicator at the end of each inactive track: a standard
// slider's one, a centered or range slider's two. A centered slider has no stop at its middle,
// which the gap beside the active track always covers, as Compose skips it.
const stopFractions = showStops
  ? Array.from({ length: Math.round(intervals) + 1 }, (_, i) => i).flatMap(
      (i) =>
        variant === "centered" && i * 2 === Math.round(intervals)
          ? []
          : [i / intervals]
    )
  : showStopIndicator
    ? variant === "standard"
      ? [1]
      : [0, 1]
    : [];

// M3's measurements per size: track thickness, handle height, the track's outer corners, and the
// inset icon's size and padding
const sizes = {
  xs: "[--ac-slider-thickness:16px] [--ac-slider-handle:44px] [--ac-slider-corner:8px]",
  sm: "[--ac-slider-thickness:24px] [--ac-slider-handle:44px] [--ac-slider-corner:8px]",
  md: "[--ac-slider-thickness:40px] [--ac-slider-handle:52px] [--ac-slider-corner:12px] [--ac-slider-icon:24px] [--ac-slider-icon-padding:6px]",
  lg: "[--ac-slider-thickness:56px] [--ac-slider-handle:68px] [--ac-slider-corner:16px] [--ac-slider-icon:24px] [--ac-slider-icon-padding:6px]",
  xl: "[--ac-slider-thickness:96px] [--ac-slider-handle:108px] [--ac-slider-corner:28px] [--ac-slider-icon:32px] [--ac-slider-icon-padding:8px]",
}[size];
const isVertical = orientation === "vertical";

// Each handle reads its place along the track: a range slider's start and end handles the
// active track's ends, and a single handle whichever of them is a handle
const handlePlaceClass = {
  value: "inset-s-[calc(var(--ac-slider-value-at)-2px)]",
  start: "inset-s-[calc(var(--ac-slider-from-at)-2px)]",
  end: "inset-s-[calc(var(--ac-slider-to-at)-2px)]",
};

// A stop indicator, or the inset icon, is drawn on every track at the same place, each track
// clipping it, so it shows in whichever track holds it, in that track's color. A stop's center
// is 6px in from the track's start (M3's 4px trailing space and half the 4px stop) at the first
// and from its end at the last, with the others evenly between. The tracks at the start place it
// from the track's start, less where they start, and the inactive one at the end from its end.
const stopClass =
  "absolute inset-bs-[calc(50%-2px)] size-1 rounded-full bg-current";
const stopFromStart =
  "inset-s-[calc(4px+(100cqi-12px)*var(--ac-slider-stop)-var(--ac-slider-track-start,0px))]";
const iconClass =
  "absolute inset-bs-[calc(50%-var(--ac-slider-icon)/2)] size-(--ac-slider-icon)";
const inactiveTrackClass =
  "absolute inset-bs-0 inset-be-0 overflow-hidden bg-(--theme-color-secondary-container) text-(--theme-color-on-secondary-container) motion-safe:transition-colors";
---

<div
  class:list={twMerge(
    "relative block-[max(var(--ac-slider-handle),48px)] cursor-pointer select-none has-disabled:cursor-default",
    // Vertical, the slider is laid out in a vertical writing mode whose inline axis runs from
    // the bottom up, so every logical inset and size below turns with it. Its value indicator
    // sits on the side the text starts from.
    isVertical
      ? "h-75 touch-pan-x [direction:rtl] [writing-mode:vertical-lr] rtl:[writing-mode:vertical-rl]"
      : "w-full touch-pan-y",
    sizes,
    // A standard slider's active track starts at the track's start, with its outer corner; a
    // centered or range slider's between the middle or a handle, with 2px corners
    variant === "standard"
      ? "[--ac-slider-active-corner:var(--ac-slider-corner)]"
      : "[--ac-slider-active-corner:2px]",
    classList
  )}
  style={style}
  data-ac-slider
  data-ac-slider-variant={variant}
  data-ac-slider-orientation={orientation}
  data-ac-slider-stops={showStops ? "" : undefined}
>
  {/* The track spans the slider less half the 4px handle at each end, so the handle stays
      inside it. It's the container its parts measure, 100cqi long. */}
  <span
    class="pointer-events-none absolute inset-s-0.5 inset-e-0.5 inset-bs-[calc(50%-var(--ac-slider-thickness)/2)] block-(--ac-slider-thickness) @container"
    data-ac-slider-part="track"
  >
    {variant !== "standard" && (
      <span
        class={twMerge(
          inactiveTrackClass,
          "inset-s-0 rounded-s-(--ac-slider-corner) rounded-e-xs"
        )}
        data-ac-slider-part="inactive-track-start"
      >
        {stopFractions.map((stop) => (
          <span
            class:list={[stopClass, stopFromStart]}
            style={`--ac-slider-stop: ${stop}`}
            data-ac-slider-part="stop"
          />
        ))}
      </span>
    )}
    <span
      class="absolute inset-s-(--ac-slider-active-start) inset-bs-0 inset-be-0 overflow-hidden rounded-s-(--ac-slider-active-corner) rounded-e-xs bg-(--theme-color-primary) text-(--theme-color-on-primary) [--ac-slider-track-start:var(--ac-slider-active-start)] motion-safe:transition-colors"
      data-ac-slider-part="active-track"
    >
      {stopFractions.map((stop) => (
        <span
          class:list={[stopClass, stopFromStart]}
          style={`--ac-slider-stop: ${stop}`}
          data-ac-slider-part="stop"
        />
      ))}
      {icon && (
        <Icon
          name={icon}
          class={twMerge(iconClass, "inset-s-(--ac-slider-icon-at)")}
          data-ac-slider-part="icon"
        />
      )}
    </span>
    <span
      class={twMerge(
        inactiveTrackClass,
        "inset-e-0 rounded-s-xs rounded-e-(--ac-slider-corner)"
      )}
      data-ac-slider-part="inactive-track"
    >
      {stopFractions.map((stop) => (
        <span
          class:list={[
            stopClass,
            "inset-e-[calc(4px+(100cqi-12px)*(1-var(--ac-slider-stop)))]",
          ]}
          style={`--ac-slider-stop: ${stop}`}
          data-ac-slider-part="stop"
        />
      ))}
      {icon && (
        <Icon
          name={icon}
          class={twMerge(
            iconClass,
            "inset-e-[calc(100cqi-var(--ac-slider-icon-at)-var(--ac-slider-icon))]"
          )}
          data-ac-slider-part="icon"
        />
      )}
    </span>
    {/* M3's handle: 4px wide, 2px while pressed or focused, centered on its value. Its input is
        inside it, so assistive tech finds each handle where it's drawn; the script draws pointer
        and key changes, so the input takes no pointer events of its own. */}
    {handles.map(({ side, value, attrs: inputAttrs }) => (
      <span
        class:list={[
          "absolute inset-bs-[calc(50%-var(--ac-slider-handle)/2)] flex inline-1 block-(--ac-slider-handle) justify-center",
          handlePlaceClass[side],
        ]}
        data-ac-slider-part="handle-position"
        data-ac-slider-handle={side}
      >
        <input
          class="pointer-events-none absolute inset-0 m-0 size-full appearance-none opacity-0"
          type="range"
          aria-orientation={isVertical ? "vertical" : undefined}
          {...inputAttrs}
        />
        <span
          class="inline-1 block-full rounded-full bg-(--theme-color-primary)"
          data-ac-slider-part="handle"
        />
        {showValueIndicator && (
          <span
            class="absolute -inset-s-12 -inset-e-12 inset-be-[calc(100%+12px)] flex justify-center opacity-0 motion-safe:transition-opacity"
            data-ac-slider-part="value-indicator"
          >
            <span
              class="flex h-11 min-w-12 items-center justify-center rounded-full bg-(--theme-color-inverse-surface) px-2 text-sm leading-5 font-medium tracking-normal text-(--theme-color-inverse-on-surface) [writing-mode:horizontal-tb]"
              aria-hidden="true"
              data-ac-slider-part="value"
            >
              {value}
            </span>
          </span>
        )}
      </span>
    ))}
  </span>
</div>

<style>
  /* M3's disabled on-surface at 38%: the handles, the active track and the inactive tracks' stops */
  [data-ac-slider] {
    --ac-slider-disabled: color-mix(
      in oklab,
      var(--theme-color-on-surface) 38%,
      transparent
    );
  }

  /* The geometry every part reads, along the track (100cqi long) from its start. The active
     track runs from one place to another, each the track's start, its middle or a handle. A
     place is its fraction of the track, or, a handle between stops, of the track less 6px at
     each end. Beside a handle, a track stops 8px short of its center (half the handle and M3's
     6px gap); beside the middle, the inactive track stops 6px short and the active one meets it,
     as Compose draws them. A track shorter than its outer corner isn't drawn, as Compose's isn't:
     max(0px, min(L, (L - corner) * 100000)) is L when L is longer than the corner, and 0 when it
     isn't. */
  [data-ac-slider-part="track"] {
    --ac-slider-from-at: calc(
      var(--ac-slider-from-inset) * 6px +
        (100cqi - var(--ac-slider-from-inset) * 12px) * var(--ac-slider-from)
    );
    --ac-slider-to-at: calc(
      var(--ac-slider-to-inset) * 6px +
        (100cqi - var(--ac-slider-to-inset) * 12px) * var(--ac-slider-to)
    );
    /* A single handle is whichever end of the active track is a handle */
    --ac-slider-value-at: calc(
      var(--ac-slider-from-handle) * var(--ac-slider-from-at) +
        (1 - var(--ac-slider-from-handle)) * var(--ac-slider-to-at)
    );
    --ac-slider-active-start: calc(
      var(--ac-slider-from-at) + var(--ac-slider-from-handle) * 8px
    );
    --ac-slider-active: calc(
      var(--ac-slider-to-at) - var(--ac-slider-to-handle) * 8px -
        var(--ac-slider-active-start)
    );
    --ac-slider-inactive-start: calc(
      var(--ac-slider-from-at) - 6px - var(--ac-slider-from-handle) * 2px
    );
    --ac-slider-inactive: calc(
      100cqi - var(--ac-slider-to-at) - 6px - var(--ac-slider-to-handle) * 2px
    );
    /* The inset icon sits its padding in from the start of the active track while it fits there,
       with its padding either side, and from the start of the inactive track when it doesn't */
    --ac-slider-icon-at: min(
      var(--ac-slider-to-at) + 8px + var(--ac-slider-icon-padding),
      var(--ac-slider-icon-padding) +
        max(
          0px,
          (
              var(--ac-slider-icon) + 2 * var(--ac-slider-icon-padding) -
                var(--ac-slider-active)
            ) *
            100000
        )
    );
  }

  [data-ac-slider-part="inactive-track-start"] {
    inline-size: max(
      0px,
      min(
        var(--ac-slider-inactive-start),
        (var(--ac-slider-inactive-start) - var(--ac-slider-corner)) * 100000
      )
    );
  }

  [data-ac-slider-part="active-track"] {
    inline-size: max(
      0px,
      min(
        var(--ac-slider-active),
        (var(--ac-slider-active) - var(--ac-slider-active-corner)) * 100000
      )
    );
  }

  [data-ac-slider-part="inactive-track"] {
    inline-size: max(
      0px,
      min(
        var(--ac-slider-inactive),
        (var(--ac-slider-inactive) - var(--ac-slider-corner)) * 100000
      )
    );
  }

  /* Pressed or focused from the keyboard, a handle narrows to 2px, and shows its value indicator
     if it has one. Focused, it shows the theme focus ring. */
  [data-ac-slider-pressed] > [data-ac-slider-part="handle"],
  input:focus-visible ~ [data-ac-slider-part="handle"] {
    inline-size: 2px;
  }

  input:focus-visible ~ [data-ac-slider-part="handle"] {
    box-shadow:
      0 0 0 2px var(--theme-color-wrapper-bg),
      0 0 0 5px var(--theme-color-focus-ring-on-bg);
  }

  [data-ac-slider-pressed] > [data-ac-slider-part="value-indicator"],
  input:focus-visible ~ [data-ac-slider-part="value-indicator"] {
    opacity: 1;
  }

  /* M3's disabled colors: the handles and active track in on-surface at 38%, the inactive tracks
     at 12%, the stops on the active track in inverse-on-surface and on the inactive ones in
     on-surface at 38% */
  [data-ac-slider]:has(input:disabled) [data-ac-slider-part="handle"] {
    background-color: var(--ac-slider-disabled);
  }

  [data-ac-slider]:has(input:disabled) [data-ac-slider-part="active-track"] {
    background-color: var(--ac-slider-disabled);
    color: var(--theme-color-inverse-on-surface);
  }

  [data-ac-slider]:has(input:disabled) [data-ac-slider-part^="inactive-track"] {
    background-color: color-mix(
      in oklab,
      var(--theme-color-on-surface) 12%,
      transparent
    );
    color: var(--ac-slider-disabled);
  }

  /* ADR-0018: a handle narrows on fast spatial, so it briefly overshoots, and its color and
     focus ring change on fast effects. It moves to a new value at once, under the pointer. */
  @media (prefers-reduced-motion: no-preference) {
    [data-ac-slider-part="handle"] {
      transition:
        inline-size var(--theme-duration-spring-fast-spatial)
          var(--ease-spring-fast-spatial),
        background-color var(--theme-duration-spring-fast-effects)
          var(--ease-spring-fast-effects),
        box-shadow var(--theme-duration-spring-fast-effects)
          var(--ease-spring-fast-effects);
    }
  }
</style>

<script>
  import { sliderPlaces, snapSliderValue } from "../utils";

  // The inputs take no pointer events, so the slider sets their values from the pointer and the
  // keys itself, the same way in every browser, orientation and direction, and draws them by
  // setting the places its CSS reads. Delegated from the document, so it covers sliders added
  // later, as by Astro's ClientRouter.
  const sliderOf = (target: EventTarget | null) =>
    target instanceof Element
      ? target.closest<HTMLElement>("[data-ac-slider]")
      : null;
  // A slider's inputs: one, or a range slider's start and end
  const inputsOf = (slider: HTMLElement) => [
    ...slider.querySelectorAll<HTMLInputElement>('input[type="range"]'),
  ];
  const rangeOf = (input: HTMLInputElement) => {
    const min = input.min === "" ? 0 : Number(input.min);
    const max = input.max === "" ? 100 : Number(input.max);
    return { min, max };
  };
  // One step: the input's, or with step="any", a hundredth of the range, as Compose's keys move
  const stepOf = (input: HTMLInputElement) => {
    const { min, max } = rangeOf(input);
    return input.step === "any" ? (max - min) / 100 : Number(input.step || 1);
  };
  const variantOf = (slider: HTMLElement) =>
    slider.getAttribute("data-ac-slider-variant") as
      "standard" | "centered" | "range";
  const hasStops = (slider: HTMLElement) =>
    slider.hasAttribute("data-ac-slider-stops");
  const isVertical = (slider: HTMLElement) =>
    slider.getAttribute("data-ac-slider-orientation") === "vertical";
  // A horizontal slider in right to left runs from its right
  const isReversed = (slider: HTMLElement) =>
    !isVertical(slider) && getComputedStyle(slider).direction === "rtl";
  // The values an input can take: its range, and on a range slider, up to the other handle, so
  // the handles can't cross
  const boundsOf = (slider: HTMLElement, input: HTMLInputElement) => {
    const { min, max } = rangeOf(input);
    if (variantOf(slider) !== "range") return { min, max };
    const [start, end] = inputsOf(slider) as [
      HTMLInputElement,
      HTMLInputElement,
    ];
    return input === start
      ? { min, max: end.valueAsNumber }
      : { min: start.valueAsNumber, max };
  };

  // Sets the places the CSS draws the active track between, as the server renders them, and
  // each handle's value indicator
  const draw = (slider: HTMLElement) => {
    const inputs = inputsOf(slider);
    const places = sliderPlaces({
      variant: variantOf(slider),
      ...rangeOf(inputs[0]!),
      hasStops: hasStops(slider),
      values: inputs.map((input) => input.valueAsNumber),
    });
    for (const [property, value] of Object.entries(places))
      slider.style.setProperty(property, value);
    for (const input of inputs) {
      const label = input.parentElement!.querySelector(
        '[data-ac-slider-part="value"]'
      );
      if (label) label.textContent = input.value;
    }
  };

  const drawAll = (root: ParentNode = document) =>
    root
      .querySelectorAll<HTMLElement>("[data-ac-slider]")
      .forEach((slider) => draw(slider));

  // Sets the value, as a person would, within its bounds: input fires, and change once it's
  // committed
  const setValue = (
    input: HTMLInputElement,
    value: number,
    isCommitted: boolean
  ) => {
    const { min, max } = boundsOf(sliderOf(input)!, input);
    const before = input.value;
    input.value = String(Math.min(max, Math.max(min, value)));
    if (input.value === before) return false;
    input.dispatchEvent(new Event("input", { bubbles: true }));
    if (isCommitted)
      input.dispatchEvent(new Event("change", { bubbles: true }));
    return true;
  };

  // The value under the pointer: along the track from its start (its left, or its right in
  // right to left, or its bottom when vertical), snapped to the nearest stop if it has stops,
  // or to the nearest step if not, as the browser would, so a press on a handle is at its value
  const valueAt = (slider: HTMLElement, event: PointerEvent) => {
    const input = inputsOf(slider)[0]!;
    const { min, max } = rangeOf(input);
    const step = stepOf(input);
    const track = slider
      .querySelector('[data-ac-slider-part="track"]')!
      .getBoundingClientRect();
    const length = isVertical(slider) ? track.height : track.width;
    const along = isVertical(slider)
      ? track.bottom - event.clientY
      : isReversed(slider)
        ? track.right - event.clientX
        : event.clientX - track.left;
    if (!hasStops(slider)) {
      return snapSliderValue(min + (along / length) * (max - min), {
        min,
        max,
        step: input.step === "any" ? "any" : step,
      });
    }
    // The stops' places, as the CSS draws them: the ends at 0 and the full length, the others
    // between 6px in from each end
    const count = Math.round((max - min) / step);
    let nearest = 0;
    let nearestDistance = Infinity;
    for (let i = 0; i <= count; i++) {
      const at =
        i === 0 ? 0 : i === count ? length : 6 + ((length - 12) * i) / count;
      const distance = Math.abs(at - along);
      if (distance < nearestDistance) {
        nearest = i;
        nearestDistance = distance;
      }
    }
    return min + nearest * step;
  };

  // The handle a press at a value moves: the only one, or on a range slider the nearer one, or
  // with both at one place, none until the pointer moves to one side, as Compose's does
  const handleFor = (slider: HTMLElement, value: number) => {
    const inputs = inputsOf(slider);
    if (variantOf(slider) !== "range") return inputs[0];
    const [start, end] = inputs as [HTMLInputElement, HTMLInputElement];
    const toStart = Math.abs(value - start.valueAsNumber);
    const toEnd = Math.abs(value - end.valueAsNumber);
    if (toStart !== toEnd) return toStart < toEnd ? start : end;
    if (value === start.valueAsNumber) return undefined;
    return value < start.valueAsNumber ? start : end;
  };

  document.addEventListener("pointerdown", (event) => {
    const slider = sliderOf(event.target);
    if (!slider || !event.isPrimary || event.button !== 0) return;
    const inputs = inputsOf(slider);
    if (inputs[0]!.disabled) return;
    // Keeps the press from moving focus off the input, which it focuses instead
    event.preventDefault();
    slider.setPointerCapture(event.pointerId);
    const pressedAt = valueAt(slider, event);
    let input: HTMLInputElement | undefined;
    let before = "";
    const press = (handle: HTMLInputElement, value: number) => {
      input = handle;
      before = handle.value;
      handle.focus({ preventScroll: true, focusVisible: false });
      handle.parentElement!.setAttribute("data-ac-slider-pressed", "");
      setValue(handle, value, false);
    };
    const handle = handleFor(slider, pressedAt);
    if (handle) press(handle, pressedAt);

    const move = (moveEvent: PointerEvent) => {
      if (moveEvent.pointerId !== event.pointerId) return;
      const value = valueAt(slider, moveEvent);
      if (input) setValue(input, value, false);
      // Both handles at the pressed place: the pointer picks the one on its side
      else if (value !== pressedAt)
        press(value < pressedAt ? inputs[0]! : inputs[1]!, value);
    };
    const end = (endEvent: PointerEvent) => {
      if (endEvent.pointerId !== event.pointerId) return;
      slider.removeEventListener("pointermove", move);
      slider.removeEventListener("pointerup", end);
      slider.removeEventListener("pointercancel", end);
      if (!input) return;
      input.parentElement!.removeAttribute("data-ac-slider-pressed");
      if (input.value !== before)
        input.dispatchEvent(new Event("change", { bubbles: true }));
    };
    slider.addEventListener("pointermove", move);
    slider.addEventListener("pointerup", end);
    slider.addEventListener("pointercancel", end);
  });

  // M3's keyboard table: the arrows move one step, an arrow with Space held a larger interval,
  // and Home and End go to the ends, or on a range slider to the other handle. With stops, an
  // arrow moves one stop with or without Space. Page Up and Page Down move the larger interval
  // too, as Compose's do. Left and right follow the track's direction, so they swap in right to
  // left.
  let isSpaceHeld = false;
  document.addEventListener("keydown", (event) => {
    const { target } = event;
    if (
      !(target instanceof HTMLInputElement) ||
      !target.matches("[data-ac-slider] input")
    )
      return;
    const slider = sliderOf(target)!;
    if (event.key === " ") {
      // Space only changes what the arrows do, and doesn't scroll the page
      event.preventDefault();
      isSpaceHeld = true;
      return;
    }
    const range = rangeOf(target);
    const { min, max } = boundsOf(slider, target);
    const step = stepOf(target);
    // Compose's larger interval: a tenth of the steps, from 1 to 10 of them
    const page = Math.min(
      10,
      Math.max(1, Math.floor((range.max - range.min) / step / 10))
    );
    const isRtl = isReversed(slider);
    const arrow = isSpaceHeld && !hasStops(slider) ? page : 1;
    const steps: Record<string, number> = {
      ArrowUp: arrow,
      ArrowDown: -arrow,
      ArrowRight: isRtl ? -arrow : arrow,
      ArrowLeft: isRtl ? arrow : -arrow,
      PageUp: page,
      PageDown: -page,
    };
    let value: number;
    if (event.key === "Home") value = min;
    else if (event.key === "End") value = max;
    else if (event.key in steps)
      value = target.valueAsNumber + steps[event.key]! * step;
    else return;
    event.preventDefault();
    setValue(target, value, true);
  });

  document.addEventListener("keyup", (event) => {
    if (event.key === " ") isSpaceHeld = false;
  });
  document.addEventListener("focusout", () => {
    isSpaceHeld = false;
  });

  // A value set some other way, as by assistive tech, is kept within its bounds too
  document.addEventListener("input", ({ target }) => {
    const slider = sliderOf(target);
    if (!slider || !(target instanceof HTMLInputElement)) return;
    const { min, max } = boundsOf(slider, target);
    if (target.valueAsNumber > max) target.value = String(max);
    else if (target.valueAsNumber < min) target.value = String(min);
    draw(slider);
  });

  // A form's reset restores its inputs after the reset event, so they're drawn a task later
  document.addEventListener("reset", ({ target }) => {
    if (target instanceof HTMLFormElement) setTimeout(() => drawAll(target));
  });

  // The browser can restore a value the page wasn't rendered with, as on going back
  drawAll();
  document.addEventListener("astro:page-load", () => drawAll());
</script>
