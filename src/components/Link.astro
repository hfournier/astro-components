---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import { unwrapParagraph } from "../utils";

type Props = HTMLAttributes<"a">;
const { class: classList, ...attrs } = Astro.props;
const text = unwrapParagraph(await Astro.slots.render("default"));
---

<a
  class:list={twMerge(
    "rounded-xs text-(--theme-color-link-text) underline decoration-1 underline-offset-2 hover:decoration-2 hover:underline-offset-4",
    "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-offset-2 focus-visible:ring-offset-(--theme-color-wrapper-bg)",
    classList
  )}
  {...attrs}
>
  <Fragment set:html={text} />
</a>
