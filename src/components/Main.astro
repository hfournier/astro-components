---
import type { ComponentProps } from "astro/types";
import BaseWrapper from "./BaseWrapper.astro";

type BaseWrapperProps = ComponentProps<typeof BaseWrapper>;

type Props = Omit<BaseWrapperProps, "as">;

const { class: classList, ...attrs } = Astro.props;
---

<BaseWrapper as="main" id="main-content" class:list={[classList]} {...attrs}>
  <slot />
</BaseWrapper>
