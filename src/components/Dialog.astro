---
import type { ComponentProps } from "astro/types";
import { twMerge } from "tailwind-merge";
import Icon from "./Icon.astro";
import BaseOverlay from "./BaseOverlay.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import type { SvgIconNameTypes } from "../svgs";

type BaseOverlayProps = ComponentProps<typeof BaseOverlay>;

// No bgColor: M3 fixes basic dialogs at Surface Container High (BaseOverlay's default).
type Props = Omit<BaseOverlayProps, "as" | "bgColor"> & {
  icon?: SvgIconNameTypes;
  headline?: string;
  label?: string;
};

const { icon, headline, label, id, class: classList, ...attrs } = Astro.props;
---

<BaseOverlay
  class:list={twMerge(
    "flex max-h-[calc(100dvh-3rem)] max-w-140 min-w-70 flex-col rounded-[28px] p-6",
    classList
  )}
  {id}
  transition="fade-down"
  aria-labelledby={headline ? `${id}-headline` : undefined}
  aria-label={label && !headline ? label : undefined}
  data-ac-dialog
  {...attrs}
>
  {
    /* role="none" on the header and footer: outside <main> and any sectioning element, they'd
       otherwise be the page's banner and contentinfo landmarks while the dialog is open. */
  }
  {
    (headline || icon) && (
      <Header
        bgColor="transparent"
        role="none"
        class:list={["pb-4", icon && "flex flex-col items-center gap-4"]}
      >
        {icon && <Icon class="fill-(--theme-color-secondary)" name={icon} />}
        {headline && (
          <h2
            class:list={[
              "text-2xl text-(--theme-color-on-surface)",
              icon && "text-center",
            ]}
            id={`${id}-headline`}
          >
            {headline}
          </h2>
        )}
      </Header>
    )
  }

  {
    /* Only the content scrolls; the headline and actions stay put. It bleeds to the dialog's
       edges (-mx-6 px-6) so the dividers span the full width, per M3. Browsers make a scrolling
       region keyboard-focusable, so it gets the theme focus ring rather than the UA outline.
       Text is M3 supporting text: Body Medium in on-surface-variant. */
  }
  <div
    class:list={[
      "scroll-content -mx-6 min-h-0 flex-1 overflow-y-auto px-6",
      "text-sm leading-5 tracking-[0.25px] text-(--theme-color-on-surface-variant)",
      "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-inset",
    ]}
    id={`${id}-content`}
  >
    <div class="divider divider-top" aria-hidden="true"></div>
    <slot />
    <div class="divider divider-bottom" aria-hidden="true"></div>
  </div>

  {
    /* M3 stacks actions too long for one row, confirm above dismiss. Dismiss comes first in the
       DOM, so wrapping in reverse puts confirm on the top line, both at the end, and keeps the
       Tab order dismiss, then confirm. */
  }
  {
    Astro.slots.has("actions") && (
      <Footer
        bgColor="transparent"
        class="flex flex-wrap-reverse items-center justify-end gap-2 pt-6"
        role="none"
      >
        <slot name="actions" />
      </Footer>
    )
  }
</BaseOverlay>

<script>
  // Escape closes a dialog without setting its returnValue, and Firefox and WebKit keep the one
  // from its last opening, so it's cleared: an Escape never reads as the action chosen last time.
  // A request-close button's value is applied after `cancel`, so it still wins.
  //
  // M3 cancels a dialog on a click on its scrim too, as Escape does: a cancelable `cancel`, then
  // close. The panel fills the dialog, so a click on the dialog itself is on its ::backdrop. The
  // press must start there too, so a text selection dragged out of the content doesn't close it.
  document
    .querySelectorAll<HTMLDialogElement>("[data-ac-dialog]")
    .forEach((dialog) => {
      dialog.addEventListener("cancel", () => {
        dialog.returnValue = "";
      });

      let pressedOnScrim = false;
      dialog.addEventListener("pointerdown", (event) => {
        pressedOnScrim = event.target === dialog;
      });
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog || !pressedOnScrim) return;
        pressedOnScrim = false;
        if (dialog.dispatchEvent(new Event("cancel", { cancelable: true })))
          dialog.close("");
      });
    });
</script>

<style>
  /* M3 scrolling dialog: a divider shows at whichever edge content is scrolled out of view,
     separating it from the fixed headline/actions. Scroll-state queries only style descendants
     of the scroller, so the dividers are sticky children of it. Unsupported browsers simply
     never show them. */
  .scroll-content {
    container-type: scroll-state;
  }

  .divider {
    position: sticky;
    z-index: 1;
    height: 1px;
    margin-inline: calc(var(--spacing) * -6);
    background-color: var(--theme-color-outline);
    opacity: 0;

    @media (prefers-reduced-motion: no-preference) {
      /* fast effects, as all component opacity changes (ADR-0018) */
      transition: opacity var(--theme-duration-spring-fast-effects)
        var(--ease-spring-fast-effects);
    }
  }

  /* Negative margins so the hidden dividers take up no space in the layout. */
  .divider-top {
    top: 0;
    margin-bottom: -1px;
  }

  .divider-bottom {
    bottom: 0;
    margin-top: -1px;
  }

  @container scroll-state(scrollable: top) {
    .divider-top {
      opacity: 1;
    }
  }

  @container scroll-state(scrollable: bottom) {
    .divider-bottom {
      opacity: 1;
    }
  }
</style>
