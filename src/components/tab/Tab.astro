---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { TabTransitionType } from "../../types.js";
import type { SvgIconNameTypes } from "../../svgs";

type Props = HTMLAttributes<"div"> & {
  badgeLabel?: string;
  icon?: SvgIconNameTypes;
  label: string;
  transition?: TabTransitionType;
};

const {
  badgeLabel,
  icon,
  label,
  transition = "fade",
  class: classList,
  ...attrs
} = Astro.props;

const transitionClasses = {
  fade: "motion-safe:transition-[display,opacity] motion-safe:transition-discrete motion-safe:duration-(--theme-duration-content-swap) motion-safe:starting:opacity-0",
  "fade-up":
    "motion-safe:transition-[display,opacity,translate] motion-safe:transition-discrete motion-safe:duration-(--theme-duration-content-swap) motion-safe:starting:translate-y-full motion-safe:starting:opacity-0",
  "slide-left":
    "motion-safe:transition-[display,opacity,translate] motion-safe:transition-discrete motion-safe:duration-(--theme-duration-content-swap) motion-safe:starting:translate-x-full motion-safe:starting:opacity-0",
}[transition];
---

<div
  class:list={twMerge(
    "[grid-area:stack] [[hidden]]:opacity-0",
    "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-inset",
    transitionClasses,
    classList
  )}
  tabindex="0"
  role="tabpanel"
  data-ac-tabpanel
  data-ac-tab-badge={badgeLabel}
  data-ac-tab-icon={icon}
  data-ac-tab-label={label}
  {...attrs}
>
  <slot />
</div>
