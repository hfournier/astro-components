---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { TabTransitionType } from "../../types.js";

type Props = HTMLAttributes<"div"> & {
  transition?: TabTransitionType;
  label: string;
};

const { transition = "none", label, class: classList, ...attrs } = Astro.props;

const transitionClasses = {
  none: "motion-safe:transition-[display,opacity] motion-safe:transition-discrete motion-safe:duration-(--duration-content-swap) motion-safe:starting:opacity-0",
  "fade-up":
    "motion-safe:transition-[display,opacity,translate] motion-safe:transition-discrete motion-safe:duration-(--duration-content-swap) motion-safe:starting:translate-y-full motion-safe:starting:opacity-0",
  "slide-left":
    "motion-safe:transition-[display,opacity,translate] motion-safe:transition-discrete motion-safe:duration-(--duration-content-swap) motion-safe:starting:translate-x-full motion-safe:starting:opacity-0",
}[transition];
---

<div
  class:list={twMerge(
    "[grid-area:stack] [[hidden]]:opacity-0",
    "focus-visible:outline-focus-ring focus-visible:outline-(length:--focus-ring-width) focus-visible:outline-offset-(--focus-ring-offset)",
    transitionClasses,
    classList
  )}
  tabindex="0"
  role="tabpanel"
  data-hfdev-tabpanel
  data-hfdev-tab-label={label}
  {...attrs}
>
  <slot />
</div>
