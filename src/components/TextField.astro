---
import type { HTMLAttributes } from "astro/types";
import crypto from "node:crypto";
import { twMerge } from "tailwind-merge";
import { unwrapParagraph } from "../utils";
import BaseTextField, {
  type TextFieldControlType,
} from "./BaseTextField.astro";

// A native text input, or a textarea for `type="textarea"`, so it submits, resets and validates
// with its form, in M3's text field, which BaseTextField draws. Every attribute but `class` and
// `maxlength` goes on the input (`name`, `value`, `placeholder`, `required`, `disabled`,
// `aria-*`), and `class` on the element around the whole field. The default slot is the label's
// text. For a field that holds input chips, see TextFieldChips.
type Props = (
  | (Omit<HTMLAttributes<"input">, "type"> & {
      type?:
        "email" | "number" | "password" | "search" | "tel" | "text" | "url";
      rows?: never;
    })
  | (Omit<HTMLAttributes<"textarea">, "rows"> & {
      type: "textarea";
      rows?: number;
    })
) & {
  variant?: "filled" | "outlined";
  maxlength?: number;
  // With `maxlength`: the words screen readers hear before the count ("Character count, 5/20"),
  // and the validation message and announcement past the limit, `{limit}` replaced with it. Set
  // them on pages in other languages.
  counterLabel?: string;
  overLimitMessage?: string;
};

const {
  type = "text",
  variant = "filled",
  id: givenId,
  value,
  rows,
  maxlength,
  counterLabel = "Character count",
  overLimitMessage = "Use {limit} characters or fewer",
  name,
  class: classList,
  ...attrs
}: Props = Astro.props;

// Values outside these, or numbers outside their range, fail the build, rather than drawing
// something other than was asked for (ADR-0021)
if (
  ![
    "text",
    "email",
    "number",
    "password",
    "search",
    "tel",
    "url",
    "textarea",
  ].includes(type)
) {
  throw new Error(
    `TextField: its types are "text", "email", "number", "password", "search", "tel", "url" and "textarea", but this one's \`type\` is "${type}".`
  );
}
if (!["filled", "outlined"].includes(variant)) {
  throw new Error(
    `TextField: M3's styles are "filled" and "outlined", but this one's \`variant\` is "${variant}".`
  );
}
// MDX passes attributes as strings, so `rows="4"` is read as the number it says. Text that isn't
// a number is quoted in the message.
const shown = (value: unknown) =>
  typeof value === "string" ? `"${value}"` : value;
const rowCount = rows == null ? undefined : Number(rows);
if (rowCount !== undefined && !(Number.isInteger(rowCount) && rowCount >= 1)) {
  throw new Error(
    `TextField: a text area is a whole number of lines tall, from 1, but this one's \`rows\` is ${shown(rows)}.`
  );
}
const limit = maxlength == null ? undefined : Number(maxlength);
if (limit !== undefined && !(Number.isInteger(limit) && limit >= 0)) {
  throw new Error(
    `TextField: a character limit is a whole number, from 0, but this one's \`maxlength\` is ${shown(maxlength)}.`
  );
}
// From Astro.props, as the destructured props carry their defaults
for (const prop of ["counterLabel", "overLimitMessage"] as const) {
  const given = Astro.props[prop];
  if (given !== undefined && limit === undefined) {
    throw new Error(
      `TextField: \`${prop}\` words the character counter, which \`maxlength\` shows, but this one has \`${prop}\` "${given}" and no \`maxlength\`.`
    );
  }
}

// A multi-line field is a textarea. Without `rows`, it starts one line tall and grows with its
// content; with `rows`, it's M3's text area, that many lines tall, and scrolls.
const isMultiLine = type === "textarea";
const hasFixedRows = isMultiLine && rowCount !== undefined;

// A null id, which HTML attributes allow, gets one too, as the label and description need it
const id = givenId ?? `ac-text-field-${crypto.randomUUID()}`;

const label = Astro.slots.has("default")
  ? unwrapParagraph(await Astro.slots.render("default")).trim()
  : "";
---

<BaseTextField
  variant={variant}
  id={id}
  layout={isMultiLine ? "multi-line" : "single-line"}
  label={label}
  value={value}
  maxlength={limit}
  counterLabel={counterLabel}
  overLimitMessage={overLimitMessage}
  attrs={attrs}
  class={classList}
>
  {Astro.slots.has("leading-icon") && (
    <slot name="leading-icon" slot="leading-icon" />
  )}
  {Astro.slots.has("trailing-icon") && (
    <slot name="trailing-icon" slot="trailing-icon" />
  )}
  {Astro.slots.has("prefix") && <slot name="prefix" slot="prefix" />}
  {Astro.slots.has("suffix") && <slot name="suffix" slot="suffix" />}
  {Astro.slots.has("supporting-text") && (
    <slot name="supporting-text" slot="supporting-text" />
  )}
  {(control: TextFieldControlType) =>
    isMultiLine ? (
      <textarea
        class:list={[
          control.class,
          // No resize handle. It grows a line at a time with its content, or as a text area is
          // `rows` lines tall, Body Large's 24px each, and scrolls.
          "resize-none",
          hasFixedRows
            ? "h-[calc(var(--ac-text-field-rows)*24px)]"
            : "min-h-6 overflow-y-hidden field-sizing-content",
        ]}
        rows={rowCount ?? 1}
        style={hasFixedRows ? `--ac-text-field-rows: ${rowCount}` : undefined}
        data-ac-text-field-grows={hasFixedRows ? undefined : ""}
        name={name}
        {...control.attrs}
        set:text={value}
      ></textarea>
    ) : (
      <input
        class:list={twMerge(
          control.class,
          "h-6",
          // M3 uses a trailing icon to clear a field, rather than the browser's own button
          "[&::-webkit-search-cancel-button]:appearance-none [&::-webkit-search-decoration]:appearance-none"
        )}
        type={type}
        value={value}
        name={name}
        {...control.attrs}
      />
    )
  }
</BaseTextField>
