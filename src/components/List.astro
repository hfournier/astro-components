---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

// An M3 Expressive list: a <ul>, or an <ol> for items in an order that matters, of ListItems. In
// the standard style its items sit edge to edge, with M3's dividers between them where `divider`
// asks; in the segmented style they're a group, filled and 2px apart, with rounded ends. It moves focus
// between its links and buttons with the arrow keys, as M3's Accessibility page asks: Tab
// reaches the first item (or the one focused last), the arrow keys move through the rest,
// wrapping at the ends, and Tab leaves the list. Space activates a link as well as Enter.
type Props = HTMLAttributes<"ul"> & {
  // A list whose order matters, such as steps, is an <ol>
  as?: "ul" | "ol";
  // M3's dividers between items: none, full width, or inset 16px at each end
  divider?: "none" | "full-width" | "inset";
  // M3's list styles: standard, its items edge to edge, or segmented, a group of filled items
  // 2px apart, 16px corners at its ends and 4px between (ADR-0029)
  variant?: "standard" | "segmented";
};

const {
  as: Tag = "ul",
  divider = "none",
  variant = "standard",
  class: classList,
  ...attrs
}: Props = Astro.props;

// Values outside these fail the build, rather than drawing something other than was asked for
// (ADR-0021)
if (!["ul", "ol"].includes(Tag)) {
  throw new Error(
    `List: its elements are "ul" and "ol", but this one's \`as\` is "${Tag}".`
  );
}
if (!["none", "full-width", "inset"].includes(divider)) {
  throw new Error(
    `List: M3's list dividers are "none", "full-width" and "inset", but this one's \`divider\` is "${divider}".`
  );
}
if (!["standard", "segmented"].includes(variant)) {
  throw new Error(
    `List: M3's list styles are "standard" and "segmented", but this one's \`variant\` is "${variant}".`
  );
}
// M3's Guidelines: gaps separate a contained list's items, dividers an uncontained one's
if (variant === "segmented" && divider !== "none") {
  throw new Error(
    `List: M3 separates a segmented list's items with gaps, not dividers, but this one's \`divider\` is "${divider}".`
  );
}
---

{/* role="list": Safari drops a list's role once its markers are styled away */}
<Tag
  class:list={twMerge(
    "flex list-none flex-col p-0",
    // Compose's SegmentedGap
    variant === "segmented" && "gap-0.5",
    classList
  )}
  role="list"
  data-ac-list
  data-ac-list-divider={divider === "none" ? undefined : divider}
  data-ac-list-variant={variant}
  {...attrs}
>
  <slot />
</Tag>

<style>
  /* A segmented list's items, in the surface-container M3's Specs draw (ADR-0029), take Compose's
     segmentedShapes: 16px at the group's ends, 4px between items, and 16px all around an only
     item. An item's hovered, focused, pressed and selected corners replace these. */
  [data-ac-list-variant="segmented"] > :global(li) {
    --ac-list-item-container: var(--theme-color-surface-container);
  }
  [data-ac-list-variant="segmented"] > :global(li:first-child) {
    --ac-list-item-corners: 16px 16px 4px 4px;
  }
  [data-ac-list-variant="segmented"] > :global(li:last-child) {
    --ac-list-item-corners: 4px 4px 16px 16px;
  }
  [data-ac-list-variant="segmented"] > :global(li:only-child) {
    --ac-list-item-corners: 16px;
  }

  /* M3's dividers sit between items, with no space above or below them: each ListItem draws
     one below itself, which shows in a list with dividers, except below the last item. An inset
     one stops 16px short of each end. */
  [data-ac-list-divider]
    > :global(li:not(:last-child) > [data-ac-list-item-part="divider"]) {
    display: block;
  }
  [data-ac-list-divider="inset"]
    > :global(li > [data-ac-list-item-part="divider"]) {
    margin-inline: 16px;
  }
</style>

<script>
  // M3's Accessibility page: one Tab stop per list, its first item, or the one focused last; the
  // Down and Right arrow keys move to the next item and Up and Left to the previous one,
  // wrapping at the ends, and mirrored right to left. Static and disabled items are skipped.
  // Space or Enter activates an item, so Space activates a link too, and Enter toggles a
  // checkbox item (ADR-0027). A checkbox or switch item's stop is its input. Radio items keep
  // the browser's radio keyboard, so the list leaves them alone (ADR-0028).
  const steps: Record<string, number> = {
    ArrowUp: -1,
    ArrowLeft: -1,
    ArrowDown: 1,
    ArrowRight: 1,
  };
  const focusables = (list: Element) => [
    ...list.querySelectorAll<HTMLElement>(
      ":scope > li > [data-ac-list-item]:is(a[href], button:not(:disabled)), :scope > li > label[data-ac-list-item] input[type=checkbox]:not(:disabled)"
    ),
  ];
  // the list an item is directly in, not one around that list
  const ownList = (item: Element) => {
    const list = item.closest("li")?.parentElement;
    return list?.matches("[data-ac-list]") ? list : null;
  };
  const makeTabStop = (list: Element, stop: HTMLElement) => {
    for (const item of focusables(list)) item.tabIndex = item === stop ? 0 : -1;
  };

  // Set again after each swap, for lists brought in by Astro's ClientRouter
  const init = () => {
    for (const list of document.querySelectorAll("[data-ac-list]")) {
      const [first] = focusables(list);
      if (first) makeTabStop(list, first);
    }
  };
  init();
  document.addEventListener("astro:after-swap", init);

  document.addEventListener("focusin", (event) => {
    const target = event.target as HTMLElement;
    const list = target.closest?.("[data-ac-list-item]") && ownList(target);
    if (list && focusables(list).includes(target)) makeTabStop(list, target);
  });

  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented) return;
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey)
      return;
    const target = event.target as HTMLElement;
    if (!target.closest?.("[data-ac-list-item]")) return;
    const list = ownList(target);
    if (!list) return;
    if (event.key === " " && target instanceof HTMLAnchorElement) {
      event.preventDefault();
      target.click();
      return;
    }
    // Enter would submit the checkbox's form; Switch answers Enter itself
    if (
      event.key === "Enter" &&
      target.matches("input[type=checkbox]:not([role=switch])")
    ) {
      event.preventDefault();
      if (!event.repeat) target.click();
      return;
    }
    if (!(event.key in steps)) return;
    const items = focusables(list);
    const index = items.indexOf(target);
    if (index < 0) return;
    const isMirrored =
      (event.key === "ArrowLeft" || event.key === "ArrowRight") &&
      getComputedStyle(list).direction === "rtl";
    const step = isMirrored ? -steps[event.key] : steps[event.key];
    event.preventDefault();
    items[(index + step + items.length) % items.length].focus();
  });
</script>
