---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

// A native progress element, so assistive tech announces it as a progress bar with its value.
// Every attribute but `class` goes on the progress (`value`, `max`, `aria-label`,
// `aria-labelledby`), and `class` on the element around it, which draws M3's parts. Without a
// `value` it's indeterminate. Update it from a script by setting the progress's `value`.
type Props = HTMLAttributes<"progress"> & {
  // M3's two shapes: flat, or Expressive's wavy active indicator
  shape?: "flat" | "wavy";
  // The track's thickness in px: M3's default is 4, and 8 its thick sample
  thickness?: number;
  // M3's stop indicator marks the end of a determinate track. Leave it out only when the track
  // has at least 3:1 contrast with the surfaces around it.
  showStopIndicator?: boolean;
};

const {
  shape = "flat",
  thickness = 4,
  showStopIndicator = true,
  class: classList,
  ...attrs
}: Props = Astro.props;

// The progress's own position, as the browser works it out: value over max, within 0 and 1
const maxAttribute = Number(attrs.max ?? 1);
const max = maxAttribute > 0 ? maxAttribute : 1;
const position =
  attrs.value == null
    ? 0
    : Math.min(Math.max(Number(attrs.value) / max || 0, 0), 1);

// Each segment of the track and the active indicator runs between its own start and end, lengths
// along the track, as Compose draws a stroke with round caps: the ends are clamped a cap inside
// the track, so a short segment is still a dot, and one that ends before it starts isn't drawn.
// Determinate, the active indicator runs to the progress and the track starts a gap after it;
// the indeterminate state moves them in the <style> block.
const segment =
  "absolute top-1/2 h-(--ac-linear-progress-indicator-thickness) -translate-y-1/2 rounded-full [--ac-linear-progress-indicator-end-cap:clamp(var(--ac-linear-progress-indicator-cap),var(--ac-linear-progress-indicator-end),100%_-_var(--ac-linear-progress-indicator-cap))] [--ac-linear-progress-indicator-start-cap:clamp(var(--ac-linear-progress-indicator-cap),var(--ac-linear-progress-indicator-start),100%_-_var(--ac-linear-progress-indicator-cap))] start-[calc(var(--ac-linear-progress-indicator-start-cap)_-_var(--ac-linear-progress-indicator-cap))] w-[clamp(0px,(var(--ac-linear-progress-indicator-end)_-_var(--ac-linear-progress-indicator-start))*1000,var(--ac-linear-progress-indicator-end-cap)_-_var(--ac-linear-progress-indicator-start-cap)_+_2*var(--ac-linear-progress-indicator-cap))]";
const track = `${segment} bg-(--theme-color-secondary-container)`;
const active = `${segment} bg-(--theme-color-primary)`;
// The wavy active indicator, a path the script draws
const wave =
  "fill-none stroke-(--theme-color-primary) [stroke-linecap:round] [stroke-width:var(--ac-linear-progress-indicator-thickness)]";
// The segments only an indeterminate indicator draws, empty while it's determinate
const indeterminateOnly =
  "[--ac-linear-progress-indicator-end:0px] [--ac-linear-progress-indicator-start:0px]";
---

<span
  class:list={twMerge(
    "relative block",
    // a wavy active indicator waves 3px (M3's amplitude) either side of the track
    shape === "wavy"
      ? "h-[calc(var(--ac-linear-progress-indicator-thickness)_+_6px)]"
      : "h-(--ac-linear-progress-indicator-thickness)",
    // the progress follows the value, and the wave flattens below 10% and from 95%, as
    // Compose's does: both transition in the <style> block
    "[--ac-linear-progress-indicator-progress:var(--ac-linear-progress-indicator-value)]",
    "[--ac-linear-progress-indicator-amplitude:calc(clamp(0,(var(--ac-linear-progress-indicator-value)_-_0.1)*1e6,1)*clamp(0,(0.95_-_var(--ac-linear-progress-indicator-value))*1e6,1))]",
    // a round cap is half the thickness, and M3's 4px gap sits between two caps
    "[--ac-linear-progress-indicator-cap:calc(var(--ac-linear-progress-indicator-thickness)/2)] [--ac-linear-progress-indicator-gap:calc(4px_+_var(--ac-linear-progress-indicator-thickness))]",
    classList
  )}
  style={`--ac-linear-progress-indicator-thickness: ${thickness}px; --ac-linear-progress-indicator-value: ${position}`}
  data-ac-linear-progress-indicator
  data-ac-linear-progress-indicator-shape={shape}
>
  <progress
    class="absolute inset-0 size-full appearance-none opacity-0"
    {...attrs}
  />
  <span
    class:list={[
      track,
      "[--ac-linear-progress-indicator-end:100%] [--ac-linear-progress-indicator-start:calc(var(--ac-linear-progress-indicator-progress)*100%_+_min(var(--ac-linear-progress-indicator-progress)*100%,var(--ac-linear-progress-indicator-gap)))]",
    ]}
    data-ac-linear-progress-indicator-part="track"
    data-ac-linear-progress-indicator-segment="1"
  ></span>
  <span
    class:list={[track, indeterminateOnly]}
    data-ac-linear-progress-indicator-part="track"
    data-ac-linear-progress-indicator-segment="2"
  ></span>
  <span
    class:list={[track, indeterminateOnly]}
    data-ac-linear-progress-indicator-part="track"
    data-ac-linear-progress-indicator-segment="3"
  ></span>
  {shape === "wavy" ? (
    // A script draws the wave, which CSS can't, from the progress, amplitude and indeterminate
    // positions the styles animate, and the phase that moves it a wavelength a second
    <svg
      class="pointer-events-none absolute inset-0 size-full overflow-visible motion-safe:animate-[ac-linear-progress-indicator-phase_1s_linear_infinite] rtl:-scale-x-100"
      aria-hidden="true"
    >
      <path
        class={wave}
        data-ac-linear-progress-indicator-part="active-indicator"
        data-ac-linear-progress-indicator-segment="1"
      ></path>
      <path
        class={wave}
        data-ac-linear-progress-indicator-part="active-indicator"
        data-ac-linear-progress-indicator-segment="2"
      ></path>
    </svg>
  ) : (
    <>
      <span
        class:list={[
          active,
          "[--ac-linear-progress-indicator-end:calc(var(--ac-linear-progress-indicator-progress)*100%)] [--ac-linear-progress-indicator-start:0px]",
        ]}
        data-ac-linear-progress-indicator-part="active-indicator"
        data-ac-linear-progress-indicator-segment="1"
      ></span>
      <span
        class:list={[active, indeterminateOnly]}
        data-ac-linear-progress-indicator-part="active-indicator"
        data-ac-linear-progress-indicator-segment="2"
      ></span>
    </>
  )}
  {showStopIndicator && (
    // M3's 4px circle at the track's end, inset as Compose's is when the track is thicker
    <span
      class="absolute end-[min(max(0px,(var(--ac-linear-progress-indicator-thickness)_-_4px)/2),6px)] top-1/2 size-[min(4px,var(--ac-linear-progress-indicator-thickness))] -translate-y-1/2 rounded-full bg-(--theme-color-primary)"
      data-ac-linear-progress-indicator-part="stop-indicator"
    ></span>
  )}
</span>

<style>
  /* Registered, so they animate: the progress and the wave's amplitude transition, the
     indeterminate lines' heads and tails run on keyframes, and the wave's phase loops */
  @property --ac-linear-progress-indicator-progress {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  @property --ac-linear-progress-indicator-amplitude {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  @property --ac-linear-progress-indicator-phase {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  @property --ac-linear-progress-indicator-head-1 {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  @property --ac-linear-progress-indicator-tail-1 {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  @property --ac-linear-progress-indicator-head-2 {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  @property --ac-linear-progress-indicator-tail-2 {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  /* A new value moves the active indicator on fast effects, which doesn't overshoot, so the
     indicator never shows more progress than there is (Compose's progress spring doesn't bounce
     either). The wave's amplitude is a shape, on fast spatial. */
  @media (prefers-reduced-motion: no-preference) {
    [data-ac-linear-progress-indicator] {
      transition:
        --ac-linear-progress-indicator-progress
          var(--theme-duration-spring-fast-effects)
          var(--ease-spring-fast-effects),
        --ac-linear-progress-indicator-amplitude
          var(--theme-duration-spring-fast-spatial)
          var(--ease-spring-fast-spatial);
    }
  }

  /* Indeterminate, at rest, one line holds still from 20% to 60% of the track, which still reads
     as work going on: under reduced motion it stays there (ADR-0003) */
  [data-ac-linear-progress-indicator]:has(progress:indeterminate) {
    --ac-linear-progress-indicator-tail-1: 0.2;
    --ac-linear-progress-indicator-head-1: 0.6;
  }

  /* Otherwise Compose's two lines run along the track: each one's head and tail move from the
     start to the end on emphasized accelerate, the first line's over 0-1000ms and 250-1250ms,
     the second's over 650-1500ms and 900-1750ms of a 1750ms cycle */
  @media (prefers-reduced-motion: no-preference) {
    [data-ac-linear-progress-indicator]:has(progress:indeterminate) {
      animation:
        ac-linear-progress-indicator-head-1 1750ms infinite,
        ac-linear-progress-indicator-tail-1 1750ms infinite,
        ac-linear-progress-indicator-head-2 1750ms infinite,
        ac-linear-progress-indicator-tail-2 1750ms infinite;
    }
  }

  /* The track runs around the two lines, a gap from each end of them: after the first line,
     between the two, and before the second */
  [data-ac-linear-progress-indicator]:has(progress:indeterminate)
    [data-ac-linear-progress-indicator-part="track"][data-ac-linear-progress-indicator-segment="1"] {
    --ac-linear-progress-indicator-start: calc(
      var(--ac-linear-progress-indicator-head-1) * 100% +
        var(--ac-linear-progress-indicator-gap) *
        clamp(0, var(--ac-linear-progress-indicator-head-1) * 1e6, 1)
    );
    --ac-linear-progress-indicator-end: 100%;
  }

  [data-ac-linear-progress-indicator]:has(progress:indeterminate)
    [data-ac-linear-progress-indicator-part="active-indicator"][data-ac-linear-progress-indicator-segment="1"] {
    --ac-linear-progress-indicator-start: calc(
      var(--ac-linear-progress-indicator-tail-1) * 100%
    );
    --ac-linear-progress-indicator-end: calc(
      var(--ac-linear-progress-indicator-head-1) * 100%
    );
  }

  [data-ac-linear-progress-indicator]:has(progress:indeterminate)
    [data-ac-linear-progress-indicator-part="track"][data-ac-linear-progress-indicator-segment="2"] {
    --ac-linear-progress-indicator-start: calc(
      var(--ac-linear-progress-indicator-head-2) * 100% +
        var(--ac-linear-progress-indicator-gap) *
        clamp(0, var(--ac-linear-progress-indicator-head-2) * 1e6, 1)
    );
    --ac-linear-progress-indicator-end: calc(
      var(--ac-linear-progress-indicator-tail-1) * 100% -
        var(--ac-linear-progress-indicator-gap) *
        clamp(0, (1 - var(--ac-linear-progress-indicator-tail-1)) * 1e6, 1)
    );
  }

  [data-ac-linear-progress-indicator]:has(progress:indeterminate)
    [data-ac-linear-progress-indicator-part="active-indicator"][data-ac-linear-progress-indicator-segment="2"] {
    --ac-linear-progress-indicator-start: calc(
      var(--ac-linear-progress-indicator-tail-2) * 100%
    );
    --ac-linear-progress-indicator-end: calc(
      var(--ac-linear-progress-indicator-head-2) * 100%
    );
  }

  [data-ac-linear-progress-indicator]:has(progress:indeterminate)
    [data-ac-linear-progress-indicator-part="track"][data-ac-linear-progress-indicator-segment="3"] {
    --ac-linear-progress-indicator-start: 0px;
    --ac-linear-progress-indicator-end: calc(
      var(--ac-linear-progress-indicator-tail-2) * 100% -
        var(--ac-linear-progress-indicator-gap) *
        clamp(0, (1 - var(--ac-linear-progress-indicator-tail-2)) * 1e6, 1)
    );
  }

  /* M3's stop indicator marks a determinate track's end only */
  [data-ac-linear-progress-indicator]:has(progress:indeterminate)
    [data-ac-linear-progress-indicator-part="stop-indicator"] {
    display: none;
  }

  @keyframes ac-linear-progress-indicator-head-1 {
    0% {
      --ac-linear-progress-indicator-head-1: 0;
      animation-timing-function: var(--ease-emphasized-accelerate);
    }
    57.142857%,
    100% {
      --ac-linear-progress-indicator-head-1: 1;
    }
  }

  @keyframes ac-linear-progress-indicator-tail-1 {
    0%,
    14.285714% {
      --ac-linear-progress-indicator-tail-1: 0;
      animation-timing-function: var(--ease-emphasized-accelerate);
    }
    71.428571%,
    100% {
      --ac-linear-progress-indicator-tail-1: 1;
    }
  }

  @keyframes ac-linear-progress-indicator-head-2 {
    0%,
    37.142857% {
      --ac-linear-progress-indicator-head-2: 0;
      animation-timing-function: var(--ease-emphasized-accelerate);
    }
    85.714286%,
    100% {
      --ac-linear-progress-indicator-head-2: 1;
    }
  }

  @keyframes ac-linear-progress-indicator-tail-2 {
    0%,
    51.428571% {
      --ac-linear-progress-indicator-tail-2: 0;
      animation-timing-function: var(--ease-emphasized-accelerate);
    }
    100% {
      --ac-linear-progress-indicator-tail-2: 1;
    }
  }

  /* The wave moves a wavelength a second, as Compose's does */
  @keyframes ac-linear-progress-indicator-phase {
    to {
      --ac-linear-progress-indicator-phase: 1;
    }
  }
</style>

<script>
  // The drawn parts read the progress's position from --ac-linear-progress-indicator-value.
  // Setting a progress's `value` (or `max`) sets its attribute, so one observer on the document
  // keeps every indicator in step, including those brought in by Astro's ClientRouter.
  new MutationObserver((records) => {
    for (const { target } of records) {
      if (
        target instanceof HTMLProgressElement &&
        target.parentElement?.matches("[data-ac-linear-progress-indicator]")
      ) {
        target.parentElement.style.setProperty(
          "--ac-linear-progress-indicator-value",
          String(Math.max(target.position, 0))
        );
      }
    }
  }).observe(document.documentElement, {
    subtree: true,
    attributes: true,
    attributeFilter: ["value", "max"],
  });

  // M3's wave: 3px either side of the track, with a 40px wavelength when determinate and 20px
  // when indeterminate. Compose draws it as alternating arches, each a quadratic curve half a
  // wavelength long, so each piece of it is drawn here as the exact quadratic.
  const amplitudePx = 3;
  const wavelengths = { determinate: 40, indeterminate: 20 };

  const wavePath = (
    from: number,
    to: number,
    shift: number,
    wavelength: number,
    amplitudeScale: number,
    centerY: number
  ) => {
    const round = (n: number) => Math.round(n * 100) / 100;
    const half = wavelength / 2;
    const peak = 4 * amplitudePx * amplitudeScale;
    // Height and slope at x, on the arch that starts at or before it
    const arch = (x: number) => {
      const index = Math.floor((x + shift) / half);
      const r = (x + shift - index * half) / half;
      const sign = index % 2 === 0 ? 1 : -1;
      return {
        index,
        y: sign * peak * r * (1 - r),
        slope: ((sign * peak) / half) * (1 - 2 * r),
      };
    };
    let x = from;
    let { index, y, slope } = arch(x);
    let d = `M${round(x)} ${round(centerY + y)}`;
    // a line no longer than its caps is a dot: a zero-length line, drawn with round caps
    if (to <= from) return `${d}L${round(x)} ${round(centerY + y)}`;
    while (x < to) {
      const next = Math.min((index + 1) * half - shift, to);
      const controlY = y + (slope * (next - x)) / 2;
      const end = arch(next);
      const endY = end.index === index ? end.y : 0;
      d += `Q${round((x + next) / 2)} ${round(centerY + controlY)} ${round(next)} ${round(centerY + endY)}`;
      x = next;
      ({ index, y, slope } = arch(x));
    }
    return d;
  };

  const draw = (root: HTMLElement) => {
    const progress = root.querySelector("progress");
    const paths = root.querySelectorAll<SVGPathElement>(
      'path[data-ac-linear-progress-indicator-part="active-indicator"]'
    );
    const svg = root.querySelector("svg");
    if (!progress || paths.length < 2 || !svg) return;
    const style = getComputedStyle(root);
    const read = (name: string) =>
      parseFloat(
        style.getPropertyValue(`--ac-linear-progress-indicator-${name}`)
      );
    const width = root.clientWidth;
    const thickness = read("thickness");
    const cap = thickness / 2;
    const centerY = root.clientHeight / 2;
    const phase = parseFloat(
      getComputedStyle(svg).getPropertyValue(
        "--ac-linear-progress-indicator-phase"
      )
    );
    const isIndeterminate = progress.matches(":indeterminate");
    const wavelength = isIndeterminate
      ? wavelengths.indeterminate
      : wavelengths.determinate;
    // the share of M3's amplitude the wave has, 0 when flat
    const amplitudeScale = isIndeterminate
      ? 1
      : Math.min(Math.max(read("amplitude"), 0), 1);
    // Each line runs between two fractions of the track, its ends clamped a cap inside it
    const lines = isIndeterminate
      ? [
          [read("tail-1"), read("head-1")],
          [read("tail-2"), read("head-2")],
        ]
      : [
          [0, read("progress")],
          [0, 0],
        ];
    const clamp = (x: number) => Math.min(Math.max(x, cap), width - cap);
    lines.forEach(([tail, head], i) => {
      const d =
        head > tail
          ? wavePath(
              clamp(tail * width),
              clamp(head * width),
              (phase || 0) * wavelength,
              wavelength,
              amplitudeScale,
              centerY
            )
          : "";
      if (paths[i].getAttribute("d") !== d) paths[i].setAttribute("d", d);
    });
  };

  // One loop draws every wavy indicator on the page, while there are any. The browser pauses it
  // in a background tab.
  let frame = 0;
  const loop = () => {
    const roots = document.querySelectorAll<HTMLElement>(
      '[data-ac-linear-progress-indicator-shape="wavy"]'
    );
    roots.forEach(draw);
    frame = roots.length ? requestAnimationFrame(loop) : 0;
  };
  const start = () => {
    if (!frame) loop();
  };
  start();
  document.addEventListener("astro:after-swap", start);
</script>
