---
import type { ComponentProps } from "astro/types";
import { twMerge } from "tailwind-merge";
import BaseOverlay from "./BaseOverlay.astro";
import Icon from "./Icon.astro";
import { popoverBgColors, type PopoverBgColorType } from "../types";

type BaseOverlayProps = ComponentProps<typeof BaseOverlay>;

type Props = Omit<BaseOverlayProps, "bgColor"> & {
  bgColor?: PopoverBgColorType;
  showCloseX?: boolean;
};

const {
  as = "div",
  id,
  class: classList,
  showCloseX = false,
  ...attrs
} = Astro.props;

// A surface outside a popover's fails the build, rather than drawing something other than was
// asked for (ADR-0021). BaseOverlay checks the rest of its props.
// A list's values as "a", "b" and "c", for the messages below
const quoted = (values: readonly string[]) =>
  values
    .map((value) => `"${value}"`)
    .join(", ")
    .replace(/, (?=[^,]*$)/, " and ");
if (
  attrs.bgColor !== undefined &&
  !(popoverBgColors as readonly string[]).includes(attrs.bgColor)
) {
  throw new Error(
    `Popover: M3's popover surfaces are ${quoted(popoverBgColors)}, but this one's \`bgColor\` is "${attrs.bgColor}".`
  );
}
---

<BaseOverlay
  {as}
  class:list={twMerge(
    "rounded-xl border border-(--theme-color-outline-variant) p-4",
    showCloseX && "m-5 expanded:mx-7 expanded:my-6 large:mx-9 large:my-7",
    classList
  )}
  {id}
  popover
  {...attrs}
>
  <slot />

  {showCloseX && (
    <button
      class:list={[
        "grid size-11 cursor-pointer place-items-center rounded-full border border-(--theme-color-outline-variant) bg-inherit expanded:size-11 large:size-12",
        "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-offset-2 focus-visible:ring-offset-(--theme-color-wrapper-bg)",
        "fixed top-[calc(anchor(top)-1rem)] right-[calc(anchor(right)-1rem)] expanded:top-[calc(anchor(top)-1.125rem)] expanded:right-[calc(anchor(right)-1.125rem)] large:top-[calc(anchor(top)-1.25rem)] large:right-[calc(anchor(right)-1.25rem)]",
        "[position-anchor:var(--ac-anchorname-overlay)]",
        // M3 icon-button hover: an 8% state layer in the icon's color, so it works on any surface.
        "before:absolute before:inset-0 before:rounded-full before:bg-current before:opacity-0 hover:before:opacity-8 motion-safe:before:transition-opacity",
      ]}
      type="button"
      commandfor={id}
      command="hide-popover"
      aria-label="Close"
    >
      <Icon class="size-4" name="close" />
    </button>
  )}
</BaseOverlay>
