---
import type { HTMLAttributes } from "astro/types";
import ListItemBase, { type ListItemContent } from "./ListItemBase.astro";

// An M3 Expressive list item with a checkbox, for a multi-select List: a <label> around a native
// checkbox, so the whole item toggles it and it submits with its form (ADR-0028). A checked item
// is highlighted. Every attribute but `class` goes on the input (`name`, `value`, `checked`,
// `disabled`, `required`, `aria-*`), and `class` on the item. ListItemBase draws it.
type Props = Omit<HTMLAttributes<"input">, "type"> &
  ListItemContent & {
    // The checkbox's end of the item: leading, as Compose's samples place it, or trailing
    controlPosition?: "leading" | "trailing";
  };

const { controlPosition = "leading", ...attrs }: Props = Astro.props;
---

<ListItemBase control="checkbox" controlPosition={controlPosition} {...attrs}>
  {Astro.slots.has("avatar") && <slot name="avatar" slot="avatar" />}
  {Astro.slots.has("image") && <slot name="image" slot="image" />}
  {Astro.slots.has("video") && <slot name="video" slot="video" />}
</ListItemBase>
