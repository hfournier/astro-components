---
import type { HTMLTag, Polymorphic } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { BgColorType } from "../../types";

type Props<
  Tag extends Extract<
    HTMLTag,
    | "article"
    | "aside"
    | "div"
    | "figure"
    | "footer"
    | "header"
    | "main"
    | "section"
  > = "div",
> = Polymorphic<{
  as: Tag;
  bgColor?: BgColorType;
}>;
// Same two-read polymorphic pattern as Button: `as` read untyped so `Tag` keeps the full union.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { as: Tag = "div" }: any = Astro.props;
const {
  // Destructured only to keep `as` out of `attrs`, so it isn't rendered as an attribute.
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  as: _as,
  bgColor = "transparent",
  class: classList,
  ...attrs
} = Astro.props;
// Each background also sets --theme-color-wrapper-bg, which descendants read for things that
// must match the surface behind them - e.g. focus-ring offsets (ring-offset-(--theme-color-wrapper-bg)).
// `transparent` leaves it alone, so they inherit the nearest wrapper's (or the page's) value.
const colorClasses = {
  "primary-container":
    "[--theme-color-wrapper-bg:var(--theme-color-primary-container)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-primary-container)",
  "primary-fixed":
    "[--theme-color-wrapper-bg:var(--theme-color-primary-fixed)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-primary-fixed)",
  "primary-fixed-dim":
    "[--theme-color-wrapper-bg:var(--theme-color-primary-fixed-dim)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-primary-fixed)",
  "secondary-container":
    "[--theme-color-wrapper-bg:var(--theme-color-secondary-container)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-secondary-container)",
  "secondary-fixed":
    "[--theme-color-wrapper-bg:var(--theme-color-secondary-fixed)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-secondary-fixed)",
  "secondary-fixed-dim":
    "[--theme-color-wrapper-bg:var(--theme-color-secondary-fixed-dim)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-secondary-fixed)",
  "tertiary-container":
    "[--theme-color-wrapper-bg:var(--theme-color-tertiary-container)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-tertiary-container)",
  "tertiary-fixed":
    "[--theme-color-wrapper-bg:var(--theme-color-tertiary-fixed)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-tertiary-fixed)",
  "tertiary-fixed-dim":
    "[--theme-color-wrapper-bg:var(--theme-color-tertiary-fixed-dim)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-tertiary-fixed)",
  "surface-dim":
    "[--theme-color-wrapper-bg:var(--theme-color-surface-dim)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-surface)",
  "surface-bright":
    "[--theme-color-wrapper-bg:var(--theme-color-surface-bright)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-surface)",
  "inverse-surface":
    "[--theme-color-wrapper-bg:var(--theme-color-inverse-surface)] bg-(--theme-color-wrapper-bg) text-(--theme-color-inverse-on-surface)",
  "surface-container-lowest":
    "[--theme-color-wrapper-bg:var(--theme-color-surface-container-lowest)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-surface)",
  "surface-container-low":
    "[--theme-color-wrapper-bg:var(--theme-color-surface-container-low)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-surface)",
  "surface-container":
    "[--theme-color-wrapper-bg:var(--theme-color-surface-container)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-surface)",
  "surface-container-high":
    "[--theme-color-wrapper-bg:var(--theme-color-surface-container-high)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-surface)",
  "surface-container-highest":
    "[--theme-color-wrapper-bg:var(--theme-color-surface-container-highest)] bg-(--theme-color-wrapper-bg) text-(--theme-color-on-surface)",
  transparent: "",
}[bgColor];
---

<Tag
  class:list={twMerge(colorClasses, classList)}
  data-ac-wrapper={bgColor}
  {...attrs}
>
  <slot />
</Tag>

<style>
  /* Link and focus-ring colors per background. M3 has no link role: primary (tone 40/80) is readable on the
     surfaces, but not on every background a wrapper can set, so each maps links to the role
     that stays readable there. Hover keeps the same color - Link signals hover with its
     underline. --theme-color-focus-ring-on-bg
     (used by Button and Link) follows the link where secondary wouldn't contrast. transparent
     sets nothing, so links inherit from the nearest wrapper (or the page). */
  [data-ac-wrapper^="surface"] {
    --theme-color-link-text: var(--theme-color-primary);
    --theme-color-focus-ring-on-bg: var(--theme-color-secondary);
  }

  /* Container tones depend on the scheme variant (Fidelity/Content tint them from the source
     color), so only their on-color is guaranteed to contrast - for the link and its focus ring. */
  [data-ac-wrapper="primary-container"] {
    --theme-color-link-text: var(--theme-color-on-primary-container);
    --theme-color-focus-ring-on-bg: var(--theme-color-on-primary-container);
  }

  [data-ac-wrapper="secondary-container"] {
    --theme-color-link-text: var(--theme-color-on-secondary-container);
    --theme-color-focus-ring-on-bg: var(--theme-color-on-secondary-container);
  }

  [data-ac-wrapper="tertiary-container"] {
    --theme-color-link-text: var(--theme-color-on-tertiary-container);
    --theme-color-focus-ring-on-bg: var(--theme-color-on-tertiary-container);
  }

  /* Fixed backgrounds stay light in dark mode, where primary/secondary (tone 80) would vanish. */
  [data-ac-wrapper^="primary-fixed"] {
    --theme-color-link-text: var(--theme-color-on-primary-fixed-variant);
    --theme-color-focus-ring-on-bg: var(--theme-color-on-primary-fixed-variant);
  }

  [data-ac-wrapper^="secondary-fixed"] {
    --theme-color-link-text: var(--theme-color-on-secondary-fixed-variant);
    --theme-color-focus-ring-on-bg: var(
      --theme-color-on-secondary-fixed-variant
    );
  }

  [data-ac-wrapper^="tertiary-fixed"] {
    --theme-color-link-text: var(--theme-color-on-tertiary-fixed-variant);
    --theme-color-focus-ring-on-bg: var(
      --theme-color-on-tertiary-fixed-variant
    );
  }

  /* inverse-primary exists for exactly this: actions on inverse-surface (e.g. a snackbar's). */
  [data-ac-wrapper="inverse-surface"] {
    --theme-color-link-text: var(--theme-color-inverse-primary);
    --theme-color-focus-ring-on-bg: var(--theme-color-inverse-primary);
  }
</style>
