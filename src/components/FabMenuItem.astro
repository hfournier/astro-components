---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { SvgIconNameTypes } from "../svgs";
import Button from "./Button.astro";

// One action in a FabMenu. M3's item metrics are its medium button's, which is Button's md, round
// size (56px high, 24px side padding, a 24px leading icon 8px from the label, Title Medium); the
// item adds the menu's color set (custom properties FabMenu sets), elevation 3, and the marker
// FabMenu counts its items by and closes on, carrying the label and icon for the MenuItem FabMenu
// shows in their place in large windows.
type Props = Omit<HTMLAttributes<"button">, "slot"> & {
  icon: SvgIconNameTypes;
  label: string;
};

const { icon, label, class: classList, ...attrs } = Astro.props;
---

<Button
  size="md"
  shape="round"
  {icon}
  class={twMerge(
    // no border: a filled Button draws one in its container color, which would add 1px to the padding
    "border-0 bg-(--ac-fab-menu-container) text-(--ac-fab-menu-on-container)",
    // elevation 3, hovered too (Button raises a filled button to 1 on hover)
    "shadow-theme-elevation-3 not-disabled:hover:shadow-theme-elevation-3",
    // Opening, each fades in and grows in width from the menu's aligned edge (FabMenu's clip
    // inset), nearest the FAB (the last item) first; closing reverses it. The open clip reaches
    // past the item so it doesn't cut off the shadow.
    "opacity-0 [clip-path:var(--ac-fab-menu-item-clip)] group-open/fab-menu-items:opacity-100 group-open/fab-menu-items:[clip-path:inset(-1.5rem)]",
    "motion-safe:starting:group-open/fab-menu-items:opacity-0 motion-safe:starting:group-open/fab-menu-items:[clip-path:var(--ac-fab-menu-item-clip)]",
    // As Compose's items: the fade on M3's fast effects spring, the width on its fast spatial one,
    // each after the item's delay (the shorthand would reset a separate transition-delay)
    "motion-safe:[transition:opacity_var(--theme-duration-spring-fast-effects)_var(--ease-spring-fast-effects)_var(--ac-fab-menu-item-delay),clip-path_var(--theme-duration-spring-fast-spatial)_var(--ease-spring-fast-spatial)_var(--ac-fab-menu-item-delay)]",
    // Each starts at its place in FabMenu's stagger span, counted from the FAB when opening (the
    // last item first) and from the top when closing: halfway through its share of the span
    "[--ac-fab-menu-item-delay:calc((sibling-index()_-_0.5)_/_sibling-count()_*_var(--ac-fab-menu-stagger-span))] group-open/fab-menu-items:[--ac-fab-menu-item-delay:calc((sibling-count()_-_sibling-index()_+_0.5)_/_sibling-count()_*_var(--ac-fab-menu-stagger-span))]",
    classList
  )}
  data-ac-fab-menu-item
  data-ac-fab-menu-item-label={label}
  data-ac-fab-menu-item-icon={icon}
  {...attrs}
>
  {label}
</Button>
