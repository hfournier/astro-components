---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;
const { class: classList, ...attrs } = Astro.props;
---

<a
  class:list={[
    "text-primary-control hover:text-primary-control-hover underline-offset-2 hover:underline",
    classList,
  ]}
  {...attrs}
>
  <slot />
</a>
