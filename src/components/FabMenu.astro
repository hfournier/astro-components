---
import type { HTMLAttributes } from "astro/types";
import {
  COMMENT_NODE,
  ELEMENT_NODE,
  TEXT_NODE,
  parse,
  walkSync,
  type Node,
} from "ultrahtml";
import crypto from "node:crypto";
import { twMerge } from "tailwind-merge";
import type { SvgIconNameTypes } from "../svgs";
import Icon from "./Icon.astro";
import Menu from "./Menu.astro";
import MenuItem from "./MenuItem.astro";

// An M3 FAB menu: a FAB that opens a stack of 2-6 FabMenuItems above it and becomes their close
// button while they're open. The items are an auto popover the FAB toggles, which gives the FAB's
// expanded state, Escape, light dismiss, focus return and the top layer without script; the
// script closes the menu once an item is chosen, and moves Down from the FAB to the first item.
//
// From the large window size class up, it follows M3's web guidance instead: "On web, the FAB menu
// uses a menu component", which "inherits its states and specs from the baseline menu component".
// A second FAB, the same but for the morph, opens a Menu of the same items, 4px away; CSS shows
// one FAB or the other, so assistive tech only ever meets one.
type Props = Omit<HTMLAttributes<"div">, "id"> & {
  // the items' popover id, which the FAB toggles
  id: string;
  icon: SvgIconNameTypes;
  // the FAB's accessible name; never shown, as M3 doesn't open a FAB menu from an extended FAB
  label: string;
  size?: "default" | "md" | "lg";
  color?: "primary" | "secondary" | "tertiary";
  // which edge of the FAB the items line up with
  align?: "end" | "start";
};

const {
  id,
  icon,
  label,
  size = "default",
  color = "primary",
  align = "end",
  class: classList,
  ...attrs
} = Astro.props;

const slot = Astro.slots.has("default")
  ? await Astro.slots.render("default")
  : "";

// Each FabMenuItem must be a direct child, as Tabs requires of its Tabs: anything else (other than
// whitespace, comments and scripts) throws rather than ending up in the menu. A script is
// Button's own, which Astro renders beside the first Button on the page.
const isItem = (node: Node) =>
  node.type === ELEMENT_NODE &&
  node.attributes["data-ac-fab-menu-item"] !== undefined;
// What the Menu shows for each item in large windows: its label and icon, and whether it's disabled
const menuItems: {
  label: string;
  icon: SvgIconNameTypes;
  isDisabled: boolean;
}[] = [];
for (const node of parse(slot).children as Node[]) {
  if (node.type === COMMENT_NODE) continue;
  if (node.type === ELEMENT_NODE && node.name === "script") continue;
  if (node.type === TEXT_NODE && node.value.trim() === "") continue;
  if (!isItem(node)) {
    let hasItem = false;
    walkSync(node, (child) => {
      hasItem ||= isItem(child);
    });
    const found =
      node.type === ELEMENT_NODE
        ? `${hasItem ? "a FabMenuItem wrapped in " : ""}<${node.name}>`
        : `"${node.value.trim().replace(/\s+/g, " ").slice(0, 40)}"`;
    throw new Error(
      `FabMenu: found ${found}, but only FabMenuItem components can go in FabMenu, each as a direct child (not wrapped in another element or component).`
    );
  }
  menuItems.push({
    label: node.attributes["data-ac-fab-menu-item-label"],
    icon: node.attributes["data-ac-fab-menu-item-icon"],
    isDisabled: node.attributes.disabled !== undefined,
  });
}
if (menuItems.length < 2 || menuItems.length > 6) {
  throw new Error(
    `FabMenu: expected 2 to 6 FabMenuItems, as M3 specifies, but found ${menuItems.length}.`
  );
}
const menuId = `${id}-menu`;

const anchorName = `--anchorname-${crypto.randomUUID()}-fab-menu`;

// M3's color sets: the closed FAB and the items on the container role, the close button (the open
// FAB) on the main role. The items read theirs from these custom properties.
const colorClasses = {
  primary:
    "[--ac-fab-menu-container:var(--theme-color-primary-container)] [--ac-fab-menu-on-container:var(--theme-color-on-primary-container)] [--ac-fab-menu-close:var(--theme-color-primary)] [--ac-fab-menu-on-close:var(--theme-color-on-primary)]",
  secondary:
    "[--ac-fab-menu-container:var(--theme-color-secondary-container)] [--ac-fab-menu-on-container:var(--theme-color-on-secondary-container)] [--ac-fab-menu-close:var(--theme-color-secondary)] [--ac-fab-menu-on-close:var(--theme-color-on-secondary)]",
  tertiary:
    "[--ac-fab-menu-container:var(--theme-color-tertiary-container)] [--ac-fab-menu-on-container:var(--theme-color-on-tertiary-container)] [--ac-fab-menu-close:var(--theme-color-tertiary)] [--ac-fab-menu-on-close:var(--theme-color-on-tertiary)]",
}[color];

// The menu keeps the closed FAB's size, so it doesn't move what's around it as the FAB shrinks into
// the close button. As M3 specifies, the two share the FAB's top corner on the `align` side, and
// the items open from there, so a larger FAB's menu sits higher.
const menuClasses = {
  default: "size-14",
  md: "size-20",
  lg: "size-24",
}[size];

// Fab's sizes and corners: M3 FAB, medium FAB and large FAB
const fabClasses = {
  default: "size-14 rounded-2xl",
  md: "size-20 rounded-[20px]",
  lg: "size-24 rounded-[28px]",
}[size];

const iconSizeClasses = {
  default: "size-6",
  md: "size-7",
  lg: "size-8",
}[size];

// The items stack upward from 8px above the FAB, lined up with its `align` edge, which is the
// other physical side right to left (M3 mirrors the menu). The list reaches 16px past that edge,
// so its padding (it scrolls, so it clips) has room for the items' shadows and focus rings. Each
// item grows in width from that edge as it opens (a clip-path inset, which the items read).
// Anchor insets rather than position-area, which Firefox places wrongly right to left.
const alignClasses = {
  end: {
    menu: "justify-items-end",
    popover: [
      "right-[calc(anchor(right)-1rem)] items-end rtl:right-auto rtl:left-[calc(anchor(left)-1rem)]",
      "[--ac-fab-menu-item-clip:inset(0_0_0_100%)] rtl:[--ac-fab-menu-item-clip:inset(0_100%_0_0)]",
    ],
  },
  start: {
    menu: "justify-items-start",
    popover: [
      "left-[calc(anchor(left)-1rem)] items-start rtl:left-auto rtl:right-[calc(anchor(right)-1rem)]",
      "[--ac-fab-menu-item-clip:inset(0_100%_0_0)] rtl:[--ac-fab-menu-item-clip:inset(0_0_0_100%)]",
    ],
  },
}[align];

// Both icons share one grid cell, so they cross-fade (and turn) as the FAB becomes the close button.
// Compose drives the whole morph, icon included, from one fast spatial spring.
const iconClasses =
  "[grid-area:1/1] motion-safe:transition-[opacity,rotate] motion-safe:duration-(--theme-duration-spring-fast-spatial) motion-safe:ease-spring-fast-spatial";

// The FAB, in both forms
const fabBaseClasses = [
  "cursor-pointer place-items-center [grid-area:1/1]",
  "bg-(--ac-fab-menu-container) text-(--ac-fab-menu-on-container)",
  // M3: elevation level 3 at rest, focused and pressed; level 4 on hover
  "shadow-theme-elevation-3 hover:shadow-theme-elevation-4 active:shadow-theme-elevation-3",
  // M3 state layer, in the icon's color
  "relative isolate before:absolute before:inset-0 before:-z-10 before:rounded-[inherit] before:bg-current before:opacity-0",
  "hover:before:opacity-8 focus-visible:before:opacity-10 active:before:opacity-10",
  "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-offset-2 focus-visible:ring-offset-(--theme-color-wrapper-bg)",
  fabClasses,
];
---

<div
  class:list={twMerge(
    "group/fab-menu relative grid items-start",
    colorClasses,
    menuClasses,
    alignClasses.menu,
    classList
  )}
  data-ac-fab-menu
  {...attrs}
>
  <button
    class:list={[
      "grid large:hidden",
      fabBaseClasses,
      // Open, it's M3's close button: 56px, fully round, on the color set's main role
      "group-has-open/fab-menu:size-14 group-has-open/fab-menu:rounded-[28px] group-has-open/fab-menu:bg-(--ac-fab-menu-close) group-has-open/fab-menu:text-(--ac-fab-menu-on-close)",
      // The morph (size, corners, colors) on M3's fast spatial spring, as Compose's toggle FAB;
      // the hover elevation is on fast effects, as Fab's. One duration and easing per property.
      "motion-safe:transition-[width,height,border-radius,background-color,color,box-shadow] motion-safe:before:transition-opacity",
      "motion-safe:duration-[var(--theme-duration-spring-fast-spatial),var(--theme-duration-spring-fast-spatial),var(--theme-duration-spring-fast-spatial),var(--theme-duration-spring-fast-spatial),var(--theme-duration-spring-fast-spatial),var(--theme-duration-spring-fast-effects)]",
      "motion-safe:ease-[var(--ease-spring-fast-spatial),var(--ease-spring-fast-spatial),var(--ease-spring-fast-spatial),var(--ease-spring-fast-spatial),var(--ease-spring-fast-spatial),var(--ease-spring-fast-effects)]",
    ]}
    style={`anchor-name: ${anchorName}`}
    type="button"
    commandfor={id}
    command="toggle-popover"
  >
    <Icon
      class:list={[
        iconClasses,
        iconSizeClasses,
        "group-has-open/fab-menu:rotate-90 group-has-open/fab-menu:opacity-0",
      ]}
      name={icon}
    />
    <Icon
      class:list={[
        iconClasses,
        "size-5 -rotate-90 opacity-0 group-has-open/fab-menu:rotate-0 group-has-open/fab-menu:opacity-100",
      ]}
      name="close"
    />
    <span class="sr-only">{label}</span>
  </button>

  {
    /* In large windows: the FAB opening the Menu. As M3's menu guidelines ask of a trigger, it
       stays as it is while the menu is open, with the pressed state layer. */
  }
  <button
    class:list={[
      "hidden large:grid",
      fabBaseClasses,
      "aria-expanded:before:opacity-10",
      "motion-safe:transition-[box-shadow] motion-safe:duration-(--theme-duration-spring-fast-effects) motion-safe:ease-spring-fast-effects motion-safe:before:transition-opacity",
    ]}
    type="button"
    commandfor={menuId}
    command="toggle-popover"
  >
    <Icon class={iconSizeClasses} name={icon} />
    <span class="sr-only">{label}</span>
  </button>

  {
    /* No surface of its own (so not BaseOverlay): only the items' containers show. Closed, it
       stays rendered (transition-discrete) until the last item has finished closing.

       It's as tall as its items, up to the space above the FAB, which the script keeps in
       --ac-fab-menu-room (CSS can't: anchor() only sets insets, and Firefox shifts a box with
       its anchor's scrolling, so a `top` inset doesn't hold). Its top padding keeps M3's 16px
       margin from the top of the window. In a window too short for its items, the list scrolls,
       as M3 specifies, and never covers the close button. No scrollbar, as in Compose: the
       cut-off item shows it scrolls, and focus scrolls each item into view. It keeps room for
       one item, so a FAB scrolled to the top of the window still shows its menu, running off
       the top. */
  }
  <div
    class:list={[
      "group/fab-menu-items inset-auto m-0 flex-col gap-1 border-0 bg-transparent px-4 pt-4 pb-2 open:flex",
      "bottom-[anchor(top)] max-h-[max(5rem,var(--ac-fab-menu-room))] scrollbar-none overflow-y-auto",
      // How long the items take to start, one after another. Compose shows them by animating the
      // number shown on M3's slow effects spring, so each starts as the count passes it; spread
      // evenly over this span, each starts within 20ms of Compose's, for any number of items.
      "[--ac-fab-menu-stagger-span:140ms]",
      // stays rendered until the last item to start has finished closing
      "motion-safe:transition-[display,overlay] motion-safe:transition-discrete motion-safe:duration-[calc(var(--ac-fab-menu-stagger-span)+var(--theme-duration-spring-fast-spatial))]",
      alignClasses.popover,
    ]}
    style={`position-anchor: ${anchorName}`}
    {id}
    popover="auto"
  >
    <Fragment set:html={slot} />
  </div>

  {
    /* In large windows: the items as a Menu, lined up with the FAB's `align` edge (see Menu). Each
       MenuItem stands in for its FabMenuItem, which it clicks, so the item's own handlers and
       command run. Only the label, icon and disabled state carry over. */
  }
  <Menu id={menuId} data-ac-menu-align={align}>
    {
      menuItems.map((item, index) => (
        <MenuItem
          label={item.label}
          icon={item.icon}
          isDisabled={item.isDisabled}
          data-ac-fab-menu-item-index={index}
        />
      ))
    }
  </Menu>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-ac-fab-menu]")
    .forEach((menu) => {
      const popover = menu.querySelector<HTMLElement>(
        ":scope > [popover]:not([data-ac-menu])"
      )!;
      const largeMenu = menu.querySelector<HTMLElement>(
        ":scope > [data-ac-menu]"
      )!;
      const fabFor = (target: HTMLElement) =>
        menu.querySelector<HTMLButtonElement>(
          `:scope > [commandfor="${CSS.escape(target.id)}"]`
        )!;
      const toggle = fabFor(popover);
      const items = Array.from(
        popover.querySelectorAll<HTMLButtonElement>("[data-ac-fab-menu-item]")
      );

      // In large windows, choosing a MenuItem clicks its FabMenuItem, running the item's own
      // handlers and command; the Menu then closes itself
      largeMenu.addEventListener("click", (event) => {
        const chosen = (event.target as Element).closest<HTMLElement>(
          "[data-ac-fab-menu-item-index]"
        );
        if (chosen) items[Number(chosen.dataset.acFabMenuItemIndex)]?.click();
      });

      // Crossing the large window size class swaps one FAB for the other, so whichever menu is
      // open closes, its FAB being gone, and focus in either moves to the FAB now shown. The
      // width repeats theme.css's --breakpoint-large (ADR-0014).
      const large = matchMedia("(width >= 75rem)");
      large.addEventListener("change", () => {
        const hadFocus = menu.contains(document.activeElement);
        if (popover.matches(":popover-open")) popover.hidePopover();
        if (largeMenu.matches(":popover-open")) largeMenu.hidePopover();
        if (hadFocus) fabFor(large.matches ? largeMenu : popover).focus();
      });

      // Closing with focus in the menu returns it to the FAB. The popover does this itself, but
      // only to the element that had focus when it opened, and in Safari a click doesn't focus
      // a button, so it would go to the page instead. Moving it before the popover hides leaves
      // the popover nothing to restore. A click outside, on something that can't take focus,
      // has already dropped focus to the page by the time the popover closes, so whether focus
      // was in the menu is noted as the press starts; a click on something that takes focus
      // keeps it there.
      let isPressFromInside = false;
      document.addEventListener(
        "pointerdown",
        () => (isPressFromInside = popover.contains(document.activeElement)),
        { capture: true }
      );
      popover.addEventListener("beforetoggle", (event) => {
        if (event.newState !== "closed") return;
        const active = document.activeElement;
        if (
          popover.contains(active) ||
          (isPressFromInside && (!active || active === document.body))
        )
          toggle.focus();
        isPressFromInside = false;
      });

      // Down from the open FAB moves to the top item, as Tab does (Compose's focus order)
      toggle.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowDown" || !popover.matches(":popover-open"))
          return;
        event.preventDefault();
        items[0]!.focus();
      });

      // The list's padding, around the items, is outside the menu as far as a click goes
      popover.addEventListener("click", (event) => {
        if (event.target === popover) popover.hidePopover();
      });

      // While it's open, the list may be as tall as the space above the FAB, which changes as the
      // page scrolls (unless the FAB is fixed) or the window resizes
      const fitList = () =>
        popover.style.setProperty(
          "--ac-fab-menu-room",
          `${toggle.getBoundingClientRect().top}px`
        );
      popover.addEventListener("beforetoggle", (event) => {
        if (event.newState === "open") {
          fitList();
          window.addEventListener("scroll", fitList, {
            capture: true,
            passive: true,
          });
          window.addEventListener("resize", fitList, { passive: true });
        } else {
          window.removeEventListener("scroll", fitList, { capture: true });
          window.removeEventListener("resize", fitList);
        }
      });

      // Choosing an item closes the menu, once the click has run every handler and the item's
      // own command (not `command="hide-popover"` on the items, which may need `command` for the
      // action). Focus is still in the menu, so closing returns it to the FAB, unless the action
      // has moved it elsewhere, such as into a dialog it opened.
      popover.addEventListener("click", (event) => {
        if (!(event.target as Element).closest("[data-ac-fab-menu-item]"))
          return;
        setTimeout(() => {
          if (popover.matches(":popover-open")) popover.hidePopover();
        });
      });
    });
</script>
