---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import { loadingIndicatorFirstFrame } from "../shapes";
// The morph and turn keyframes, generated from ../shapes by `pnpm generate:progress-loading`.
// Imported, so a page gets them once however many indicators it has.
import "./ProgressLoading.css";

// A native progress element with no value, so assistive tech announces it as a busy progress
// bar. Every attribute but `class` goes on the progress (`aria-label`, `aria-labelledby`), and
// `class` on the element around it, which draws M3's parts. It has no value: M3's loading
// indicator doesn't turn into a determinate one.
type Props = Omit<HTMLAttributes<"progress">, "value" | "max"> & {
  // M3's optional container, a primary-container circle behind the active indicator, for when it
  // sits over other content
  showContainer?: boolean;
  // The container's size in px, from M3's 24 to 240; M3's is 48. The active indicator keeps its
  // 38/48 share of it.
  size?: number;
};

const {
  showContainer = false,
  size = 48,
  class: classList,
  ...attrs
}: Props = Astro.props;

// A size outside M3's fails the build, rather than drawing something other than was asked for.
// MDX passes attributes as strings, so `size="96"` is read as the number it says.
const side = Number(size);
if (!Number.isFinite(side) || side < 24 || side > 240) {
  throw new Error(
    `ProgressLoading: M3's loading indicators are 24 to 240px, but this one's \`size\` is ${size}.`
  );
}

// Compose's first frame: SoftBurst, a quarter turn round. Under reduced motion it stays there.
const firstFrame = loadingIndicatorFirstFrame();
---

<span
  class:list={twMerge(
    "relative inline-block size-(--ac-progress-loading-size) shrink-0 rounded-full align-middle",
    showContainer && "bg-(--theme-color-primary-container)",
    classList
  )}
  style={`--ac-progress-loading-size: ${side}px;`}
  data-ac-progress-loading
>
  <progress
    class="absolute inset-0 size-full appearance-none opacity-0"
    {...attrs}
  />
  {/* The whole indicator turns once every 4666ms, as Compose's does. It isn't mirrored in
      right-to-left layouts: like M3's circular progress indicator, it turns clockwise. */}
  <span
    class="pointer-events-none absolute inset-0 motion-safe:animate-[ac-progress-loading-rotation_4666ms_linear_infinite]"
    aria-hidden="true"
  >
    {/* The active indicator: its color, clipped to the shape. It morphs through Compose's
        sequence, a morph every 650ms, adding a quarter turn with each, on Compose's spring;
        the keyframes are computed at build time (see loadingIndicatorKeyframes). The first
        frame and its quarter turn are its own, which an animation overrides. A browser without
        shape() (Baseline only from 2026) keeps the circle before it instead, the active
        indicator's 38/48 of the box, rather than drawing the unclipped square. */}
    <span
      class:list={[
        "absolute inset-0 rotate-90",
        "motion-safe:animate-[ac-progress-loading-morph_4550ms_linear_infinite,ac-progress-loading-turn_2600ms_linear_infinite]",
        showContainer
          ? "bg-(--theme-color-on-primary-container)"
          : "bg-(--theme-color-primary)",
      ]}
      style={`clip-path: circle(39.58%); clip-path: ${firstFrame}`}
      data-ac-progress-loading-part="active-indicator"
    ></span>
  </span>
</span>

<style>
  @keyframes ac-progress-loading-rotation {
    to {
      rotate: 360deg;
    }
  }
</style>
