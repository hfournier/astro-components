---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import { tabTransitions, type TabTransitionType } from "../types";
import type { SvgIconNameTypes } from "../svgs";

type Props = HTMLAttributes<"div"> & {
  badgeDescription?: string;
  badgeLabel?: string;
  icon?: SvgIconNameTypes;
  label: string;
  transition?: TabTransitionType;
};

const {
  badgeDescription,
  badgeLabel,
  icon,
  label,
  transition = "fade",
  class: classList,
  ...attrs
} = Astro.props;

// Values outside these fail the build, rather than drawing something other than was asked for
// (ADR-0021)
// A list's values as "a", "b" and "c", for the messages below
const quoted = (values: readonly string[]) =>
  values
    .map((value) => `"${value}"`)
    .join(", ")
    .replace(/, (?=[^,]*$)/, " and ");
if (!(tabTransitions as readonly string[]).includes(transition)) {
  throw new Error(
    `Tab: its transitions are ${quoted(tabTransitions)}, but this one's \`transition\` is "${transition}".`
  );
}

// M3's enter and exit pattern (ADR-0018): a panel comes in on emphasized decelerate over
// medium 4 as its hidden attribute goes, and leaves on emphasized accelerate over short 4
const enterExitClasses = `motion-safe:duration-(--theme-duration-medium-4) motion-safe:ease-emphasized-decelerate motion-safe:[[hidden]]:duration-(--theme-duration-short-4) motion-safe:[[hidden]]:ease-emphasized-accelerate`;

const transitionClasses = {
  fade: `motion-safe:transition-[display,opacity] motion-safe:transition-discrete ${enterExitClasses} motion-safe:starting:opacity-0`,
  "fade-up": `motion-safe:transition-[display,opacity,translate] motion-safe:transition-discrete ${enterExitClasses} motion-safe:starting:translate-y-full motion-safe:starting:opacity-0`,
  "slide-left": `motion-safe:transition-[display,opacity,translate] motion-safe:transition-discrete ${enterExitClasses} motion-safe:starting:translate-x-full motion-safe:starting:opacity-0`,
}[transition];
---

<div
  class:list={twMerge(
    "[grid-area:stack] [[hidden]]:opacity-0",
    "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-inset",
    transitionClasses,
    classList
  )}
  tabindex="0"
  role="tabpanel"
  data-ac-tabpanel
  data-ac-tab-badge={badgeLabel}
  data-ac-tab-badge-description={badgeDescription}
  data-ac-tab-icon={icon}
  data-ac-tab-label={label}
  {...attrs}
>
  <slot />
</div>
