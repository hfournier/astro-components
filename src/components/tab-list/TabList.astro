---
import { twMerge } from "tailwind-merge";

type Props = {
  randomId: string;
  labels: string[];
};

const { randomId, labels } = Astro.props;
---

<div
  class:list={twMerge(
    "border-divider flex border-b-(length:--border-width-divider)"
  )}
  role="tablist"
  style={`--hfdev-anchorname-tab-hover: --anchorname-${randomId}-tab-hover; --hfdev-anchorname-tab-selected: --anchorname-${randomId}-tab-selected;`}
>
  {
    labels.map((label, index) => (
      <button
        class:list={twMerge(
          "hover:text-primary-control font-nav cursor-pointer rounded-t-md border-(length:--border-width-boundary) border-transparent px-6 text-nav select-none hover:[anchor-name:var(--hfdev-anchorname-tab-hover)]",
          "aria-selected:text-primary-control aria-selected:cursor-default aria-selected:[anchor-name:var(--hfdev-anchorname-tab-selected)]",
          "focus-visible:outline-focus-ring focus-visible:outline-(length:--focus-ring-width) focus-visible:outline-offset-(--focus-ring-offset)",
          "motion-safe:transition-colors motion-safe:duration-(--duration-feedback)"
        )}
        id={`tab-${randomId}-${index + 1}`}
        type="button"
        role="tab"
        aria-selected={index === 0}
        aria-controls={`tabpanel-${randomId}-${index + 1}`}
        tabindex={index === 0 ? "0" : "-1"}
      >
        {label}
      </button>
    ))
  }

  {
    [
      "[position-anchor:var(--hfdev-anchorname-tab-hover)]",
      "[position-anchor:var(--hfdev-anchorname-tab-selected)]",
    ].map((positionAnchor) => (
      <div
        class:list={twMerge(
          "pointer-events-none h-1",
          "absolute right-[anchor(right)] bottom-[calc(anchor(bottom)-1px)] left-[anchor(left)]",
          "motion-safe:transition-[left,right] motion-safe:duration-(--duration-overlay)",
          positionAnchor.includes("hover")
            ? "bg-primary-control-hover"
            : "bg-primary-control",
          positionAnchor
        )}
      />
    ))
  }
</div>
