---
import type { HTMLTag, Polymorphic } from "astro/types";
import { twMerge } from "tailwind-merge";
import { filledIconFor, type SvgIconNameTypes } from "../svgs";
import { unwrapParagraph } from "../utils";
import Icon from "./Icon.astro";

// Astro's own polymorphic-component helper. `src/tests/types/ButtonProps.astro` pins what it
// accepts and rejects on each branch, so `astro check` catches a change. The toggle props
// (below) sit outside it, as its Omit would flatten their union, and Astro reads the generics off
// the first type in the frontmatter, so Props comes first.
type Props<Tag extends Extract<HTMLTag, "a" | "button"> = "button"> =
  Polymorphic<{
    as: Tag;
    // A leading icon, before the label, sized to match it
    icon?: SvgIconNameTypes;
    showFullwidth?: boolean;
    shape?: "round" | "square";
    size?: "xs" | "sm" | "md" | "lg" | "xl";
  }> &
    ToggleProps;

type Variant = "elevated" | "filled" | "outlined" | "text" | "tonal";

// A toggle switches between selected and unselected on each click (aria-pressed). M3 has no toggle
// text button, and an <a> can't be pressed, so only a <button> of the other styles can be one.
type NotToggle = {
  isToggle?: false;
  isSelected?: never;
  selectedIcon?: never;
  variant?: Variant;
};
type ToggleProps =
  | NotToggle
  | {
      as?: "button";
      isToggle: true;
      // A toggle's initial state
      isSelected?: boolean;
      // Shown in place of `icon` while the toggle is selected. Defaults to the icon's -fill version,
      // e.g. "favorite-fill" for "favorite", when there is one
      selectedIcon?: SvgIconNameTypes;
      variant?: Exclude<Variant, "text">;
    };

// Two-read `Astro.props`, per Astro's own documented pattern for polymorphic components: the
// first read grabs `as` untyped, so `<Tag>` below doesn't check its attributes against <a> and
// <button> at once (`type` is a free-form MIME hint on one and an enum on the other).
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { as: Tag = "button" }: any = Astro.props;
// Typed as either tag: plain `Props` is `Props<"button">`, its default, which rejects
// `Astro.props` (#225)
const {
  // Destructured only to keep it out of `attrs`, which would otherwise render it as a literal
  // `as="a"` attribute on the real element; `Tag` above already holds it
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  as: _as,
  icon,
  isToggle = false,
  isSelected = false,
  selectedIcon: selectedIconProp,
  variant = "filled",
  showFullwidth = false,
  shape = "round",
  size = "sm",
  class: classList,
  type,
  ...attrs
}: Props<"a" | "button"> = Astro.props;

// `type="button"` only makes sense - and only defaults - on a real <button>; an <a>'s `type`
// attribute (rarely used) is a MIME-type hint, not a click-behavior enum, so it's left alone.
const resolvedType = Tag === "button" ? (type ?? "button") : type;

const label = unwrapParagraph(await Astro.slots.render("default"));

// Size sets the height, padding, label type, icon size and the gap between icon and label, as in
// M3 Expressive's five sizes. M3 picks the label style by size: Label Large for extra small and
// small, Title Medium for medium, Headline Small for large and Headline Large for extra large.
const labelLarge = "text-sm leading-5 font-medium tracking-[0.1px]";
const titleMedium = "text-base leading-6 font-medium tracking-[0.15px]";
const headlineSmall = "text-2xl leading-8 font-normal tracking-normal";
const headlineLarge = "text-[2rem] leading-10 font-normal tracking-normal";
const sizeClasses = {
  xs: `${labelLarge} min-h-8 px-3 gap-1`,
  sm: `${labelLarge} min-h-10 px-4 gap-2`,
  md: `${titleMedium} min-h-14 px-6 gap-2`,
  lg: `${headlineSmall} min-h-24 px-12 gap-3`,
  xl: `${headlineLarge} min-h-34 px-16 gap-4`,
}[size];

const iconSizeClasses = {
  xs: "size-5",
  sm: "size-5",
  md: "size-6",
  lg: "size-8",
  xl: "size-10",
}[size];

// M3 outline width grows with size. The state layer extends over the border, so it insets by the
// same amount.
const borderClasses = {
  xs: "border before:-inset-px",
  sm: "border before:-inset-px",
  md: "border before:-inset-px",
  lg: "border-2 before:-inset-0.5",
  xl: "border-3 before:-inset-[3px]",
}[size];

// "round" is half the height in px rather than rounded-full, so the corners can animate to and
// from the pressed and selected radii (M3's shape morph) instead of jumping.
const roundCorners = {
  xs: "rounded-2xl",
  sm: "rounded-[20px]",
  md: "rounded-[28px]",
  lg: "rounded-[48px]",
  xl: "rounded-[68px]",
}[size];
const squareCorners = {
  xs: "rounded-xl",
  sm: "rounded-xl",
  md: "rounded-2xl",
  lg: "rounded-[28px]",
  xl: "rounded-[28px]",
}[size];
const shapeClasses = shape === "round" ? roundCorners : squareCorners;

// M3: a selected toggle swaps shapes, round becoming square and square becoming round
const selectedShapeClasses = (shape === "round" ? squareCorners : roundCorners)
  .split(" ")
  .map((corner) => `aria-pressed:${corner}`)
  .join(" ");

// M3: pressed, round and square buttons both morph to the same, squarer corners
const pressedShapeClasses = {
  xs: "not-disabled:active:rounded-lg",
  sm: "not-disabled:active:rounded-lg",
  md: "not-disabled:active:rounded-xl",
  lg: "not-disabled:active:rounded-2xl",
  xl: "not-disabled:active:rounded-2xl",
}[size];

// M3 disabled: label on-surface at 38%, any container on-surface at 10%. An outline stays
// outline-variant.
const disabledContainer =
  "disabled:bg-(--theme-color-on-surface)/10 disabled:border-transparent";

// M3: elevated rests at level 1 and rises to 2 on hover; filled and tonal rest at 0 and rise to 1
const elevatedShadow = `shadow-theme-elevation-1 not-disabled:hover:shadow-theme-elevation-2 disabled:shadow-none`;
const raisedOnHover = "not-disabled:hover:shadow-theme-elevation-1";

const variantClasses = {
  elevated: `bg-(--theme-color-surface-container-low) border-(--theme-color-surface-container-low) text-(--theme-color-primary) ${elevatedShadow} ${disabledContainer}`,
  // M3's filled toggle sits on a surface container until it's selected
  filled: isToggle
    ? `bg-(--theme-color-surface-container) border-(--theme-color-surface-container) text-(--theme-color-on-surface-variant) ${raisedOnHover} ${disabledContainer}`
    : `bg-(--theme-color-primary) border-(--theme-color-primary) text-(--theme-color-on-primary) ${raisedOnHover} ${disabledContainer}`,
  outlined:
    "bg-transparent border-(--theme-color-outline-variant) text-(--theme-color-on-surface-variant)",
  text: "bg-transparent border-transparent text-(--theme-color-primary)",
  tonal: `bg-(--theme-color-secondary-container) border-(--theme-color-secondary-container) text-(--theme-color-on-secondary-container) ${raisedOnHover} ${disabledContainer}`,
}[variant];

// A toggle's selected colors only apply while enabled, so a disabled toggle looks disabled. A
// selected outlined toggle has a container, so disabled it gets the disabled one.
const selectedClasses = {
  elevated:
    "not-disabled:aria-pressed:bg-(--theme-color-primary) not-disabled:aria-pressed:border-(--theme-color-primary) not-disabled:aria-pressed:text-(--theme-color-on-primary)",
  filled:
    "not-disabled:aria-pressed:bg-(--theme-color-primary) not-disabled:aria-pressed:border-(--theme-color-primary) not-disabled:aria-pressed:text-(--theme-color-on-primary)",
  outlined:
    "not-disabled:aria-pressed:bg-(--theme-color-inverse-surface) not-disabled:aria-pressed:border-(--theme-color-inverse-surface) not-disabled:aria-pressed:text-(--theme-color-inverse-on-surface) disabled:aria-pressed:bg-(--theme-color-on-surface)/10 disabled:aria-pressed:border-transparent",
  text: "",
  tonal:
    "not-disabled:aria-pressed:bg-(--theme-color-secondary) not-disabled:aria-pressed:border-(--theme-color-secondary) not-disabled:aria-pressed:text-(--theme-color-on-secondary)",
}[variant];

const isToggleButton = isToggle && Tag === "button";

// M3: a selected toggle shows its icon filled, so it defaults to the -fill version when there is one
const selectedIcon =
  isToggleButton && icon
    ? (selectedIconProp ?? filledIconFor(icon))
    : undefined;
---

<Tag
  class:list={twMerge(
    "group/button flex cursor-pointer items-center justify-center whitespace-nowrap",
    "relative isolate before:absolute before:-z-10 before:rounded-[inherit] before:bg-current before:opacity-0 motion-safe:before:transition-opacity",
    "not-disabled:hover:before:opacity-8 not-disabled:focus-visible:before:opacity-10 not-disabled:active:before:opacity-10",
    // M3: a button whose menu is open keeps its pressed state layer
    "aria-[haspopup=menu]:aria-expanded:before:opacity-10",
    // M3 touch target: at least 48px high, centered on the button, for every size
    "after:absolute after:inset-x-0 after:top-1/2 after:h-12 after:min-h-full after:-translate-y-1/2",
    "disabled:cursor-default disabled:text-(--theme-color-on-surface)/38",
    // M3's button tokens put the corner morph on the fast spatial spring; colors and the shadow
    // are on fast effects (ADR-0018)
    "motion-safe:[transition:color_var(--theme-duration-spring-fast-effects)_var(--ease-spring-fast-effects),background-color_var(--theme-duration-spring-fast-effects)_var(--ease-spring-fast-effects),border-color_var(--theme-duration-spring-fast-effects)_var(--ease-spring-fast-effects),border-radius_var(--theme-duration-spring-fast-spatial)_var(--ease-spring-fast-spatial),box-shadow_var(--theme-duration-spring-fast-effects)_var(--ease-spring-fast-effects)]",
    "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-offset-2 focus-visible:ring-offset-(--theme-color-wrapper-bg)",
    showFullwidth ? "min-w-full" : "max-w-fit",
    borderClasses,
    variantClasses,
    shapeClasses,
    isToggleButton && selectedClasses,
    isToggleButton && selectedShapeClasses,
    pressedShapeClasses,
    sizeClasses,
    classList
  )}
  type={resolvedType}
  aria-pressed={isToggleButton ? String(isSelected) : undefined}
  data-ac-button-toggle={isToggleButton ? "" : undefined}
  data-ac-button-size={size}
  {...attrs}
>
  {icon &&
    (selectedIcon ? (
      <>
        {/* swapped by CSS, so the icon follows aria-pressed however it changes */}
        <Icon
          class:list={[
            iconSizeClasses,
            "shrink-0 group-aria-pressed/button:hidden",
          ]}
          name={icon}
        />
        <Icon
          class:list={[
            iconSizeClasses,
            "hidden shrink-0 group-aria-pressed/button:block",
          ]}
          name={selectedIcon}
        />
      </>
    ) : (
      <Icon class:list={[iconSizeClasses, "shrink-0"]} name={icon} />
    ))}
  <Fragment set:html={label} />
</Tag>

<script>
  // Each click flips a toggle's aria-pressed (keyboard activation fires click too). ButtonIcon has
  // its own copy, under its own attribute, so each component works on its own and a page with
  // both doesn't flip a toggle twice.
  document.addEventListener("click", (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>(
      "[data-ac-button-toggle]"
    );
    if (!button || button.disabled) return;
    const isPressed = button.getAttribute("aria-pressed") === "true";
    button.setAttribute("aria-pressed", String(!isPressed));
  });
</script>
