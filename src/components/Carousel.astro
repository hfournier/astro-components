---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";
import BaseWrapper from "./BaseWrapper.astro";

// M3's carousel: a row of CarouselItems that scrolls natively, each item changing size and shape
// as it moves through the row, its visual moving at another speed (the parallax). In the
// multi-browse layout, its items are large at the start, then a medium and a small one. In the
// hero layouts, there's one large item, or more on a wide screen, then a small one, or,
// center-aligned, a small one either side, and the row swipes one item at a time. In the
// uncontained layouts, its items keep their size and flow past the row's edges, one width for all
// or each item its own. The full-screen layout scrolls vertically through one item at a time,
// filling the carousel. Compose's HorizontalMultiBrowseCarousel, HorizontalCenteredHeroCarousel and
// uncontained keylines lay it out; the script runs them (src/carousel.ts) as the row scrolls
// (ADR-0038, ADR-0039, ADR-0040).
const layouts = [
  "multi-browse",
  "hero",
  "center-aligned-hero",
  "uncontained",
  "uncontained-multi-aspect-ratio",
  "full-screen",
] as const;
type Props = Omit<HTMLAttributes<"div">, "role"> & {
  layout?: (typeof layouts)[number];
  preferredItemWidth?: number;
};

const {
  layout = "multi-browse",
  preferredItemWidth,
  class: classList,
  ...attrs
} = Astro.props;

// Values outside these fail the build, rather than drawing something other than was asked for
// (ADR-0021). MDX passes attributes as strings, so `preferredItemWidth="240"` is read as the
// number it says.
if (!layouts.includes(layout)) {
  throw new Error(
    `Carousel: its layouts are ${layouts
      .map((name) => `"${name}"`)
      .join(", ")
      .replace(
        /, (?=[^,]*$)/,
        " and "
      )}, but this one's \`layout\` is ${JSON.stringify(layout)}.`
  );
}
const isHero = layout === "hero" || layout === "center-aligned-hero";
const isUncontained =
  layout === "uncontained" || layout === "uncontained-multi-aspect-ratio";
const isFullScreen = layout === "full-screen";
// M3's Specs: a full-screen carousel's one item fills it
if (isFullScreen && preferredItemWidth !== undefined) {
  throw new Error(
    "Carousel: a full-screen carousel's item fills it, so it takes no `preferredItemWidth`."
  );
}
// Compose's multi-browse and uncontained samples ask for 186dp items. A hero carousel's large item
// fills the carousel but for its small items unless it's given a width, as Compose's does.
const preferredWidth =
  preferredItemWidth === undefined
    ? isHero || isFullScreen
      ? null
      : 186
    : Number(preferredItemWidth);
if (
  preferredWidth !== null &&
  (!Number.isFinite(preferredWidth) || preferredWidth <= 0)
) {
  throw new Error(
    `Carousel: \`preferredItemWidth\` is the large items' width in px, a number above 0, but this one's is ${JSON.stringify(preferredItemWidth)}.`
  );
}
// M3's Accessibility page: the carousel's container is labelled. It's a region, which needs a name.
if (!attrs["aria-label"] && !attrs["aria-labelledby"]) {
  throw new Error(
    "Carousel: a carousel needs a name, from an `aria-label` or `aria-labelledby`, but this one has neither."
  );
}
---

{/* M3's container, on surface, holding the items. It's a region, described as a carousel, as the
    WAI-ARIA carousel pattern has it; its list says how many items it has and which one has focus,
    as M3's Accessibility page asks. Compose's sample is 221dp high, items 205dp with 8dp above and
    below; the page sets another height with `class`. A full-screen carousel fills the window
    (M3's Specs), or whatever height the page gives it. */}
<BaseWrapper
  bgColor="surface"
  class={twMerge("relative", isFullScreen ? "h-dvh" : "h-55.25", classList)}
  role="region"
  aria-roledescription="carousel"
  data-ac-carousel={layout}
  data-ac-carousel-preferred-item-width={preferredWidth ?? undefined}
  {...attrs}
>
  {/* The row: every item laid out at the large size, 8dp apart (M3's padding between elements),
      8dp above and below, scrolling natively. The script sizes the items and their snap positions
      from Compose's keylines, which hold the 16dp leading and trailing padding. Without the
      script, or with reduced motion, every item stays large, the row padded 16dp at its ends
      (M3's Accessibility page: with reduced motion, all items are the same size). Its items are
      the tab stops, not the row (M3's Accessibility page: don't focus the container), which
      Firefox would otherwise stop at as it scrolls.
      Multi-browse and hero carousels snap (M3's Guidelines: snap-scrolling is "recommended for
      multi-browse, hero, and full-screen layouts"). A hero carousel stops at every item, so a
      swipe moves it one item (M3's Overview: hero carousels "swipe through one item at a time").
      Without its keylines, a center-aligned one snaps its items to the center. Before the script
      sizes them, a hero carousel's items are the large size its keylines give without a preferred
      width: the row, its 16px padding included, less 8px and a 40px small item for each small one.
      The uncontained layouts have no keylines: their items keep their size and flow past the
      row's edges (M3's Guidelines), scrolling freely, as M3's Guidelines recommend, padded at the
      start only (M3's Specs), so their last item reaches the row's end. An uncontained
      multi-aspect ratio carousel's items are each as wide as their aspect ratio makes them, at the
      row's height.
      A full-screen carousel scrolls vertically, its items filling it edge to edge, 16dp apart, and
      stops at every one (M3's Guidelines: "make sure the carousel items snap to the edges of the
      carousel container"). */}
  <ul
    class:list={[
      "flex h-full scrollbar-none outline-none",
      isFullScreen
        ? "flex-col snap-y snap-mandatory gap-4 overflow-y-auto overscroll-y-contain *:h-full *:snap-always [--ac-carousel-item-size:100%]"
        : "gap-2 overflow-x-auto overscroll-x-contain py-2 ps-4 scroll-ps-4 data-ac-carousel-keylines:ps-0 data-ac-carousel-keylines:scroll-ps-0",
      !isFullScreen && !isUncontained && "snap-x snap-mandatory",
      !isFullScreen &&
        (isUncontained
          ? "pe-0"
          : "pe-4 scroll-pe-4 data-ac-carousel-keylines:pe-0 data-ac-carousel-keylines:scroll-pe-0"),
      isHero && "*:snap-always",
      preferredWidth === null &&
        layout === "hero" &&
        "[--ac-carousel-item-size:calc(100%-16px)]",
      preferredWidth === null &&
        layout === "center-aligned-hero" &&
        "[--ac-carousel-item-size:calc(100%-64px)]",
      layout === "center-aligned-hero" &&
        "not-data-ac-carousel-keylines:*:snap-center",
      layout === "uncontained-multi-aspect-ratio" &&
        "*:h-full *:data-ac-carousel-item-aspect-ratio:w-auto *:data-ac-carousel-item-aspect-ratio:aspect-(--ac-carousel-item-aspect-ratio)",
    ]}
    style={
      preferredWidth !== null
        ? `--ac-carousel-item-size: ${preferredWidth}px`
        : undefined
    }
    tabindex="-1"
    data-ac-carousel-part="list"
  >
    <slot />
  </ul>
</BaseWrapper>

<script>
  import {
    arrangeHero,
    arrangeMultiBrowse,
    arrangeUncontained,
    createStrategy,
    itemPlacement,
    scrollToShow,
    snapOffset,
    type KeylineList,
    type Strategy,
  } from "../carousel";
  import { moveFocusWithArrows, tabbableIn } from "../utils";

  // M3's Specs: 8dp between items, 16dp leading and trailing padding, small items 40 to 56dp
  // (Compose's CarouselDefaults). A full-screen carousel's items are 16dp apart, unpadded.
  const spacing = 8;
  const fullScreenSpacing = 16;
  const padding = 16;
  const minSmall = 40;
  const maxSmall = 56;
  // MDC's carousel fades an item's text out over the first 80dp it's masked
  const labelFadeDistance = 80;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const strategies = new WeakMap<HTMLElement, Strategy>();

  const listOf = (root: HTMLElement) =>
    root.querySelector<HTMLElement>(':scope > [data-ac-carousel-part="list"]')!;
  const itemsOf = (list: HTMLElement) =>
    [...list.children].filter(
      (el): el is HTMLElement =>
        el instanceof HTMLElement && el.hasAttribute("data-ac-carousel-item")
    );
  const rootOf = (list: HTMLElement) =>
    list.closest<HTMLElement>("[data-ac-carousel]")!;
  // A full-screen carousel scrolls vertically; the others, horizontally
  const isVertical = (root: Element) =>
    root.getAttribute("data-ac-carousel") === "full-screen";
  // How far the row has scrolled from its start, in either direction
  const scrollOf = (list: HTMLElement) =>
    isVertical(rootOf(list)) ? list.scrollTop : Math.abs(list.scrollLeft);
  const scrollMargin = (list: HTMLElement) =>
    isVertical(rootOf(list))
      ? "scroll-margin-block-start"
      : "scroll-margin-inline-start";

  // Sizes and places each item for where the row is scrolled
  const place = (list: HTMLElement) => {
    const strategy = strategies.get(list);
    if (!strategy) return;
    const items = itemsOf(list);
    const scroll = scrollOf(list);
    items.forEach((item, i) => {
      const { size, translation } = itemPlacement(
        strategy,
        i,
        scroll,
        items.length
      );
      const masked = (strategy.itemSize - size) / 2;
      item.style.setProperty("--ac-carousel-mask-size", `${size}px`);
      item.style.setProperty(
        "--ac-carousel-mask-start",
        `${masked + translation}px`
      );
      item.style.setProperty("--ac-carousel-visual-start", `${-masked}px`);
      item.style.setProperty(
        "--ac-carousel-label-opacity",
        `${Math.max(0, 1 - masked / labelFadeDistance)}`
      );
    });
  };

  // Clears what the keylines set, so every item is large
  const clearKeylines = (list: HTMLElement) => {
    strategies.delete(list);
    list.removeAttribute("data-ac-carousel-keylines");
    list.style.removeProperty("--ac-carousel-visual-size");
    itemsOf(list).forEach((item) => {
      for (const name of [
        "--ac-carousel-mask-size",
        "--ac-carousel-mask-start",
        "--ac-carousel-visual-start",
        "--ac-carousel-label-opacity",
        "scroll-margin-inline-start",
        "scroll-margin-block-start",
      ])
        item.style.removeProperty(name);
    });
  };

  // The keylines of a carousel's layout, for the row's size and the items' count. A full-screen
  // carousel's are Compose's uncontained ones for an item the carousel's size: one large item
  // between two anchors. The uncontained layouts have none: their items keep their size.
  const keylinesOf = (
    root: HTMLElement,
    available: number,
    count: number
  ): KeylineList => {
    const { acCarousel: layoutName, acCarouselPreferredItemWidth: preferred } =
      root.dataset;
    switch (layoutName) {
      case "hero":
      case "center-aligned-hero":
        return arrangeHero({
          available,
          preferred: preferred ? Number(preferred) : null,
          spacing,
          count,
          centered: layoutName === "center-aligned-hero",
          minSmall,
          maxSmall,
        });
      case "full-screen":
        return arrangeUncontained({
          available,
          itemSize: available,
          spacing: fullScreenSpacing,
        });
      case "multi-browse":
        return arrangeMultiBrowse({
          available,
          preferred: Number(preferred),
          spacing,
          count,
          minSmall,
          maxSmall,
        });
      default:
        return [];
    }
  };

  // The row's padding at its start and end, and the space between its items
  const spacingOf = (root: HTMLElement) =>
    isVertical(root)
      ? { spacing: fullScreenSpacing, before: 0, after: 0 }
      : { spacing, before: padding, after: padding };

  // Works out the keylines for the row's size and the items' count: the large size every item
  // is laid out at, and where each one snaps
  const layout = (root: HTMLElement) => {
    const list = listOf(root);
    const items = itemsOf(list);
    const vertical = isVertical(root);
    const available = vertical ? list.clientHeight : list.clientWidth;
    const space = spacingOf(root);
    const strategy = createStrategy(keylinesOf(root, available, items.length), {
      available,
      ...space,
    });
    if (reducedMotion.matches) {
      // Every item at one size, the row padded. Multi-browse's are the preferred width; a hero
      // carousel's are its large items', so the next item shows in part (M3's Accessibility page:
      // with reduced motion, a hero carousel's small item "is only partially shown"); a
      // full-screen carousel's fill it.
      clearKeylines(list);
      const {
        acCarousel: layoutName,
        acCarouselPreferredItemWidth: preferred,
      } = root.dataset;
      const large =
        layoutName === "hero" || layoutName === "center-aligned-hero"
          ? strategy.itemSize
          : layoutName === "multi-browse"
            ? Number(preferred)
            : 0;
      if (large > 0)
        list.style.setProperty(
          "--ac-carousel-item-size",
          `${Math.min(large, available - space.before - space.after)}px`
        );
      return;
    }
    if (!strategy.isValid) return clearKeylines(list);
    strategies.set(list, strategy);
    list.setAttribute("data-ac-carousel-keylines", "");
    list.style.setProperty("--ac-carousel-item-size", `${strategy.itemSize}px`);
    list.style.setProperty(
      "--ac-carousel-visual-size",
      `${strategy.itemSize}px`
    );
    const margin = scrollMargin(list);
    items.forEach((item, i) =>
      item.style.setProperty(
        margin,
        `${snapOffset(strategy, i, items.length)}px`
      )
    );
    place(list);
  };

  // Scrolls the row the least way to a snap position where an item is large, unless it is already
  const scrollToItem = (list: HTMLElement, index: number) => {
    const strategy = strategies.get(list);
    const behavior = reducedMotion.matches ? "instant" : "smooth";
    // An uncontained item, which keeps its size, scrolls the least way to show all of it, past
    // the 16px leading padding; the browser leaves one that's in part in view where it is.
    if (!strategy) {
      const item = itemsOf(list)[index];
      const row = list.getBoundingClientRect();
      const box = item?.getBoundingClientRect();
      if (box && (box.left < row.left - 0.5 || box.right > row.right + 0.5))
        item.scrollIntoView({ block: "nearest", inline: "nearest", behavior });
      return;
    }
    const scroll = scrollOf(list);
    const target = scrollToShow(strategy, index, itemsOf(list).length, scroll);
    // unchanged, it would stop a smooth scroll already under way to show the item
    if (Math.abs(target - scroll) < 1) return;
    if (isVertical(rootOf(list)))
      return list.scrollTo({ top: target, behavior });
    const direction = getComputedStyle(list).direction === "rtl" ? -1 : 1;
    list.scrollTo({ left: direction * target, behavior });
  };

  const roots = () =>
    document.querySelectorAll<HTMLElement>("[data-ac-carousel]");

  const resizes = new ResizeObserver((entries) => {
    for (const entry of entries) {
      const root = (entry.target as HTMLElement).closest<HTMLElement>(
        "[data-ac-carousel]"
      );
      if (root) layout(root);
    }
  });

  const frames = new WeakMap<HTMLElement, number>();
  roots().forEach((root) => {
    const list = listOf(root);
    resizes.observe(list);
    layout(root);
    list.addEventListener(
      "scroll",
      () => {
        if (frames.get(list)) return;
        frames.set(
          list,
          requestAnimationFrame(() => {
            frames.delete(list);
            place(list);
          })
        );
      },
      { passive: true }
    );
  });
  reducedMotion.addEventListener("change", () => roots().forEach(layout));

  // M3's Accessibility page: Tab or the arrow keys move between the items; up and down in a
  // full-screen carousel, which scrolls vertically
  moveFocusWithArrows("[data-ac-carousel]", { isVertical });

  // An item taking focus or clicked scrolls into a large place when it isn't large there yet,
  // after the browser's own scroll to show it. Clicked too, as Safari doesn't focus a clicked
  // link or button.
  const showItem = (event: Event) => {
    const target = event.target as Element;
    const item = target.closest?.<HTMLElement>("[data-ac-carousel-item]");
    const list = item?.parentElement;
    if (!item || !list) return;
    requestAnimationFrame(() =>
      scrollToItem(list, itemsOf(list).indexOf(item))
    );
  };
  document.addEventListener("focusin", showItem);
  document.addEventListener("click", showItem);

  // M3's Accessibility page: the up and down arrow keys leave a horizontal carousel, to the
  // control before or after it. On the window, as moveFocusWithArrows listens, after any group
  // inside.
  window.addEventListener("keydown", (event) => {
    if (event.defaultPrevented) return;
    if (event.key !== "ArrowUp" && event.key !== "ArrowDown") return;
    if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey)
      return;
    const target = event.target as Element;
    const root = target.closest?.("[data-ac-carousel]");
    if (!root || isVertical(root) || !target.closest("[data-ac-carousel-item]"))
      return;
    const tabbables = tabbableIn(document).filter((el) => !root.contains(el));
    const position = (el: Element) => root.compareDocumentPosition(el);
    const next =
      event.key === "ArrowDown"
        ? tabbables.find(
            (el) => position(el) & Node.DOCUMENT_POSITION_FOLLOWING
          )
        : tabbables.findLast(
            (el) => position(el) & Node.DOCUMENT_POSITION_PRECEDING
          );
    if (!next) return;
    event.preventDefault();
    next.focus();
  });
</script>
