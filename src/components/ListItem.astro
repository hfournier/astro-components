---
import type { HTMLTag, Polymorphic } from "astro/types";
import { twMerge } from "tailwind-merge";
import type { SvgIconNameTypes } from "../svgs";
import Icon from "./Icon.astro";

// An M3 Expressive list item, in the standard style, for a List: a label, with an overline above
// it and supporting text below, a leading icon, avatar, image or video, and a trailing icon or
// text. It's 56px tall for one line, 72px for two and 88px for three, its parts middle-aligned,
// or top-aligned at three lines or 88px. It's static, a link (`as="a"`) or a button
// (`as="button"`): an interactive item shows M3's state layer and morphs its corners from 4px to
// 12px hovered and 16px focused or pressed. The <li> holds the item and, in a List with
// `divider`, the line below it. Every attribute, `class` too, goes on the item.
type Props<Tag extends Extract<HTMLTag, "div" | "a" | "button"> = "div"> =
  Polymorphic<{
    as: Tag;
    // The item's Body Large text, which names it
    label: string;
    // A 20px icon before the label, by its file name in src/assets/svgs. For an avatar, an image
    // or a video, fill the slot of that name instead.
    icon?: SvgIconNameTypes;
    // A line of Label Small text above the label
    overline?: string;
    // Body Medium text below the label, which can wrap
    supportingText?: string;
    // A 20px icon at the end, such as a chevron to show where the item leads
    trailingIcon?: SvgIconNameTypes;
    // Label Small text at the end, such as a count, a price or a date
    trailingText?: string;
    // The `video` slot's size: M3's small 100 by 56px, or large 114 by 64px
    videoSize?: "sm" | "lg";
  }>;

// Two-read `Astro.props`, as in Button: the first read grabs `as` untyped
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { as: Tag = "div" }: any = Astro.props;
const {
  // kept out of `attrs`, which would render it as a literal attribute; `Tag` holds it
  // eslint-disable-next-line @typescript-eslint/no-unused-vars
  as: _as,
  label,
  icon,
  overline,
  supportingText,
  trailingIcon,
  trailingText,
  videoSize = "sm",
  class: classList,
  ...attrs
}: Props<"div" | "a" | "button"> = Astro.props;

// Values outside these fail the build, rather than drawing something other than was asked for
// (ADR-0021)
if (!["div", "a", "button"].includes(Tag)) {
  throw new Error(
    `ListItem: its elements are "div", "a" and "button", but this one's \`as\` is "${Tag}".`
  );
}
if (!["sm", "lg"].includes(videoSize)) {
  throw new Error(
    `ListItem: M3's leading video sizes are "sm" and "lg", but this one's \`videoSize\` is "${videoSize}".`
  );
}
// M3's anatomy has one leading element and one trailing one
const leadingSlots = ["avatar", "image", "video"].filter((name) =>
  Astro.slots.has(name)
);
const leadings = [
  ...(icon ? [`\`icon\` "${icon}"`] : []),
  ...leadingSlots.map((name) => `the \`${name}\` slot`),
];
if (leadings.length > 1) {
  throw new Error(
    `ListItem: M3's list item leads with one icon, avatar, image or video, but this one has ${leadings.join(" and ")}.`
  );
}
if (trailingIcon && trailingText) {
  throw new Error(
    `ListItem: M3's list item ends with an icon or text, but this one has both, \`trailingIcon\` "${trailingIcon}" and \`trailingText\` "${trailingText}".`
  );
}

const leadingSlot = leadingSlots[0];
const leadingMedia = leadingSlot
  ? (await Astro.slots.render(leadingSlot)).trim()
  : undefined;

const isInteractive = Tag !== "div";
// M3's Accessibility page: an item is named by its label and supporting text. The overline and
// the trailing text describe it.
const idPrefix = `ac-list-item-${crypto.randomUUID()}`;
const ids = {
  label: `${idPrefix}-label`,
  overline: overline ? `${idPrefix}-overline` : undefined,
  supporting: supportingText ? `${idPrefix}-supporting` : undefined,
  trailing: trailingText ? `${idPrefix}-trailing` : undefined,
};
const isNamed = attrs["aria-label"] || attrs["aria-labelledby"];
const a11yAttrs = isInteractive
  ? {
      "aria-labelledby": isNamed
        ? undefined
        : [ids.label, ids.supporting].filter(Boolean).join(" "),
      "aria-describedby":
        [ids.overline, ids.trailing].filter(Boolean).join(" ") || undefined,
    }
  : {};

// M3's heights follow the lines of text: an overline or supporting text makes two, both make
// three. The script below makes it three when the supporting text wraps, as Compose does.
const lines =
  overline && supportingText ? 3 : overline || supportingText ? 2 : 1;

// M3: disabled content is on-surface at 38%
const disabledContent =
  "group-disabled/item:text-(--theme-color-on-surface)/38";
// The overline, supporting and trailing text and the icons are on-surface-variant
const variantContent = `text-(--theme-color-on-surface-variant) ${disabledContent}`;
// Label Small
const labelSmall = "text-[11px] leading-4 font-medium tracking-[0.5px]";

// M3's iconography mirrors icons that point along the line right to left, such as a chevron to
// where the item leads
const mirrored = (name: SvgIconNameTypes) =>
  ["arrow_back", "arrow_forward", "chevron_left", "chevron_right"].includes(
    name
  )
    ? "rtl:-scale-x-100"
    : "";

// M3's leading elements: a 20px icon, a 40px circular avatar on primary-container with a Title
// Medium letter or a photo, a 56px image, and a 100 by 56px or 114 by 64px video, both with 8px
// corners. Media fills its box, cropped; disabled, it fades to 38% with the rest.
const media =
  "shrink-0 overflow-hidden group-disabled/item:opacity-38 [&_:is(img,video)]:size-full [&_:is(img,video)]:object-cover";
const leadingClasses = leadingSlot
  ? {
      avatar: `${media} grid size-10 place-items-center rounded-full bg-(--theme-color-primary-container) text-base leading-6 font-medium tracking-[0.15px] text-(--theme-color-on-primary-container)`,
      image: `${media} size-14 rounded-lg`,
      video: `${media} rounded-lg ${{ sm: "h-14 w-25", lg: "h-16 w-[114px]" }[videoSize]}`,
    }[leadingSlot]
  : `flex shrink-0 ${variantContent}`;
---

<li class="list-none">
  <Tag
    class:list={twMerge(
      // 16px at each end, 10px above and below, 12px between the parts, 56px tall for one line,
      // 72px for two, 88px for three. Middle-aligned, or top-aligned at three lines or once the
      // script finds it 88px tall.
      "flex w-full min-h-14 items-center gap-3 px-4 py-2.5 text-start",
      "data-[ac-list-item-lines=2]:min-h-18 data-[ac-list-item-lines=3]:min-h-22 data-[ac-list-item-lines=3]:items-start data-ac-list-item-top:items-start",
      // On M3's surface container, its corners 4px. What it holds reads the surface's roles.
      "rounded-sm bg-(--theme-color-surface) text-(--theme-color-on-surface)",
      "[--theme-color-focus-ring-on-bg:var(--theme-color-secondary)] [--theme-color-link-text:var(--theme-color-primary)] [--theme-color-on-bg-variant:var(--theme-color-on-surface-variant)] [--theme-color-wrapper-bg:var(--theme-color-surface)]",
      isInteractive && [
        "group/item relative isolate cursor-pointer disabled:cursor-default",
        // M3's on-surface state layer: 8% hovered, 10% focused or pressed
        "before:absolute before:inset-0 before:-z-10 before:rounded-[inherit] before:bg-(--theme-color-on-surface) before:opacity-0 motion-safe:before:transition-opacity",
        "not-disabled:hover:before:opacity-8 focus-visible:before:opacity-10 not-disabled:active:before:opacity-10",
        // M3 Expressive's shape morph: 12px hovered, 16px focused or pressed
        "not-disabled:hover:rounded-xl focus-visible:rounded-2xl not-disabled:active:rounded-2xl",
        // M3's 3px focus indicator, inside the item
        "outline-none focus-visible:ring-3 focus-visible:ring-(--theme-color-focus-ring-on-bg) focus-visible:ring-inset",
        // the mixed springs, from the <style> block below
        "motion-safe:[transition:var(--ac-list-item-transition)]",
      ],
      classList
    )}
    type={Tag === "button" ? "button" : undefined}
    data-ac-list-item
    data-ac-list-item-lines={lines}
    {...a11yAttrs}
    {...attrs}
  >
    {icon ? (
      <span class={leadingClasses} data-ac-list-item-part="leading">
        <Icon class:list={["size-5", mirrored(icon)]} name={icon} />
      </span>
    ) : (
      leadingMedia && (
        <span
          class={leadingClasses}
          aria-hidden="true"
          data-ac-list-item-part="leading"
          set:html={leadingMedia}
        />
      )
    )}
    <span class="flex min-w-0 flex-1 flex-col" data-ac-list-item-part="content">
      {overline && (
        <span
          class:list={[labelSmall, variantContent]}
          id={ids.overline}
          data-ac-list-item-part="overline"
        >
          {overline}
        </span>
      )}
      {/* Body Large */}
      <span
        class:list={["text-base leading-6 tracking-[0.5px]", disabledContent]}
        id={ids.label}
        data-ac-list-item-part="label"
      >
        {label}
      </span>
      {supportingText && (
        <span
          class:list={["text-sm leading-5 tracking-[0.25px]", variantContent]}
          id={ids.supporting}
          data-ac-list-item-part="supporting"
        >
          {supportingText}
        </span>
      )}
    </span>
    {trailingText && (
      <span
        class:list={["shrink-0", labelSmall, variantContent]}
        id={ids.trailing}
        data-ac-list-item-part="trailing"
      >
        {trailingText}
      </span>
    )}
    {trailingIcon && (
      <span
        class:list={["flex shrink-0", variantContent]}
        data-ac-list-item-part="trailing"
      >
        <Icon
          class:list={["size-5", mirrored(trailingIcon)]}
          name={trailingIcon}
        />
      </span>
    )}
  </Tag>
  {/* M3's divider, 1px of outline-variant below the item; List shows it between items */}
  <span
    class="hidden h-px bg-(--theme-color-outline-variant)"
    aria-hidden="true"
    data-ac-list-item-part="divider"
  ></span>
</li>

<style>
  /* M3's list tokens put the corner morph on the fast spatial spring; colors on fast effects
     (ADR-0018). A custom property, so a caller's transition class can replace it (ADR-0020). */
  [data-ac-list-item] {
    --ac-list-item-transition:
      color var(--theme-duration-spring-fast-effects)
        var(--ease-spring-fast-effects),
      background-color var(--theme-duration-spring-fast-effects)
        var(--ease-spring-fast-effects),
      border-radius var(--theme-duration-spring-fast-spatial)
        var(--ease-spring-fast-spatial);
  }
</style>

<script>
  // M3's heights follow the item's lines of text, and supporting text that wraps makes three, as
  // Compose counts it; an item 88px or taller, such as one whose label wraps, top-aligns its
  // parts. Both depend on the item's width, so they're kept up to date as it resizes (ADR-0027).
  const update = (item: HTMLElement) => {
    const overline = item.querySelector("[data-ac-list-item-part=overline]");
    const supporting = item.querySelector<HTMLElement>(
      "[data-ac-list-item-part=supporting]"
    );
    const wraps =
      !!supporting &&
      supporting.offsetHeight >
        parseFloat(getComputedStyle(supporting).lineHeight) * 1.5;
    const lines =
      (overline && supporting) || wraps ? 3 : overline || supporting ? 2 : 1;
    item.dataset.acListItemLines = String(lines);
    item.toggleAttribute("data-ac-list-item-top", item.offsetHeight >= 88);
  };
  // A frame later, since a new line count resizes the item, which inside the callback would be a
  // ResizeObserver loop
  const observer = new ResizeObserver((entries) => {
    requestAnimationFrame(() => {
      for (const entry of entries) update(entry.target as HTMLElement);
    });
  });
  // Observed again after each swap, for items brought in by Astro's ClientRouter
  const observeAll = () => {
    for (const item of document.querySelectorAll<HTMLElement>(
      "[data-ac-list-item]"
    ))
      observer.observe(item);
  };
  observeAll();
  document.addEventListener("astro:after-swap", observeAll);
</script>
