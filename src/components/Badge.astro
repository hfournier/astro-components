---
import type { HTMLAttributes } from "astro/types";
import { twMerge } from "tailwind-merge";

type Props = HTMLAttributes<"span"> & {
  label?: string | number;
  placement?: "anchored" | "inline";
};
const {
  label,
  placement = "anchored",
  class: classList,
  ...attrs
} = Astro.props;

// A numeric string (e.g. from a data attribute) behaves like a number: hidden at 0, capped at 999+
const value =
  typeof label === "string" && /^\d+$/.test(label) ? Number(label) : label;

// "anchored" overlaps the top-end corner of an anchor (typically an icon), per M3's BadgedBox
// offsets; "inline" sits in the text flow, e.g. after a tab label that has no icon to anchor to.
// Anchored, the offsets mirror right to left: rtl: sets the other side and resets this one, since
// Firefox misplaces position-area right to left.
// Inline, M3 sits the dot on the text's baseline and aligns a badge with content to the top of the
// text's capital letters (not its line box). overflow-hidden makes an inline-block's baseline its
// bottom margin edge, so align-baseline puts the bottom on the text's baseline; for a badge with
// content, a negative bottom margin of (cap height - badge height) then lifts its top to the cap
// line. The outer span keeps the surrounding text's font, so 1cap is the label's cap height, and
// the badge's own 11px type lives on the inner span.
const placementClasses =
  placement === "inline"
    ? [
        "inline-block shrink-0 overflow-hidden align-baseline",
        value && "mb-[calc(1cap-1lh)]",
      ]
    : [
        "fixed [position-anchor:var(--ac-anchorname-badge)]",
        value
          ? "top-[calc(anchor(top)-2px)] left-[calc(anchor(right)-12px)] rtl:right-[calc(anchor(left)-12px)] rtl:left-auto"
          : "top-[anchor(top)] right-[anchor(right)] rtl:right-auto rtl:left-[anchor(left)]",
      ];
---

{value !== 0 && (
  <span
    class:list={twMerge(
      "bg-(--theme-color-error) text-(--theme-color-on-error)",
      // M3 large badge with a value; small badge (a dot) without
      value
        ? "h-4 min-w-4 rounded-lg px-1 text-center leading-4"
        : "size-1.5 rounded-[3px]",
      placementClasses,
      classList
    )}
    aria-hidden="true"
    {...attrs}
  >
    {value && (
      // Centered by its ink, not its line box: trimmed to the digits' cap line and baseline,
      // then pushed down by half the space left. A line box centers the font's ascent and
      // descent instead, which leaves the digits up to 1px high (Chromium rounds the metrics).
      <span class="mt-[calc((1rem-1cap)/2)] block text-[11px] leading-4 font-medium tracking-[0.5px] [text-box:trim-both_cap_alphabetic]">
        {typeof value === "string"
          ? value.substring(0, 4)
          : value > 999
            ? "999+"
            : value}
      </span>
    )}
  </span>
)}
