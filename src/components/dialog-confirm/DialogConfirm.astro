---
import type { ComponentProps } from "astro/types";
import type { ButtonPropsType } from "../../types.js";
import Dialog from "../dialog/Dialog.astro";
import Button from "../button/Button.astro";

type DialogProps = ComponentProps<typeof Dialog>;

type Props = DialogProps & {
  buttonDismiss: ButtonPropsType;
  buttonConfirm: ButtonPropsType;
};

const { id, buttonDismiss, buttonConfirm, ...attrs } = Astro.props;
---

{
  /* M3: a dialog with two actions pairs a dismissing action with a confirming one, confirm
     last. Dismiss is autofocused so a reflexive Enter never confirms, and uses request-close
     so it fires `cancel` the same way Escape does. Dialog wires aria-labelledby to the
     headline itself. */
}
<Dialog
  {id}
  role="alertdialog"
  aria-describedby={`${id}-content`}
  {...attrs}
>
  <slot />

  <menu class="flex items-center justify-end gap-2" slot="footer">
    <li>
      <Button
        command="request-close"
        commandfor={id}
        id={buttonDismiss.id}
        value={buttonDismiss.value}
        autofocus
        variant="text"
      >
        {buttonDismiss.text}
      </Button>
    </li>
    <li>
      <Button
        command="close"
        commandfor={id}
        id={buttonConfirm.id}
        value={buttonConfirm.value}
        variant="text"
      >
        {buttonConfirm.text}
      </Button>
    </li>
  </menu>
</Dialog>
