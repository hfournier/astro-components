---
import type { ButtonPropsType } from "../../types.js";
import { twMerge } from "tailwind-merge";
import Dialog from "../dialog/Dialog.astro";
import Button from "../button/Button.astro";

type Props = {
  id: string;
  title: string;
  buttonConfirm: ButtonPropsType;
  buttonCancel?: ButtonPropsType;
};

const { id, title, buttonConfirm, buttonCancel } = Astro.props;
---

<Dialog {id} aria-labelledby={`${id}-title`}>
  <h3
    class:list={twMerge("font-title text-title")}
    id={`${id}-title`}
    slot="header"
  >
    {title}
  </h3>

  <slot />

  <form method="dialog" slot="footer">
    <menu class:list={twMerge("flex items-center justify-end gap-2")}>
      <li>
        <Button
          command="close"
          commandfor={id}
          id={buttonConfirm.id}
          value={buttonConfirm.value}
        >
          {buttonConfirm.text}
        </Button>
      </li>
      {
        buttonCancel && (
          <li>
            <Button
              command="request-close"
              commandfor={id}
              id={buttonCancel.id}
              value={buttonCancel.value}
              variant="outline"
            >
              {buttonCancel.text}
            </Button>
          </li>
        )
      }
    </menu>
  </form>
</Dialog>
