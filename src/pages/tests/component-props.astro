---
// Renders each component with a prop outside its set and lists the outcome: "rendered", or the
// error it threw (ADR-0021). A component that throws would fail the whole page and the build, so
// each case renders in its own container and its error is caught.
import { experimental_AstroContainer } from "astro/container";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Main from "../../components/Main.astro";
import Badge from "../../components/Badge.astro";
import BaseButton from "../../components/BaseButton.astro";
import BaseOverlay from "../../components/BaseOverlay.astro";
import BaseWrapper from "../../components/BaseWrapper.astro";
import Button from "../../components/Button.astro";
import ButtonGroupConnected from "../../components/ButtonGroupConnected.astro";
import ButtonIcon from "../../components/ButtonIcon.astro";
import ButtonSplit from "../../components/ButtonSplit.astro";
import Details from "../../components/Details.astro";
import Divider from "../../components/Divider.astro";
import Fab from "../../components/Fab.astro";
import FabMenu from "../../components/FabMenu.astro";
import Heading from "../../components/Heading.astro";
import Menu from "../../components/Menu.astro";
import NavDrawer from "../../components/NavDrawer.astro";
import NavRail from "../../components/NavRail.astro";
import Popover from "../../components/Popover.astro";
import SheetSide from "../../components/SheetSide.astro";
import Switch from "../../components/Switch.astro";
import Tab from "../../components/Tab.astro";
import Tabs from "../../components/Tabs.astro";
import TextField from "../../components/TextField.astro";
import Tooltip from "../../components/Tooltip.astro";

const container = await experimental_AstroContainer.create();
// ButtonIcon and Fab need an icon and a label, FabMenu an id too
const add = { icon: "add", label: "Add" };
const fabMenu = { ...add, id: "fab-menu" };
const field = { label: "Name" };
// ButtonGroupConnected needs a name and two or more options
const choice = {
  name: "choice",
  options: [{ label: "One" }, { label: "Two" }],
};
// ButtonSplit needs its menu's id and its trailing button's name
const split = { menuId: "split-menu", menuLabel: "More options" };
// Each case: the component, and the props it needs plus the one under test. MDX passes
// attributes as strings, so the number cases do too, and a valid one lists what it drew.
const cases: Record<string, [AstroComponentFactory, Record<string, unknown>]> =
  {
    "badge-placement": [Badge, { placement: "floating" }],
    "base-overlay-as": [BaseOverlay, { id: "overlay", as: "section" }],
    "base-overlay-bg-color": [
      BaseOverlay,
      { id: "overlay", bgColor: "primary-container" },
    ],
    "base-overlay-transition": [
      BaseOverlay,
      { id: "overlay", transition: "slide" },
    ],
    "base-wrapper-as": [BaseWrapper, { as: "span" }],
    "base-wrapper-bg-color": [BaseWrapper, { bgColor: "primary" }],
    "base-button-as": [BaseButton, { as: "div" }],
    "base-button-variant": [BaseButton, { variant: "contained" }],
    "base-button-size": [BaseButton, { size: "medium" }],
    "base-button-toggle-text": [
      BaseButton,
      { isToggle: true, variant: "text" },
    ],
    "button-as": [Button, { as: "div" }],
    "button-variant": [Button, { variant: "contained" }],
    "button-shape": [Button, { shape: "oval" }],
    "button-size": [Button, { size: "medium" }],
    "button-toggle-text": [Button, { isToggle: true, variant: "text" }],
    "button-group-connected-name": [
      ButtonGroupConnected,
      { options: choice.options },
    ],
    "button-group-connected-selection": [
      ButtonGroupConnected,
      { ...choice, selection: "exclusive" },
    ],
    "button-group-connected-shape": [
      ButtonGroupConnected,
      { ...choice, shape: "oval" },
    ],
    "button-group-connected-size": [
      ButtonGroupConnected,
      { ...choice, size: "medium" },
    ],
    "button-group-connected-variant": [
      ButtonGroupConnected,
      { ...choice, variant: "text" },
    ],
    "button-group-connected-one-option": [
      ButtonGroupConnected,
      { ...choice, options: [{ label: "One" }] },
    ],
    "button-group-connected-two-selected": [
      ButtonGroupConnected,
      {
        ...choice,
        options: [
          { label: "One", isSelected: true },
          { label: "Two", isSelected: true },
        ],
      },
    ],
    "button-group-connected-required-none": [
      ButtonGroupConnected,
      { ...choice, isSelectionRequired: true },
    ],
    "button-icon-shape": [ButtonIcon, { ...add, shape: "oval" }],
    "button-icon-size": [ButtonIcon, { ...add, size: "medium" }],
    "button-icon-variant": [ButtonIcon, { ...add, variant: "text" }],
    "button-icon-width": [ButtonIcon, { ...add, width: "full" }],
    "button-split-menu-id": [ButtonSplit, { menuLabel: split.menuLabel }],
    "button-split-menu-id-empty": [ButtonSplit, { ...split, menuId: "" }],
    "button-split-menu-label": [ButtonSplit, { menuId: split.menuId }],
    "button-split-name": [ButtonSplit, { ...split, icon: "add" }],
    "button-split-size": [ButtonSplit, { ...split, size: "medium" }],
    "button-split-variant": [ButtonSplit, { ...split, variant: "text" }],
    "details-size": [Details, { label: "More", size: "sm" }],
    "details-variant": [Details, { label: "More", variant: "filled" }],
    "divider-inset": [Divider, { inset: "end" }],
    "divider-orientation": [Divider, { orientation: "diagonal" }],
    "fab-size": [Fab, { ...add, size: "sm" }],
    "fab-color": [Fab, { ...add, color: "surface" }],
    "fab-menu-size": [FabMenu, { ...fabMenu, size: "sm" }],
    "fab-menu-color": [FabMenu, { ...fabMenu, color: "primary-container" }],
    "fab-menu-align": [FabMenu, { ...fabMenu, align: "center" }],
    "heading-level": [Heading, { level: 7 }],
    "heading-level-not-a-number": [Heading, { level: "two" }],
    "heading-level-as-text": [Heading, { level: "2" }],
    "menu-color": [Menu, { id: "menu", color: "tonal" }],
    "menu-layout": [Menu, { id: "menu", layout: "list" }],
    "nav-drawer-width": [NavDrawer, { width: "medium" }],
    "nav-rail-expanded-width": [NavRail, { expandedWidth: "medium" }],
    "nav-rail-align": [NavRail, { align: "bottom" }],
    "popover-bg-color": [
      Popover,
      { id: "popover", bgColor: "surface-container-low" },
    ],
    "sheet-side-edge": [SheetSide, { edge: "left" }],
    "switch-icons": [Switch, { icons: "unselected" }],
    "tab-transition": [Tab, { label: "One", transition: "slide" }],
    "tabs-align": [Tabs, { align: "end" }],
    "tabs-variant": [Tabs, { variant: "tertiary" }],
    "text-field-type": [TextField, { ...field, type: "date" }],
    "text-field-variant": [TextField, { ...field, variant: "standard" }],
    "text-field-rows-as-text": [
      TextField,
      { ...field, type: "textarea", rows: "4" },
    ],
    "text-field-rows-zero": [
      TextField,
      { ...field, type: "textarea", rows: 0 },
    ],
    "text-field-rows-fraction": [
      TextField,
      { ...field, type: "textarea", rows: 2.5 },
    ],
    "text-field-rows-not-a-number": [
      TextField,
      { ...field, type: "textarea", rows: "tall" },
    ],
    "text-field-maxlength-as-text": [TextField, { ...field, maxlength: "20" }],
    "text-field-maxlength-negative": [TextField, { ...field, maxlength: -1 }],
    "text-field-maxlength-not-a-number": [
      TextField,
      { ...field, maxlength: "long" },
    ],
    "tooltip-placement": [Tooltip, { placement: "left" }],
    "tooltip-variant": [Tooltip, { variant: "tooltip" }],
  };
// The cases whose slot isn't "Text": an icon-only button's is empty
const slots: Record<string, string> = { "button-split-name": "" };
const outcomes = await Promise.all(
  Object.entries(cases).map(async ([name, [Component, props]]) => {
    const slot = slots[name] ?? "Text";
    try {
      // some components render their slot as text, so each gets one
      const html = await container.renderToString(Component, {
        props,
        slots: slot ? { default: slot } : {},
      });
      // what a valid case drew: a heading's element, a text area's rows, a counter's limit
      const drawn = [
        html.match(/<(h\d)\b/)?.[1],
        html.match(/--ac-text-field-rows: (\d+)/)?.[1]?.concat(" rows"),
        html.match(/<\/span>\/(\d+)/)?.[1]?.concat(" characters"),
      ].filter(Boolean);
      return ["rendered", ...drawn].join(" ");
    } catch (error) {
      return (error as Error).message;
    }
  })
);
---

<BaseLayout
  title="Component props"
  description="What each component throws for a prop outside its set"
>
  <Main class="mx-auto max-w-[75ch] px-4">
    <h1>Component props</h1>
    <dl>
      {Object.keys(cases).map((name, index) => (
        <>
          <dt>{name}</dt>
          <dd data-testid={`component-props-${name}`}>{outcomes[index]}</dd>
        </>
      ))}
    </dl>
  </Main>
</BaseLayout>
