---
// Renders Tabs with each kind of slot content (src/test/fixtures/TabsContent.astro) and lists the
// outcome: how many tabs it rendered, or the error it threw. A Tabs that throws would fail the
// whole page and the build, so each case renders in its own container and its error is caught.
import { experimental_AstroContainer } from "astro/container";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Main from "../../components/Main.astro";
import TabsContent from "../../test/fixtures/TabsContent.astro";

const container = await experimental_AstroContainer.create();
const contents = ["comments", "element", "empty", "text", "wrapped"] as const;
const outcomes = await Promise.all(
  contents.map(async (content) => {
    try {
      const html = await container.renderToString(TabsContent, {
        props: { content },
      });
      const tabCount = html.match(/role="tab"/g)?.length ?? 0;
      return `rendered ${tabCount} tabs`;
    } catch (error) {
      return (error as Error).message;
    }
  })
);
---

<BaseLayout
  title="Tabs content"
  description="What Tabs renders, or throws, for each kind of slot content"
>
  <Main class="mx-auto max-w-[75ch] px-4">
    <h1>Tabs content</h1>
    <dl>
      {
        contents.map((content, index) => (
          <>
            <dt>{content}</dt>
            <dd data-testid={`tabs-content-${content}`}>{outcomes[index]}</dd>
          </>
        ))
      }
    </dl>
  </Main>
</BaseLayout>
