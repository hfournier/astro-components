---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Main from "../../components/Main.astro";
import Heading from "../../components/Heading.astro";
import P from "../../internal/mdx/P.astro";
---

<BaseLayout
  title="Test | astro-components HenriFournier.dev"
  description="A collection of test pages for astro-components."
>
  <Main
    class="mx-auto max-w-dvw space-y-10 px-4 medium:max-w-[calc(100dvw-96px)] medium:px-6 expanded:max-w-[calc(75ch+4rem)] expanded:px-8"
  >
    <Heading level={1}>astro-components Tests</Heading>

    <P> A collection of test pages for astro-components. </P>

    <P>Pick a test from the sidebar to see its rendered result.</P>
  </Main>
</BaseLayout>
