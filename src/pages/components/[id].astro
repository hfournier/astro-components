---
import { getCollection, getEntry, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { marked } from "marked";
import { components as mdxComponents } from "../../mdx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Heading from "../../components/heading/Heading.astro";
import Usage from "../../internal/Usage.astro";
import Slots from "../../internal/Slots.astro";
import Props from "../../internal/Props.astro";
import Example from "../../internal/Example.astro";

export const getStaticPaths = (async () => {
  const components = await getCollection("components");
  return components.map((component) => ({
    params: { id: component.id.replace("/documentation", "") },
    props: { component },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { component } = Astro.props;
const { Content } = await render(component);
const extendsInfo = component.data.extends;

const usage = await getEntry(
  "usage",
  component.id.replace("/documentation", "/usage")
);
const examples = await getCollection("examples", (entry) =>
  entry.id.startsWith(component.id.replace("/documentation", "/"))
);
---

<BaseLayout
  title={component.data.meta.title}
  description={component.data.meta.description}
>
  <Heading level="h1">{component.data.name} Component</Heading>

  <p set:html={marked.parse(component.data.description)} />

  {
    component.data.role !== "internal" &&
      component.data.parents &&
      component.data.parents.length > 0 && (
        <p>
          Note: The <code>{component.data.name}</code> component should only be
          used in the slot of a {component.data.parents.join(", ")}{" "}
          {component.data.parents.length > 1 ? "components" : "component"}.
        </p>
      )
  }

  {usage && <Usage {usage} />}

  {component.data.props && <Props props={component.data.props} {extendsInfo} />}

  {
    component.data.slots && component.data.slots.length > 0 && (
      <Slots slots={component.data.slots} />
    )
  }

  {
    examples && examples.length > 0 && (
      <>
        <Heading level="h2">Examples</Heading>

        {examples.map((example) => (
          <Example {example} />
        ))}
      </>
    )
  }

  <Content components={{ ...mdxComponents }} />
</BaseLayout>
