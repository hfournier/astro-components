---
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import type {
  GetStaticPaths,
  InferGetStaticPropsType,
  MarkdownHeading,
} from "astro";
import { components as mdxComponents } from "../../mdx";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Main from "../../components/Main.astro";
import Heading from "../../components/Heading.astro";
import Link from "../../components/Link.astro";
import Usage from "../../internal/Usage.astro";
import DocSection from "../../internal/DocSection.astro";
import DocSlots from "../../internal/DocSlots.astro";
import DocProps from "../../internal/DocProps.astro";
import Example from "../../internal/Example.astro";
import TableOfContents from "../../internal/TableOfContents.astro";
import type {
  PropWithHeadingType,
  SlotWithHeadingType,
  ToCHeadingType,
} from "../../types";
import GithubSlugger from "github-slugger";
import MarkdownParagraphs from "../../internal/MarkdownParagraphs.astro";

export const getStaticPaths = (async () => {
  const components = await getCollection("components");
  return components.map((component) => ({
    params: { id: component.id.replace("/documentation", "") },
    props: { component },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { component } = Astro.props;
const { Content, headings: bodyHeadings } = await render(component);
const extendsInfo = component.data.extends;

const usage = await getEntry(
  "usage",
  component.id.replace("/documentation", "/usage")
);
// Optional, unlike usage.mdx: getEntry would warn for each component without one
const [whenToUse] = await getCollection(
  "whenToUse",
  (entry) => entry.id === component.id.replace("/documentation", "/when-to-use")
);
const [accessibility] = await getCollection(
  "accessibility",
  (entry) =>
    entry.id === component.id.replace("/documentation", "/accessibility")
);
const examples = await getCollection("examples", (entry) =>
  entry.id.startsWith(component.id.replace("/documentation", "/"))
);

// Build the table of contents and, in the same pass, attach each generated
// heading id directly to the item it belongs to (prop/slot/example). Ids are
// assigned here once and threaded down as data, rather than re-derived
// downstream by matching on display text - text isn't a unique key (two
// props/slots/examples can share a name), so a second lookup can silently
// wire a heading to the wrong id.
const slugger = new GithubSlugger();
const headings: ToCHeadingType[] = [];

headings.push({ id: "", text: component.data.name, level: 1 });
headings.push({ id: "top", text: "Overview", level: 2 });

// An MDX entry's own h2/h3s. Astro has already given them ids (with its own slugger); slugging
// their text here too reserves those ids, so a later heading with the same text gets a suffixed
// id instead of a duplicate.
const pushMdxHeadings = (mdxHeadings: MarkdownHeading[]) =>
  mdxHeadings
    .filter(({ depth }) => depth === 2 || depth === 3)
    .forEach(({ slug, text, depth }) => {
      slugger.slug(text);
      headings.push({ id: slug, text, level: depth as 2 | 3 });
    });

// A When to use it or Accessibility section: the page gives its heading, the file its content
const pushDocSection = async (
  title: string,
  entry: CollectionEntry<"whenToUse" | "accessibility">
) => {
  const headingId = slugger.slug(title);
  headings.push({ id: headingId, text: title, level: 2 });
  pushMdxHeadings((await render(entry)).headings);
  return headingId;
};

// The sections below are pushed in the order the page renders them
let whenToUseHeadingId: string | undefined;
if (whenToUse) {
  whenToUseHeadingId = await pushDocSection("When to use it", whenToUse);
}

let usageHeadingId: string | undefined;
if (usage) {
  usageHeadingId = slugger.slug("Usage");
  headings.push({ id: usageHeadingId, text: "Usage", level: 2 });
}

pushMdxHeadings(bodyHeadings);

let accessibilityHeadingId: string | undefined;
if (accessibility) {
  accessibilityHeadingId = await pushDocSection("Accessibility", accessibility);
}

let propsHeadingId: string | undefined;
let propsWithIds: PropWithHeadingType[] = [];
if (component.data.props) {
  propsHeadingId = slugger.slug("Properties");
  headings.push({ id: propsHeadingId, text: "Properties", level: 2 });

  propsWithIds = component.data.props.map((prop) => {
    const headingId = slugger.slug(prop.name);
    headings.push({ id: headingId, text: prop.name, level: 3 });
    return { ...prop, headingId };
  });
}

let slotsHeadingId: string | undefined;
let slotsWithIds: SlotWithHeadingType[] = [];
if (component.data.slots && component.data.slots.length > 0) {
  slotsHeadingId = slugger.slug("Slots");
  headings.push({ id: slotsHeadingId, text: "Slots", level: 2 });

  slotsWithIds = component.data.slots.map((slot) => {
    const headingId = slugger.slug(slot.name);
    headings.push({ id: headingId, text: slot.name, level: 3 });
    return { slot, headingId };
  });
}

let examplesHeadingId: string | undefined;
const examplesWithIds: {
  example: CollectionEntry<"examples">;
  headingId: string;
}[] = [];
if (examples && examples.length > 0) {
  examplesHeadingId = slugger.slug("Examples");
  headings.push({ id: examplesHeadingId, text: "Examples", level: 2 });

  examples.forEach((example) => {
    const headingId = slugger.slug(example.data.title);
    headings.push({ id: headingId, text: example.data.title, level: 3 });
    examplesWithIds.push({ example, headingId });
  });
}
---

<BaseLayout
  title={component.data.meta.title}
  description={component.data.meta.description}
  classListHtml="scroll-pt-15 large:scroll-pt-0"
>
  <Main
    class="relative grid grid-cols-[minmax(0,1fr)] grid-rows-[0px_1fr] px-2 large:grid-rows-1"
  >
    <TableOfContents {headings} />

    {
      /* A long code line mustn't widen the article past <main> (under the side sheet), so its
         code block scrolls instead: <main>'s column is minmax(0,1fr) rather than growing to fit
         its content, and the article fills that column (w-full) rather than fitting its content,
         up to 75ch. */
    }
    <article
      class="mx-auto w-full max-w-[calc(75ch+4rem)] space-y-8 px-4 medium:px-6 expanded:px-8"
    >
      <Heading level={1}>{component.data.name} Component</Heading>

      <MarkdownParagraphs text={component.data.description} />

      {
        component.data.mdn && (
          <p>
            For more details, view the{" "}
            <code>&lt;{component.data.mdn.split("/").pop()}&gt;</code>
            element on{" "}
            <Link href={component.data.mdn} target="_blank" rel="noreferrer">
              MDN
            </Link>
          </p>
        )
      }

      {
        component.data.role !== "internal" &&
          component.data.parents &&
          component.data.parents.length > 0 && (
            <p>
              Note: The <code>{component.data.name}</code> component should only
              be used in the slot of a {component.data.parents.join(", ")}{" "}
              {component.data.parents.length > 1 ? "components" : "component"}.
            </p>
          )
      }

      {
        whenToUse && whenToUseHeadingId && (
          <DocSection
            headingId={whenToUseHeadingId}
            title="When to use it"
            entry={whenToUse}
          />
        )
      }

      {usage && <Usage headingId={usageHeadingId} {usage} />}

      <Content components={{ ...mdxComponents }} />

      {
        accessibility && accessibilityHeadingId && (
          <DocSection
            headingId={accessibilityHeadingId}
            title="Accessibility"
            entry={accessibility}
          />
        )
      }

      {
        component.data.props && (
          <DocProps
            headingId={propsHeadingId}
            {extendsInfo}
            props={propsWithIds}
          />
        )
      }

      {
        component.data.slots && component.data.slots.length > 0 && (
          <DocSlots headingId={slotsHeadingId} slots={slotsWithIds} />
        )
      }

      {
        examples && examples.length > 0 && (
          <>
            <Heading id={examplesHeadingId} level={2}>
              Examples
            </Heading>

            {examplesWithIds.map(({ example, headingId }) => (
              <Example headingId={headingId} {example} />
            ))}
          </>
        )
      }
    </article>
  </Main>

  <TableOfContents slot="sheet" isDocked {headings} />
</BaseLayout>
