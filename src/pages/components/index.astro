---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Main from "../../components/Main.astro";
import Heading from "../../components/Heading.astro";
import P from "../../internal/mdx/P.astro";
---

<BaseLayout
  title="Components | astro-components HenriFournier.dev"
  description="A personal library of accessible, Tailwind-styled Astro components, each documented with its usage, properties, slots, and live examples."
>
  <Main class="px-8">
    <Heading level={1}>astro-components</Heading>

    <P>
      A personal library of accessible, Tailwind-styled Astro components -
      buttons, dialogs, tabs, and more - each documented with its usage,
      properties, slots, and live examples.
    </P>

    <P>Pick a component from the sidebar to see its documentation.</P>
  </Main>
</BaseLayout>
