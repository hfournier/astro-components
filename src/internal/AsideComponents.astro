---
import { getCollection } from "astro:content";
import Details from "../components/details/Details.astro";
import Link from "../components/link/Link.astro";

const components = await getCollection("components");
---

<aside
  class="border-divider bg-surface/95 lg:bg-surface min-w-60 border-(length:--border-width-boundary) p-2 lg:p-4"
>
  <nav class="sticky top-0" aria-label="Components">
    <Details
      class="[&>summary]:text-lg [&>summary]:font-semibold"
      label="Components"
      showBorders={false}
      open
    >
      <ul class="space-y-1 pl-4">
        {
          components.map((component) => (
            <li>
              <a
                class:list={[
                  "flex min-h-6 items-center",
                  "aria-[current='page']:text-primary-control aria-[current='page']:underline aria-[current='page']:decoration-1 aria-[current='page']:underline-offset-2",
                  "aria-[current='page']:hover:text-primary-control-hover aria-[current='page']:hover:decoration-2 aria-[current='page']:hover:underline-offset-4",
                  "hover:text-primary-control-hover hover:underline hover:decoration-2 hover:underline-offset-4",
                ]}
                href={`/components/${component.id.replace("/documentation", "")}`}
                aria-current={
                  Astro.url.pathname ===
                  `/components/${component.id.replace("/documentation", "")}`
                    ? "page"
                    : null
                }
              >
                {component.data.name}
              </a>
            </li>
          ))
        }
      </ul>
    </Details>
  </nav>
</aside>
