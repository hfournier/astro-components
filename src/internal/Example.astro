---
import { render, type CollectionEntry } from "astro:content";
import { marked } from "marked";
import { components as mdxComponents } from "../mdx";
import { Code } from "astro:components";
import Heading from "../components/heading/Heading.astro";
import CodePreview from "./CodePreview.astro";
import P from "./mdx/P.astro";

type Props = {
  example: CollectionEntry<"examples">;
  headingId?: string;
};

const { headingId, example } = Astro.props;

const { Content } = await render(example);
---

<div class="space-y-8">
  <Heading id={headingId} level="h3">{example.data.title}</Heading>

  <P set:html={marked.parse(example.data.description)} />

  <CodePreview>
    {
      example.body && (
        <Code
          class="p-4"
          code={example.body}
          lang="jsx"
          theme="github-light"
          slot="code"
        />
      )
    }

    <Content components={{ ...mdxComponents }} slot="preview" />
  </CodePreview>
</div>
