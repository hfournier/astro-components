---
import BaseWrapper from "../components/BaseWrapper.astro";
import ButtonIcon from "../components/ButtonIcon.astro";
import Popover from "../components/Popover.astro";
import TableOfContentsMenu from "./TableOfContentsMenu.astro";
import type { ToCHeadingType } from "../types";

type Props = {
  headings: ToCHeadingType[];
};

const { headings } = Astro.props;
---

<nav
  class="group/toc sticky top-5 right-5 justify-self-end large:hidden"
  aria-label="Table of contents"
>
  <ButtonIcon
    class="[anchor-name:--ac-anchorname-toc-button] hover:opacity-100"
    icon="more_vert"
    size="md"
    variant="outlined"
    command="show-popover"
    commandfor="table-of-contents"
    aria-expanded="false"
    label="Show table of contents"
  />

  <Popover
    class="mt-1"
    overlayClass="m-0 top-[anchor(bottom)] left-auto right-[anchor(right)] [position-anchor:--ac-anchorname-toc-button]"
    id="table-of-contents"
    showBlur={false}
  >
    <div class="mb-4 text-[10px] uppercase">On this page</div>

    <TableOfContentsMenu {headings} />
  </Popover>
</nav>

<BaseWrapper
  bgColor="surface-container-low"
  class="order-2 hidden min-w-55 border border-(--theme-color-outline-variant) p-4 large:block"
>
  <nav class="sticky top-0 space-y-4" aria-label="Table of contents">
    <div class="text-[9px] uppercase">On this page</div>

    <TableOfContentsMenu {headings} />
  </nav>
</BaseWrapper>

<script>
  const toc = document.getElementById("table-of-contents");
  const tocButton = document.querySelector('[commandfor="table-of-contents"]');

  toc?.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest('a[href^="#"]')) {
      toc.hidePopover();
    }
  });

  // Native invokers (command/commandfor) don't manage aria-expanded on the
  // trigger themselves - keep it in sync with the popover's actual state.
  toc?.addEventListener("toggle", (e) => {
    tocButton?.setAttribute("aria-expanded", String(e.newState === "open"));
  });
</script>
