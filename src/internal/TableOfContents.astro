---
import Aside from "../components/Aside.astro";
import Icon from "../components/Icon.astro";
import Popover from "../components/Popover.astro";
import type { ToCHeadingType } from "../types";
import TableOfContentsMenu from "./TableOfContentsMenu.astro";

type Props = {
  headings: ToCHeadingType[];
};

const { headings } = Astro.props;
---

<Aside
  bgColor="surface-container-low"
  class="sticky top-0 min-w-60 border border-(--theme-color-outline-variant) p-2 xl:static xl:top-auto xl:order-2 xl:p-4"
>
  <nav class="group/toc xl:hidden" aria-label="Table of contents">
    <button
      class:list={[
        "flex cursor-pointer list-none items-center gap-2 p-2",
        "[anchor-name:--ac-anchorname-toc-button]",
      ]}
      type="button"
      command="show-popover"
      commandfor="table-of-contents"
      aria-expanded="false"
      >On this page
      <Icon
        class:list={[
          "size-4 shrink-0",
          "group-has-[#table-of-contents:popover-open]/toc:rotate-180 motion-safe:transition-[rotate] motion-safe:duration-(--theme-duration-overlay)",
        ]}
        name="keyboard_arrow_down"
      />
    </button>

    <Popover
      class="m-0!"
      overlayClass="m-0 top-[anchor(bottom)] left-[anchor(left)] [position-anchor:--ac-anchorname-toc-button]"
      id="table-of-contents"
      showBlur={false}
    >
      <TableOfContentsMenu {headings} />
    </Popover>
  </nav>

  <nav
    class="sticky top-0 hidden space-y-4 xl:block"
    aria-label="Table of contents"
  >
    <div class="text-xs">On this page</div>

    <TableOfContentsMenu {headings} />
  </nav>
</Aside>

<script>
  const toc = document.getElementById("table-of-contents");
  const tocButton = document.querySelector('[commandfor="table-of-contents"]');

  toc?.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest('a[href^="#"]')) {
      toc.hidePopover();
    }
  });

  // Native invokers (command/commandfor) don't manage aria-expanded on the
  // trigger themselves - keep it in sync with the popover's actual state.
  toc?.addEventListener("toggle", (e) => {
    tocButton?.setAttribute("aria-expanded", String(e.newState === "open"));
  });
</script>
