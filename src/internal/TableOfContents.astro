---
import ButtonIcon from "../components/ButtonIcon.astro";
import SheetSide from "../components/SheetSide.astro";
import TableOfContentsMenu from "./TableOfContentsMenu.astro";
import type { ToCHeadingType } from "../types";

type Props = {
  headings: ToCHeadingType[];
  // The large-and-up sheet, docked to the window's end edge: render it in BaseLayout's `sheet`
  // slot, beside the page's column. Otherwise, the button and modal sheet used below large, in
  // the page's <main>.
  isDocked?: boolean;
};

const { headings, isDocked = false } = Astro.props;
---

{
  /* M3's supporting pane: from large up, a standard side sheet docked to the window's end edge;
     below large, a modal side sheet behind a button that stays at the top of the page. Each nav is
     relative, so the menu's current-section indicator scrolls with its links. */
}
{
  isDocked ? (
    // 256px, M3's sheet width, unless there's room beside the article at its full 75ch (plus its
    // 4rem padding and <main>'s 1rem): then it grows to fit its longest heading, up to M3's 400px.
    // 100cqw is the page column, BaseLayout's size container.
    <SheetSide
      class="hidden w-fit max-w-[clamp(var(--ac-sheet-side-width),100cqw-75ch-5rem,400px)] min-w-(--ac-sheet-side-width) large:block"
      headline="On this page"
    >
      <nav class="relative" aria-label="Table of contents">
        <TableOfContentsMenu {headings} />
      </nav>
    </SheetSide>
  ) : (
    <>
      <div class="sticky top-5 right-5 justify-self-end large:hidden">
        <ButtonIcon
          icon="more_vert"
          size="md"
          variant="outlined"
          command="show-modal"
          commandfor="table-of-contents"
          aria-haspopup="dialog"
          label="Show table of contents"
        />
      </div>

      <SheetSide
        class="large:hidden"
        id="table-of-contents"
        headline="On this page"
        isModal
      >
        <nav class="relative" aria-label="Table of contents">
          <TableOfContentsMenu {headings} />
        </nav>
      </SheetSide>
    </>
  )
}

<script>
  const toc = document.getElementById("table-of-contents");

  if (toc instanceof HTMLDialogElement) {
    // Following a link in the modal sheet closes it, so the section it goes to isn't left under it
    toc.addEventListener("click", (event) => {
      if (
        event.target instanceof Element &&
        event.target.closest('a[href^="#"]')
      ) {
        toc.close();
      }
    });

    // From large up the docked sheet takes over, so an open modal one closes rather than staying
    // hidden (large:hidden) with the page still inert. M3's large window size; keep in step with
    // --breakpoint-large in theme.css.
    window
      .matchMedia("(width >= 75rem)")
      .addEventListener("change", (event) => {
        if (event.matches) toc.close();
      });
  }
</script>
