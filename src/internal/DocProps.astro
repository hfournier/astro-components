---
import type { CollectionEntry } from "astro:content";
import Heading from "../components/Heading.astro";
import Link from "../components/Link.astro";
import { camelToKebabCase } from "../utils.js";
import type { PropWithHeadingType } from "../types";
import P from "./mdx/P.astro";
import MarkdownParagraphs from "./MarkdownParagraphs.astro";
import Section from "../components/Section.astro";

type Props = {
  extendsInfo: CollectionEntry<"components">["data"]["extends"];
  headingId?: string;
  props: PropWithHeadingType[];
};

const { extendsInfo, headingId, props } = Astro.props;
---

<Section class="space-y-8">
  <Heading id={headingId} level={2}>Properties</Heading>

  {
    extendsInfo?.kind === "element" ? (
      <P>
        The component accepts all the native HTML{" "}
        {extendsInfo.tag.map((tag, index) => (
          <>
            {index > 0 &&
              (index === extendsInfo.tag.length - 1 ? " or " : ", ")}
            <Link
              href={`https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/${tag.toLowerCase()}`}
            >{`<${tag}>`}</Link>
          </>
        ))}{" "}
        element's attributes
        {props.length > 0
          ? ", as well as the following custom properties:"
          : "."}
      </P>
    ) : extendsInfo?.kind === "component" ? (
      <P>
        The component accepts all the{" "}
        <Link href={`/components/${camelToKebabCase(extendsInfo.name)}`}>
          {extendsInfo.name}
        </Link>{" "}
        component's properties
        {props.length > 0
          ? ", as well as the following custom properties:"
          : "."}
      </P>
    ) : (
      <P>
        {props.length > 0
          ? "The following properties are defined for this component:"
          : "This component has no properties."}
      </P>
    )
  }

  {
    props.map((prop) => (
      <>
        <Heading id={prop.headingId} level={3}>
          {prop.name}
        </Heading>
        <dl class="grid max-w-fit grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 pl-8">
          <dt class="font-medium">Type</dt>
          <dd>{prop.type}</dd>

          <dt class="font-medium">Required</dt>
          <dd>{prop.required ? "Yes" : "No"}</dd>

          {prop.default && (
            <>
              <dt class="font-medium">Default</dt>
              <dd>{prop.default}</dd>
            </>
          )}
        </dl>
        <MarkdownParagraphs text={prop.description} />
      </>
    ))
  }
</Section>
