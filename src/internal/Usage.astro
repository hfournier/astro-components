---
import { render, type CollectionEntry } from "astro:content";
import { components as mdxComponents } from "../mdx";
import { Code } from "astro:components";
import Heading from "../components/Heading.astro";
import CodePreview from "./CodePreview.astro";
import MarkdownParagraphs from "./MarkdownParagraphs.astro";
import Section from "../components/Section.astro";

type Props = {
  headingId?: string;
  usage: CollectionEntry<"usage">;
};

const { headingId, usage } = Astro.props;

const { Content } = await render(usage);

const showCode = usage.data.show !== "preview-only" && !!usage.body;
const showPreview = usage.data.show !== "code-only";
const codeProps = {
  class: "bg-(--theme-color-surface-container-lowest)! p-4",
  code: usage.body ?? "",
  lang: "jsx",
  themes: { light: "github-light-default", dark: "github-dark-default" },
  defaultColor: "light-dark()",
} as const;
---

<Section class="space-y-8">
  <Heading id={headingId} level={2}>Usage</Heading>

  <MarkdownParagraphs text={usage.data.description} />

  {
    /* One CodePreview per combination: Astro counts a slot as filled even when the expression
       inside it renders nothing, so toggling the code or preview inside one CodePreview left an
       empty "Preview" box on code-only usages. */
  }
  {
    usage.data.show !== "none" &&
      (showCode && showPreview ? (
        <CodePreview>
          <Code {...codeProps} slot="code" />
          <Content components={{ ...mdxComponents }} slot="preview" />
        </CodePreview>
      ) : showCode ? (
        <CodePreview>
          <Code {...codeProps} slot="code" />
        </CodePreview>
      ) : (
        showPreview && (
          <CodePreview>
            <Content components={{ ...mdxComponents }} slot="preview" />
          </CodePreview>
        )
      ))
  }
</Section>
