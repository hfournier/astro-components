---
import { render, type CollectionEntry } from "astro:content";
import { components as mdxComponents } from "../mdx";
import { Code } from "astro:components";
import Heading from "../components/Heading.astro";
import CodePreview from "./CodePreview.astro";
import MarkdownParagraphs from "./MarkdownParagraphs.astro";
import Section from "../components/Section.astro";

type Props = {
  headingId?: string;
  usage: CollectionEntry<"usage">;
};

const { headingId, usage } = Astro.props;

const { Content } = await render(usage);
---

<Section class="space-y-8">
  <Heading id={headingId} level={2}>Usage</Heading>

  <MarkdownParagraphs text={usage.data.description} />

  {
    usage.data.show !== "none" && (
      <>
        <CodePreview>
          {usage.data.show !== "preview-only" && usage.body && (
            <Code
              class="p-4"
              code={usage.body}
              lang="jsx"
              themes={{
                light: "github-light-default",
                dark: "github-dark-default",
              }}
              defaultColor="light-dark()"
              slot="code"
            />
          )}
          {usage.data.show !== "code-only" && (
            <Content components={{ ...mdxComponents }} slot="preview" />
          )}
        </CodePreview>
      </>
    )
  }
</Section>
