---
import type { HTMLAttributes } from "astro/types";
import type { ToCHeadingType } from "../types";
import { twMerge } from "tailwind-merge";
import Link from "../components/Link.astro";
import Heading from "../components/Heading.astro";

type Props = HTMLAttributes<"ul"> & {
  headings: ToCHeadingType[];
};

const { headings, class: classList, ...attrs } = Astro.props;
---

{
  headings && headings.length > 0 && (
    <ul
      class:list={twMerge("space-y-1 [scroll-target-group:auto]", classList)}
      {...attrs}
    >
      <>
        {headings.map((heading) => (
          <li>
            {heading.level === 1 ? (
              <Heading class="text-xl" level={2}>
                <Link
                  class:list={[
                    "flex min-h-6 items-center text-inherit no-underline",
                    "[&:target-current]:text-(--theme-color-link-text) [&:target-current]:underline [&:target-current]:decoration-1 [&:target-current]:underline-offset-2",
                    "[&:target-current]:hover:decoration-2 [&:target-current]:hover:underline-offset-4",
                    "hover:text-(--theme-color-link-text) hover:underline hover:decoration-2 hover:underline-offset-4",
                  ]}
                  href={`#${heading.id}`}
                >
                  {heading.text}
                </Link>
              </Heading>
            ) : (
              <Link
                class:list={[
                  "flex min-h-6 items-center text-inherit no-underline",
                  "[&:target-current]:text-(--theme-color-link-text) [&:target-current]:underline [&:target-current]:decoration-1 [&:target-current]:underline-offset-2",
                  "[&:target-current]:hover:decoration-2 [&:target-current]:hover:underline-offset-4",
                  "hover:text-(--theme-color-link-text) hover:underline hover:decoration-2 hover:underline-offset-4",
                  heading.level === 2 && "pl-4",
                  heading.level === 3 && "pl-8",
                ]}
                href={`#${heading.id}`}
              >
                {heading.text}
              </Link>
            )}
          </li>
        ))}
      </>
    </ul>
  )
}
