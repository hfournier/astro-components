---
const hasCodeSlot = (await Astro.slots.render("code")).trim() !== "";
const hasPreviewSlot = (await Astro.slots.render("preview")).trim() !== "";
---

<section
  class:list={["border-divider grid border-(length:--border-width-boundary)"]}
>
  {
    hasCodeSlot && (
      <div class="overflow-x-auto" tabindex="0">
        <slot name="code" />
      </div>
    )
  }

  {
    hasPreviewSlot && (
      <div
        class:list={[
          "bg-container flex flex-col gap-1 p-4",
          hasCodeSlot &&
            "border-divider border-t-(length:--border-width-divider)",
        ]}
      >
        <div class="text-sm font-semibold">Preview</div>
        <div
          class="border-divider overflow-x-auto border-(length:--border-width-divider) bg-white p-4"
          tabindex="0"
        >
          <slot name="preview" />
        </div>
      </div>
    )
  }
</section>
