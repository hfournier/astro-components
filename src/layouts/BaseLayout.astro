---
import BaseHead from "../internal/BaseHead.astro";
import "../styles/global.css";

type Props = {
  classListBody?: string;
  classListHtml?: string;
  description: string;
  title: string;
};

const { classListBody, classListHtml, description, title } = Astro.props;
---

<html class:list={[classListHtml]} lang="en">
  <BaseHead {title} {description} />
  <body
    class:list={[
      "text-body mx-auto max-w-7xl space-y-8 p-4 md:p-6 lg:p-8",
      classListBody,
    ]}
  >
    <slot />
  </body>
</html>
