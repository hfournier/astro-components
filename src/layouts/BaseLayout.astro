---
import BaseHead from "../internal/BaseHead.astro";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<html lang="en">
  <BaseHead {title} {description} />
  <body class="text-body mx-auto max-w-7xl space-y-8 p-8">
    <slot />
  </body>
</html>
