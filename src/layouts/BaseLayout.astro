---
import "../styles/global.css";
import type { LayoutPropsType } from "../types";
import BaseHead from "../internal/BaseHead.astro";
import AsideComponents from "../internal/AsideComponents.astro";
import Footer from "../internal/Footer.astro";
import Header from "../internal/Header.astro";
import { twMerge } from "tailwind-merge";

type Props = LayoutPropsType;

const { classListBody, classListHtml, description, title } = Astro.props;
---

<html class:list={[classListHtml]} lang="en">
  <BaseHead {title} {description} />
  <body
    class:list={twMerge(
      "text-body mx-auto max-w-7xl p-4 md:p-6 lg:p-8",
      classListBody
    )}
  >
    <div
      class="grid grid-rows-[auto_1fr_auto] gap-4 md:grid-cols-[fit-content(260px)_minmax(0,1fr)] md:gap-6 lg:gap-8"
    >
      <Header />

      <AsideComponents />
      <slot />

      <Footer />
    </div>
  </body>
</html>
